<div 
    class="modal fade" 
    id="placementModal" 
    tabindex="-1"
    data-nodes="{{ nodes|json_encode|e('html_attr') }}"
    data-edges="{{ edges|json_encode|e('html_attr') }}"
    data-shelves="{{ shelves|json_encode|e('html_attr') }}"
>
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h6 class="modal-title">
                Tap the aisle this item belongs in. </br>
                Tap again to change aisle side:
                </h6>
                {# <button type="button" class="btn-close" data-bs-dismiss="modal"></button> #}
            </div>

            <div class="modal-body">
                <div id="map-container">
                    <svg id="placement-map" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}"></svg>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="placementCancelBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="placementForm" id="placementConfirmBtn" class="btn btn-primary" disabled>Save placement</button>
            </div>
            <form method="POST" action="/placement/save" id="placementForm">
                <input type="hidden" name="placement" id="placementPayload">
            </form>

        </div>
    </div>
</div>
<style>
/* ----------------------
   Modal layout & map
   ---------------------- */
#placementModal .modal-dialog {
    margin: 0;
    max-width: 100%; /* full width modal if needed */
}

#placementModal .modal-content {
    background: #0f1115;
    color: #e9ecef;
    border: 1px solid #1f2430;
    display: flex;
    flex-direction: column;
    height: 90vh; /* adjust as needed */
}

#placementModal .modal-header {
    border-bottom: 1px solid #1f2430;
    background: #121520;
}

#placementModal .modal-title {
    color: #f1f3f5;
    font-weight: 500;
}

#placementModal .btn-close {
    filter: invert(1) opacity(0.8);
}

#placementModal .btn-close:hover {
    opacity: 1;
}

#placementModal .modal-body {
    flex: 1;           /* fill vertical space above footer */
    padding: 0;        /* map edge-to-edge */
    display: flex;
    flex-direction: column;
    background: #0f1115;
    overflow: hidden;
}

#map-container {
    flex: 1;           /* fill all available modal-body space */
    background: #0f1115;
    overflow: hidden;  /* map will scale within container */
}

/* Make SVG fill the container */
#placement-map {
    width: 100%;
    height: 100%;
    touch-action: manipulation;
    background: #0f1115;
    display: block;
}

/* ---------------------
   Modal footer & buttons
   ---------------------- */
#placementModal .modal-footer {
    border-top: 1px solid #1f2430;
    background: #121520;
    flex-shrink: 0;    /* never shrink */
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}

/* Cancel button */
#placementModal .btn-secondary {
    background: #2b303b;
    border-color: #2b303b;
    color: #dee2e6;
}

#placementModal .btn-secondary:hover {
    background: #343a46;
}

/* Save button */
#placementModal .btn-primary {
    background: #4dabf7;
    border-color: #4dabf7;
    color: #0b0d12;
}

#placementModal .btn-primary:disabled {
    background: #2a2f3a;
    border-color: #2a2f3a;
    color: #6c757d;
}

/* ----------------------
   Modal backdrop
   ---------------------- */
.modal-backdrop.show {
    background-color: #05070c;
    opacity: 0.85;
    backdrop-filter: blur(2px);
}

/* ----------------------
   Map elements
   ---------------------- */
.edge {
    stroke: #0f1115;
    stroke-width: 10;
    stroke-linecap: round;
}

.edge-hit {
    stroke: transparent;
    stroke-width: 50;
    cursor: pointer;
    pointer-events: stroke;
}

.edge:hover {
    stroke: #3d4658;
}

.edge.selected {
    stroke: #4dabf7;
    stroke-width: 20;
    animation: pulse 1s infinite;
    filter: drop-shadow(0 0 6px rgba(77,171,247,0.8));
}

.edge.dimmed {
    opacity: 0.3;
}

.shelf {
    fill: #1c212b;
    stroke: #3a4152;
    stroke-width: 2;
    cursor: pointer;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.6));
}

.edge-side {
    fill: rgba(77, 171, 247, 0.44);
    opacity: 0;
    transition: opacity 0.15s ease;
}

/* ----------------------
   Animations
   ---------------------- */
@keyframes pulse {
    0%   { stroke-width: 8;  opacity: 0.7; }
    50%  { stroke-width: 12; opacity: 1; }
    100% { stroke-width: 8;  opacity: 0.7; }
}

</style>

<script>
const svg = document.getElementById('placement-map');
const edgeEls = new Map(); // Keep references to all edges
const mapWrapper = document.getElementById('placementModal');
const nodesData = JSON.parse(mapWrapper.dataset.nodes);
const edgesData = JSON.parse(mapWrapper.dataset.edges);
const shelvesData = JSON.parse(mapWrapper.dataset.shelves);
const SVG_NS = "http://www.w3.org/2000/svg";
const confirmBtn = document.getElementById('placementConfirmBtn');


const nodes = {};
nodesData.forEach(n => {
    nodes[n.id] = n;
});

// Safetynet:
document.getElementById('placementForm').addEventListener('submit', () => {
    updatePlacementPayload();
});

edgesData.forEach(e => {
    const from = nodes[e.from];
    const to   = nodes[e.to];

    // visible edge
    const line = document.createElementNS(SVG_NS, 'line');
    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('edge');
    line.dataset.edgeId = e.id;

    // hit target (fat invisible line)
    const hit = document.createElementNS(SVG_NS, 'line');
    hit.setAttribute('x1', from.x);
    hit.setAttribute('y1', from.y);
    hit.setAttribute('x2', to.x);
    hit.setAttribute('y2', to.y);
    hit.classList.add('edge-hit');
    hit.dataset.edgeId = e.id;
    hit.addEventListener('click', () => selectEdge(e.id));
    

    // side indicator (initially invisible)
    const sideRect = document.createElementNS(SVG_NS, 'rect');
    sideRect.classList.add('edge-side');
    sideRect.dataset.edgeId = e.id;
    sideRect.style.opacity = 0;

    edgeEls.set(e.id, { line, hit, sideRect, from, to });

    svg.appendChild(line);
    svg.appendChild(sideRect);
    svg.appendChild(hit);
});

renderShelves();

function renderShelves() {
    shelvesData.forEach(shelf => {
        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', shelf.x);
        rect.setAttribute('y', shelf.y);
        rect.setAttribute('width', shelf.width);
        rect.setAttribute('height', shelf.height);
        rect.classList.add('shelf');
        svg.appendChild(rect);
    });
}

const cancelBtn = document.getElementById('placementCancelBtn');
cancelBtn.addEventListener('click', () => {
    clearSelection();

    placementState.edgeId = null;
    placementState.aisleSide = null;
    placementState.foodItemId = null;
    placementState.supermarketId = null;

    updatePlacementPayload();
    confirmBtn.disabled = true;
});

// Vector math to offset left/right
function updateAisleSide(edgeId, side) {
    const edge = edgeEls.get(edgeId);
    if (!edge) return;

    const { from, to, sideRect } = edge;

    const dx = to.x - from.x;
    const dy = to.y - from.y;
    const len = Math.hypot(dx, dy);
    if (len === 0) return;

    // rectangle thickness (distance from aisle center to side)
    // SAME constants as shelf generation
    const aisleWidth = 80;
    const shelfDepth = 30;
    const offset = (aisleWidth / 2 + shelfDepth / 2) * side;

    // compute perpendicular vector
    const px = -dy / len;
    const py = dx / len;

    // rectangle center = middle of aisle, offset toward side
    const cx = (from.x + to.x)/2 + px * offset/2;
    const cy = (from.y + to.y)/2 + py * offset/2;

    // rectangle rotation angle
    const angle = Math.atan2(dy, dx) * 180 / Math.PI;

    sideRect.setAttribute('width', len);          // along aisle
    sideRect.setAttribute('height', Math.abs(offset)); // perpendicular
    sideRect.setAttribute('x', cx - len/2);       // center it
    sideRect.setAttribute('y', cy - Math.abs(offset)/2);
    sideRect.setAttribute('transform', `rotate(${angle}, ${cx}, ${cy})`);

    sideRect.style.opacity = 1;
}

function getDirectionFactor(edge) {
    // If edge.from < edge.to, geometry matches logical direction
    return edge.from.id < edge.to.id ? 1 : -1;
}


function selectEdge(edgeId) {
    edgeId = Number(edgeId);
    if (!edgeId) return; // nothing to select

    // Toggle aisle side if the same edge is clicked
    if (placementState.edgeId === edgeId) {
        placementState.aisleSide *= -1; // flip side
    } else {
        clearSelection();
        placementState.edgeId = edgeId;
        placementState.aisleSide = -1; // default to logical "left"
    }

   // Highlight the edge on the map
    const edge = edgeEls.get(edgeId);
    edge.line.classList.add('selected');

    const directionFactor = edge.from.id < edge.to.id ? 1 : -1;
    const geometrySide = placementState.aisleSide * directionFactor;

    updateAisleSide(edgeId, geometrySide);
    updatePlacementPayload();

    confirmBtn.disabled = false;
}

function updatePlacementPayload() {
    console.log(placementState);
    document.getElementById('placementPayload').value = JSON.stringify(placementState);
}

function clearSelection() {
    edgeEls.forEach(({ line, sideRect }) => {
        line.classList.remove('selected');
        if (sideRect) sideRect.style.opacity = 0;
    });

    placementState.edgeId = null;
    placementState.aisleSide = null;
}
</script>