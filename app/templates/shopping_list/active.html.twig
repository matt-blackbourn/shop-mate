}

function animateViewBox(svg, start, end, duration = 500) {
    const startTime = performance.now();

    function step(now) {
        const t = Math.min(1, (now - startTime) / duration);

        // linear interpolation of each component
        const x = start.x + (end.x - start.x) * t;
        const y = start.y + (end.y - start.y) * t;
        const width = start.width + (end.width - start.width) * t;
        const height = start.height + (end.height - start.height) * t;

        svg.setAttribute("viewBox", `${x} ${y} ${width} ${height}`);

        if (t < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
}


// Path map shelf highlighting
// ----------------------------------------------------------
function resolveEdgesForSegment(segment) {
    const edges = [];

    for (let i = 0; i < segment.pathNodes.length - 1; i++) {
        const from = segment.pathNodes[i];
        const to = segment.pathNodes[i + 1];

        // set currentNodeId, in case it is not the entrance node
        if (i === 0) {
            placementState.currentNodeId = from;
        }

        const edge = edgeByNodes.get(`${from}->${to}`);
        if (!edge) {
            console.warn('Missing edge', from, to);
            continue;
        }

        edges.push(edge);
    }

    return edges;
}

function highlightItemOnMap() {
    // First pass: complete & upcoming
    routeState.segments.forEach((segment, index) => {
        if (index === routeState.currentSegment) return; // skip active for now

        const isPicked = routeState.pickedItemIds.has(segment.itemId);
        const state = isPicked ? 'route-complete' : 'route-upcoming';

        segment.edges.forEach(edge => {
            edge.el.classList.remove('route-complete', 'route-active', 'route-upcoming');
            edge.el.classList.add(state);
        });
    });

    clearShelfHighlights();

    const activeSegment = routeState.segments[routeState.currentSegment];
    if(!activeSegment) return; // no placed items

    // HIGHLIGHT EDGES
    // Same-edge placment items will have no edges in their segment.edges array, so we need to find it in in edgesData
    let edge = null
    if (activeSegment.edges.length > 0) {
        edge = activeSegment.edges[activeSegment.edges.length - 1];
        activeSegment.edges.forEach(edge => {
            edge.el.classList.remove('route-complete', 'route-upcoming');
            edge.el.classList.add('route-active');
        });
    } else if (activeSegment.placementEdgeId) {
        edge = edgesData.find(e => e.id === activeSegment.placementEdgeId);
        edge.el.classList.remove('route-complete', 'route-upcoming');
        edge.el.classList.add('route-active');
    }

    if (!edge) return;

    // HIGHLIGHT SHELVES 
    const shelves = shelvesNextToEdge(edge.id, shelfEls)
    const correctShelf = shelves.find(shelf => shelfIsOnAisleSide(shelf, edge, Number(routeState.currentItem.aisleSide)));

    // Sometimes a change in aisleWidth can cause no shelf to be found
    if(correctShelf){
        highlightShelfPortion(correctShelf, edge);
    }
}

function highlightShelfPortion(shelf, edge) {
    const MIN_RATIO = 0.25; // ignore highlights smaller than 25% (for small shelves)
    const MAX_RATIO = 0.75; // expand highlights bigger than 75%

    const edgeIsHorizontal = edge.y1 === edge.y2;
    const edgeIsVertical   = edge.x1 === edge.x2;

    const shelfMinX = shelf.x;
    const shelfMaxX = shelf.x + shelf.width;
    const shelfMinY = shelf.y;
    const shelfMaxY = shelf.y + shelf.height;

    const halfHeight = shelf.height / 2;
    const halfWidth  = shelf.width / 2;

    // whether to enforce the MIN_RATIO skip
    const enforceMinRatioRuleX = shelf.width < 3 * AISLE_WIDTH;
    const enforceMinRatioRuleY = shelf.height < 3 * AISLE_WIDTH;

    // 🔹 Horizontal edge
    if (edgeIsHorizontal) {
        let x1 = Math.max(shelfMinX, Math.min(edge.x1, edge.x2));
        let x2 = Math.min(shelfMaxX, Math.max(edge.x1, edge.x2));
        if (x2 <= x1) return;

        const portion = x2 - x1;
        const ratio   = portion / shelf.width;

        const touchesStart = x1 === shelfMinX;
        const touchesEnd   = x2 === shelfMaxX;

        // Only enforce skip if the shelf is shorter than 3×AISLE_WIDTH
        if (enforceMinRatioRuleX && ratio < MIN_RATIO && !touchesStart && !touchesEnd) return;

        if (ratio > MAX_RATIO || (enforceMinRatioRuleX && ratio < MIN_RATIO && (touchesStart || touchesEnd))) {
            x1 = shelfMinX;
            x2 = shelfMaxX;
        }

        const edgeIsAbove = edge.y1 < shelfMinY;

        drawShelfHighlight(
            shelf,
            x1,
            shelf.fullSelect ? shelfMinY : (edgeIsAbove ? shelfMinY : shelfMinY + halfHeight),
            x2 - x1,
            shelf.fullSelect ? shelf.height : halfHeight
        );
    }

    // 🔹 Vertical edge
    if (edgeIsVertical) {
        let y1 = Math.max(shelfMinY, Math.min(edge.y1, edge.y2));
        let y2 = Math.min(shelfMaxY, Math.max(edge.y1, edge.y2));
        if (y2 <= y1) return;

        const portion = y2 - y1;
        const ratio   = portion / shelf.height;

        const touchesStart = y1 === shelfMinY;
        const touchesEnd   = y2 === shelfMaxY;

        // Only enforce skip if the shelf is shorter than 3×AISLE_WIDTH
        if (enforceMinRatioRuleY && ratio < MIN_RATIO && !touchesStart && !touchesEnd) return;

        if (ratio > MAX_RATIO || (enforceMinRatioRuleY && ratio < MIN_RATIO && (touchesStart || touchesEnd))) {
            y1 = shelfMinY;
            y2 = shelfMaxY;
        }

        const edgeIsLeft = edge.x1 < shelfMinX;

        drawShelfHighlight(
            shelf,
            shelf.fullSelect ? shelfMinX : (edgeIsLeft ? shelfMinX : shelfMinX + halfWidth),
            y1,
            shelf.fullSelect ? shelf.width : halfWidth,
            y2 - y1
        );
    }
}

function drawShelfHighlight(shelf, x, y, width, height) {
    const highlight = document.createElementNS(SVG_NS, 'rect');
    highlight.classList.add('shelf-highlight');
    highlight.setAttribute('x', x);
    highlight.setAttribute('y', y);
    highlight.setAttribute('width', width);
    highlight.setAttribute('height', height);

    shelf.el.parentNode.appendChild(highlight);
}


function shelvesNextToEdge(edgeId, shelfData) {
    const edge = edgesData.find(e => e.id === edgeId);
    if (!edge) return [];

    const horizontal = edge.y1 === edge.y2;
    const vertical   = edge.x1 === edge.x2;

    const edgeMinX = Math.min(edge.x1, edge.x2);
    const edgeMaxX = Math.max(edge.x1, edge.x2);
    const edgeMinY = Math.min(edge.y1, edge.y2);
    const edgeMaxY = Math.max(edge.y1, edge.y2);


    return shelfData.filter(shelf => {
        const shelfMinX = shelf.x;
        const shelfMaxX = shelf.x + shelf.width;
        const shelfMinY = shelf.y;
        const shelfMaxY = shelf.y + shelf.height;

        if (horizontal) {
            const dy =
                edge.y1 < shelfMinY
                    ? shelfMinY - edge.y1
                    : edge.y1 > shelfMaxY
                        ? edge.y1 - shelfMaxY
                        : 0;

            const closeInY = dy < AISLE_WIDTH; // we could use 1px over half of this and it would work, could tighten it up later
            const overlapsX = rangesOverlap(
                shelfMinX, shelfMaxX,
                edgeMinX, edgeMaxX
            );

            return closeInY && overlapsX;
        }

        if (vertical) {
            const dx =
                edge.x1 < shelfMinX
                    ? shelfMinX - edge.x1
                    : edge.x1 > shelfMaxX
                        ? edge.x1 - shelfMaxX
                        : 0; // edge is inside shelf X span (touching)

            const closeInX = dx < AISLE_WIDTH; // we could use 1px over half of this and it would work, could tighten it up later
            const overlapsY = rangesOverlap(
                shelfMinY, shelfMaxY,
                edgeMinY, edgeMaxY
            );

            return closeInX && overlapsY;
        }

        return false;
    });
}

function rangesOverlap(aMin, aMax, bMin, bMax) {
    return Math.min(aMax, bMax) > Math.max(aMin, bMin);
}

function shelfIsOnAisleSide(shelf, edge, aisleSide) {
    const vertical = edge.x1 === edge.x2;
    const horizontal = edge.y1 === edge.y2;

    // shelf center
    const cx = shelf.x + shelf.width / 2;
    const cy = shelf.y + shelf.height / 2;

    if (vertical) {
        // signed distance from shelf center to edge line
        const side = cx - edge.x1;
        return Math.sign(side) === aisleSide;
    }

    if (horizontal) {
        const side = cy - edge.y1;
        return Math.sign(side) === aisleSide;
    }

    return false;
}

