<div class="modal fade map-modal" id="pathModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header d-flex justify-content-between">
            <div class="title">
                    <span id="modalItemName" class="title"></span>
                    <span id="modalItemQty"></span>
                    <div id="modalItemNotes"></div>
                </div>

                <button type="button" id="place-item-map" class="btn-dark-base border-green"><i class="bi-geo-alt-fill"></i></button>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="path-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="path-edges-layer"></g>
                        <g id="path-entrance-layer"></g>
                    </svg>
                </div>
            </div>

            <div class="modal-footer">
                <div>
                    <button type="button" id="pathCancelBtn" class="map-nav-button" data-bs-dismiss="modal"><i class="bi-arrow-left"></i> List</button>
                </div>
                <button id="skip-item-map" class="btn-dark-base border-yellow" type="button">Skip</button>
                <button id="pick-item-map" class="btn-dark-base border-green" type="button">Pick Item</button>
            </div>
        </div>
    </div>
</div>


