}

/* Header TomSelect variant */
.page-header .ts-wrapper.single .ts-control {
    background-color: #1c212b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

.page-header .ts-wrapper.single .ts-control input {
    background-color: transparent;
    color: #e9ecef;
}

.page-header .ts-dropdown {
    background-color: #2b303b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

.page-header .ts-dropdown .ts-dropdown-option {
    color: #e9ecef;
}

.page-header .ts-dropdown .active,
.page-header .ts-dropdown .active.create {
    background-color: #343a46;
    color: #e9ecef;
