<div class="modal fade editPageModal" id="selectSupermarketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Select A Supermarket</h5>
                <button type="button" class="btn" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg text-white"></i>
                </button>
            </div>

            <div class="modal-body">
                <select id="supermarketSelect" class="w-100">
                    {% for supermarket in supermarkets %}
                        {% if supermarket.id %}
                            <option value="{{ supermarket.id }}">{{ supermarket.type.value }} - {{ supermarket.suburb }}</option>
                        {% else %}
                            <option value="{{ supermarket.id }}">No Supermarket</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>

            <div class="modal-footer">
                <button id="goShoppingButton" class="btn btn-primary">Go Shopping!</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>

        </div>
    </div>
</div>
