}

.map-modal .modal-footer {
    border-top: 1px solid #1f2430;
    background: #121520;
    flex-shrink: 0;    /* never shrink */
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
}

/* Cancel button */
.map-modal .btn-secondary {
    background: #2b303b;
    border-color: #2b303b;
    color: #dee2e6;
}

.map-modal .btn-secondary:hover {
    background: #343a46;
}

/* Save button */
.map-modal .btn-primary {
    background: #4dabf7;
    border-color: #4dabf7;
    color: #0b0d12;
}

.map-modal .btn-primary:disabled {
    background: #2a2f3a;
    border-color: #2a2f3a;
    color: #6c757d;
}

.shelf-highlight {
    fill: rgba(81, 207, 102, 0.25);
    stroke: #51cf66;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    pointer-events: none; 
}

.node.entrance {
    paint-order: stroke fill; /* ensures arrow is above circle */
}

.node.entrance circle:first-child {
    fill: #f59e0b;
}

.node.entrance circle:nth-child(2) {
    fill: #f59e0b;
}

.node.entrance path {
    fill: #f59e0b; /* same as node */
}
.node.entrance .arrow-line {
    stroke: #f59e0b;        /* amber-500 */
    opacity: 1;
    stroke-width: 7;
    drop-shadow(0 0 8px rgba(245, 158, 11, 0.65))
    stroke-dasharray: 40 20; 
}

/* Base route styling */
.path-edge.route-upcoming,
.path-edge.route-active,
.path-edge.route-complete {
    stroke-width: 6;              /* thicker line */
    stroke-dasharray: 40 20;      /* long dash, clear gap */
    transition: stroke 200ms ease, opacity 200ms ease;
}

.path-edge.route-complete {
    stroke: #64748b;        /* slate-500 */
    opacity: 0.7;
    stroke-width: 4;
}

/* Active (warm, obvious) */
.path-edge.route-active {
    stroke: #f59e0b;        /* amber-500 */
    opacity: 1;
    stroke-width: 7;
    drop-shadow(0 0 8px rgba(245, 158, 11, 0.65))
    stroke-dasharray: 60 0; /* solid */
    animation: pulse 1s infinite;
}

/* Upcoming (same hue, hint only) */
.path-edge.route-upcoming {
    stroke: #f59e0b;
    opacity: 0.4;
    stroke-width: 4;
}

.location-side {
    fill: #f59e0b80
}

/* ----------------------
   Animations
   ---------------------- */
@keyframes pulse {
    0%   { stroke-width: 8;  opacity: 0.7; }
    50%  { stroke-width: 12; opacity: 1; }
    100% { stroke-width: 8;  opacity: 0.7; }
}
</style>

<script>

// map drawing state
const container = document.getElementById('shoppingListContainer');
const nodesData = JSON.parse(container.dataset.nodes);
const edgesData = JSON.parse(container.dataset.edges);
const shelvesData = JSON.parse(container.dataset.shelves);
const segments = JSON.parse(container.dataset.segments);
const entranceNodeId = container.dataset.entranceNodeId;  
const placementEdgeEls = new Map(); // Keep references to all edges
const otherPlacementEdgeEls = new Map(); // Keep references to all edges
const pathEdgeEls = new Map(); // Keep references to all edges
const SVG_NS = "http://www.w3.org/2000/svg";
const shelfEls = []; // keep refs + geometry
const AISLE_WIDTH = 80; // this is the same as the shelve generation width. 
const shelfElsOther = []; // keep refs + geometry

const currentItemState = {
    itemId: null,
    name: null,
    quantity: null,
    notes: null,
};


// other state
let processingQueue = false;
const pickQueue = [];
const placementState = {
    supermarketId: null,
    foodItemId: null,
    edgeId: null,
    aisleSide: null,
    currentNodeId: null,
};

// build a lookup for nodes and draw entrance node
const nodes = {};
nodesData.forEach(n => {
    if (n.id == entranceNodeId) {
        drawEntranceArrow(n);
    }
    nodes[n.id] = n;
});


// Draw edges (path display)
edgesData.forEach(e => {
    const from = nodes[e.from];
    const to   = nodes[e.to];
    const layer = getLayer('path-map', 'path-edges-layer');

    // invisible edges - only visible with styles added
    const line = document.createElementNS(SVG_NS, 'line');
    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('path-edge');
    line.dataset.edgeId = e.id;

    layer.appendChild(line);
});

const edgeByNodes = new Map();
edgesData.forEach(edge => {
    const el = document.querySelector(
        `[data-edge-id="${edge.id}"]`
    );

    if (!el) {
        return;
    }

    edgeByNodes.set(`${edge.from}->${edge.to}`, {
        ...edge,
        el
    });

    edgeByNodes.set(`${edge.to}->${edge.from}`, {
        ...edge,
        el
    });
});

// 2. Build routeState
const routeState = {
    segments: segments.map(s => ({
        ...s,
        edges: []
    })),
    currentSegment: 0,
    pickedItemIds: new Set(),
    currentItem: {
        itemId: null,
        name: null,
        quantity: null,
        notes: null,
    },
};


// 3. Resolve segment edges
routeState.segments.forEach(segment => {
    segment.edges = resolveEdgesForSegment(segment);
});

// draw shelves on maps
drawShelves(shelvesData, document.getElementById('placement-map'))
drawShelves(shelvesData, document.getElementById('path-map'))

updateMapView();

// 4. 🔥 Render initial route
highlightEdgesOnPathMap();

function updateMapView() {
    const segment = routeState.segments[routeState.currentSegment];
    if(!segment) {
        routeState.currentItem = {
            listItemId: null,
            name: null,
            quantity: null,
            notes: null,
            aisleSide: null,
        };
    } else {
        const card = document.querySelector(`.shopping-card[data-id="${segment.itemId}"]`);
        routeState.currentItem = {
            itemId: card.dataset.id,
            name: card.dataset.foodItemName,
            quantity: card.dataset.itemQuantity,
            notes: card.dataset.itemNotes,
            aisleSide: card.dataset.placementAisleSide,
        };
    }

    document.getElementById('modalItemName').textContent = routeState.currentItem.name;

    const qtyEl = document.getElementById('modalItemQty');
    qtyEl.textContent = routeState.currentItem.quantity && routeState.currentItem.quantity > 1 ? ` (${routeState.currentItem.quantity})` : '';

    const notesEl = document.getElementById('modalItemNotes');
    notesEl.textContent = routeState.currentItem.notes ?? '';
    notesEl.style.display = routeState.currentItem.notes ? '' : 'none';
}


// Path map shelf highlighting
// ----------------------------------------------------------
function resolveEdgesForSegment(segment) {
    const edges = [];

    for (let i = 0; i < segment.pathNodes.length - 1; i++) {
        const from = segment.pathNodes[i];
        const to = segment.pathNodes[i + 1];

        // set currentNodeId, in case it is not the entrance node
        if (i === 0) {
            placementState.currentNodeId = from;
        }

        const edge = edgeByNodes.get(`${from}->${to}`);
        if (!edge) {
            console.warn('Missing edge', from, to);
            continue;
        }

        edges.push(edge);
    }

    return edges;
}

function highlightEdgesOnPathMap() {
    // First pass: complete & upcoming
    routeState.segments.forEach((segment, index) => {
        if (index === routeState.currentSegment) return; // skip active for now

        const isPicked = routeState.pickedItemIds.has(segment.itemId);
        const state = isPicked ? 'route-complete' : 'route-upcoming';

        segment.edges.forEach(edge => {
            edge.el.classList.remove('route-complete', 'route-active', 'route-upcoming');
            edge.el.classList.add(state);
        });
    });

    // Active segment (if not already picked)
    const activeSegment = routeState.segments[routeState.currentSegment];
    if (activeSegment && !routeState.pickedItemIds.has(activeSegment.itemId)) {
        activeSegment.edges.forEach(edge => {
            edge.el.classList.remove('route-complete', 'route-upcoming');
            edge.el.classList.add('route-active');
        });
    }

    clearShelfHighlights('path-map');

    if(!activeSegment || activeSegment.edges.length === 0) return; // no placed items

    const edge = activeSegment.edges[activeSegment.edges.length - 1]
    const shelves = shelvesNextToEdge(edge.id, shelfEls)
    const correctShelf = shelves.find(shelf => shelfIsOnAisleSide(shelf, edge, Number(routeState.currentItem.aisleSide)));

    highlightShelfPortion(correctShelf, edge);
}


function highlightShelfPortion(shelf, edge) {
    const edgeIsHorizontal = edge.y1 === edge.y2;
    const edgeIsVertical   = edge.x1 === edge.x2;

    const shelfMinX = shelf.x;
    const shelfMaxX = shelf.x + shelf.width;
    const shelfMinY = shelf.y;
    const shelfMaxY = shelf.y + shelf.height;

    const halfHeight = shelf.height / 2;
    const halfWidth  = shelf.width / 2;

    const wallShelf = isWallShelf(shelf, edge);

    // 🔹 Edge runs left-right (above or below shelf)
    if (edgeIsHorizontal) {
        const x1 = Math.max(shelfMinX, Math.min(edge.x1, edge.x2));
        const x2 = Math.min(shelfMaxX, Math.max(edge.x1, edge.x2));
        if (x2 <= x1) return;

        // Is edge above or below the shelf?
        const edgeIsAbove = edge.y1 < shelfMinY;

        drawShelfHighlight(
            shelf,
            x1,
            wallShelf ? shelfMinY : (edgeIsAbove ? shelfMinY : shelfMinY + halfHeight),
            x2 - x1,
            wallShelf ? shelf.height : halfHeight
        );
    }

    // 🔹 Edge runs up-down (left or right of shelf)
    if (edgeIsVertical) {
        const y1 = Math.max(shelfMinY, Math.min(edge.y1, edge.y2));
        const y2 = Math.min(shelfMaxY, Math.max(edge.y1, edge.y2));
        if (y2 <= y1) return;

        // Is edge left or right of shelf?
        const edgeIsLeft = edge.x1 < shelfMinX;

        drawShelfHighlight(
            shelf,
            wallShelf ? shelfMinX : (edgeIsLeft ? shelfMinX : shelfMinX + halfWidth),
            y1,
            wallShelf ? shelf.width : halfWidth,
            y2 - y1
        );
    }
}

function drawShelfHighlight(shelf, x, y, width, height) {
    const highlight = document.createElementNS(SVG_NS, 'rect');
    highlight.classList.add('shelf-highlight');
    highlight.setAttribute('x', x);
    highlight.setAttribute('y', y);
    highlight.setAttribute('width', width);
    highlight.setAttribute('height', height);

    shelf.el.parentNode.appendChild(highlight);
}


function shelvesNextToEdge(edgeId, shelfData) {
    const edge = edgesData.find(e => e.id === edgeId);
    if (!edge) return [];

    const horizontal = edge.y1 === edge.y2;
    const vertical   = edge.x1 === edge.x2;

    const edgeMinX = Math.min(edge.x1, edge.x2);
    const edgeMaxX = Math.max(edge.x1, edge.x2);
    const edgeMinY = Math.min(edge.y1, edge.y2);
    const edgeMaxY = Math.max(edge.y1, edge.y2);


    return shelfData.filter(shelf => {
        const shelfMinX = shelf.x;
        const shelfMaxX = shelf.x + shelf.width;
        const shelfMinY = shelf.y;
        const shelfMaxY = shelf.y + shelf.height;

        if (horizontal) {
            const dy =
                edge.y1 < shelfMinY
                    ? shelfMinY - edge.y1
                    : edge.y1 > shelfMaxY
                        ? edge.y1 - shelfMaxY
                        : 0;

            const closeInY = dy < AISLE_WIDTH; // we could use 1px over half of this and it would work, could tighten it up later
            const overlapsX = rangesOverlap(
                shelfMinX, shelfMaxX,
                edgeMinX, edgeMaxX
            );

            return closeInY && overlapsX;
        }

        if (vertical) {
            const dx =
                edge.x1 < shelfMinX
                    ? shelfMinX - edge.x1
                    : edge.x1 > shelfMaxX
                        ? edge.x1 - shelfMaxX
                        : 0; // edge is inside shelf X span (touching)

            const closeInX = dx < AISLE_WIDTH; // we could use 1px over half of this and it would work, could tighten it up later
            const overlapsY = rangesOverlap(
                shelfMinY, shelfMaxY,
                edgeMinY, edgeMaxY
            );

            return closeInX && overlapsY;
        }

        return false;
    });
}

function rangesOverlap(aMin, aMax, bMin, bMax) {
    return Math.min(aMax, bMax) > Math.max(aMin, bMin);
}

function shelfIsOnAisleSide(shelf, edge, aisleSide) {
    const vertical = edge.x1 === edge.x2;
    const horizontal = edge.y1 === edge.y2;

    // shelf center
    const cx = shelf.x + shelf.width / 2;
    const cy = shelf.y + shelf.height / 2;

    if (vertical) {
        // signed distance from shelf center to edge line
        const side = cx - edge.x1;
        return Math.sign(side) === aisleSide;
    }

    if (horizontal) {
        const side = cy - edge.y1;
        return Math.sign(side) === aisleSide;
    }

    return false;
}

