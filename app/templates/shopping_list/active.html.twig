    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('edge');
    line.dataset.edgeId = e.id;

    otherPlacementEdgeEls.set(e.id, { line, from, to });

    layer.appendChild(line);
});

function onShelfClicked(shelf, click) {
    if(mapMode !== MAP_MODE_PLACEMENT) return;

    const edges = edgesNextToShelf(shelf, click);
    if (!edges.length) return;

    let index = 0;
    // if user clicked same shelf again, cycle to next edge
    //  % edges.length loops back to the first edge after reaching the end of the list
    if (lastShelfSelection.shelfId === shelf.id) {
        index = (lastShelfSelection.edgeIndex + 1) % edges.length;
    }

    const edge = edges[index];
    const aisleSide = aisleSideForShelf(shelf, edge);

    // update last selection for toggling
    lastShelfSelection = {
        shelfId: shelf.id,
        edgeIndex: index
    };

    placementState.aisleSide = aisleSide;
    placementState.edgeId = edge.id;

    confirmBtn.disabled = false;
    clearShelfHighlights();
    highlightShelfPortion(shelf, edge);
    updatePlacementPayload()
}


function preselectShelf(edgeId, aisleSide) {
    const shelves = shelvesNextToEdge(edgeId, shelfEls)
    const edge = edgesData.find(e => e.id === edgeId);
    const correctShelf = shelves.find(shelf => shelfIsOnAisleSide(shelf, edge, aisleSide));

    placementState.aisleSide = aisleSide;
    placementState.edgeId = edgeId;
    updatePlacementPayload();

    confirmBtn.disabled = false;

    highlightShelfPortion(correctShelf, edge);
}

function clearShelfHighlights() {
    document.querySelectorAll(`#map-svg .shelf-highlight`).forEach(el => el.remove());
}

function aisleSideForShelf(shelf, edge) {
    const cx = shelf.x + shelf.width / 2;
    const cy = shelf.y + shelf.height / 2;

    if (edge.x1 === edge.x2) {
        // vertical edge
        return Math.sign(cx - edge.x1) || 1;
    }

    if (edge.y1 === edge.y2) {
        // horizontal edge
        return Math.sign(cy - edge.y1) || 1;
    }

    return 1;
}

function edgesNextToShelf(shelf, click) {
    return edgesData.filter(edge =>
        shelfIsNextToEdge(shelf, edge, click)
    );
}

function shelfIsNextToEdge(shelf, edge, click) {
    const edgeIsHorizontal = edge.y1 === edge.y2;
    const edgeIsVertical   = edge.x1 === edge.x2;

    const shelfIsHorizontal = shelf.width >= shelf.height;
    const shelfIsVertical   = !shelfIsHorizontal;

    // 🚫 Reject edges that don't run parallel to the shelf
    if (shelfIsHorizontal && !edgeIsHorizontal) {
        return false;
    }

    if (shelfIsVertical && !edgeIsVertical) {
        return false;
    }

    const shelfMinX = shelf.x;
    const shelfMaxX = shelf.x + shelf.width;
    const shelfMinY = shelf.y;
    const shelfMaxY = shelf.y + shelf.height;

    const edgeMinX = Math.min(edge.x1, edge.x2);
    const edgeMaxX = Math.max(edge.x1, edge.x2);
    const edgeMinY = Math.min(edge.y1, edge.y2);
    const edgeMaxY = Math.max(edge.y1, edge.y2);

    if (edgeIsVertical) {
        const dx =
            edge.x1 < shelfMinX
                ? shelfMinX - edge.x1
                : edge.x1 > shelfMaxX
                    ? edge.x1 - shelfMaxX
                    : 0;

        const closeInX = dx < AISLE_WIDTH;
        const overlapsY = rangesOverlap(
            shelfMinY, shelfMaxY,
            edgeMinY, edgeMaxY
        );

          // ✅ NEW: click must project onto this edge
        const clickProjects =
            click.y >= edgeMinY &&
            click.y <= edgeMaxY;

        return closeInX && overlapsY && clickProjects;
    }

    if (edgeIsHorizontal) {
        const dy =
            edge.y1 < shelfMinY
                ? shelfMinY - edge.y1
                : edge.y1 > shelfMaxY
                    ? edge.y1 - shelfMaxY
                    : 0;

        const closeInY = dy < AISLE_WIDTH;
        const overlapsX = rangesOverlap(
            shelfMinX, shelfMaxX,
            edgeMinX, edgeMaxX
        );

        // ✅ NEW: click must project onto this edge
        const clickProjects =
            click.x >= edgeMinX &&
            click.x <= edgeMaxX;

        return closeInY && overlapsX && clickProjects;
    }

    return false;
}

function svgPoint(evt, element) {
    const svg = element.ownerSVGElement;
    const pt = svg.createSVGPoint();
    pt.x = evt.clientX;
    pt.y = evt.clientY;

    return pt.matrixTransform(
        element.getScreenCTM().inverse()
    );
}


function shelfOrientation(shelf) {
    return shelf.width >= shelf.height ? 'horizontal' : 'vertical';
}

function openGroupingModal(modalElement) {
    const modalEl = document.getElementById('groupItemModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    const foodItemId = modalElement.dataset.foodItemId;

    // Set hidden fields
    document.getElementById('{{ form.foodItemId.vars.id }}').value = foodItemId;
    document.getElementById('{{ form.supermarketId.vars.id }}').value = supermarketId;
    document.getElementById('{{ form.listId.vars.id }}').value = listId;

    modal.show();
}


document.getElementById('mapBackBtn').addEventListener('click', () => {
    clearSelection();

    placementState.edgeId = null;
    placementState.aisleSide = null;
    placementState.foodItemId = null;

    updatePlacementPayload();
    confirmBtn.disabled = true;

    mapView = false;
});

function updatePlacementPayload() {
    document.getElementById('placementPayload').value = JSON.stringify(placementState);
}

function clearSelection() {
    //clearShelfHighlights('placement-map');
    clearShelfHighlights('map-svg');

    placementState.edgeId = null;
    placementState.aisleSide = null;
}


</script>
{% endblock %}
