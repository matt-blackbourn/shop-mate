}
.modal-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}
.modal-btn {
    flex: 1 1 auto;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.85rem;
