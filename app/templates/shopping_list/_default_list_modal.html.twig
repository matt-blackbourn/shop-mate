{% if availableLists|length %}
<div class="modal fade  editPageModal" id="defaultListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="POST" action="/shoppinglist/default">
                <div class="modal-header">
                    <h5 class="modal-title">Set Default Shopping List</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <select id="listSelect" name="list_id" class="form-select w-100">
                        {% for list in availableLists %}
                            <option 
                                value="{{ list.id }}"
                            >
                                {% if app.user.defaultList and list.id == app.user.defaultList.id %}
                                    {{ list.owner.username }}'s List (default)
                                {% else %}
                                    {{ list.owner.username }}'s List
                                {% endif %}
                            </option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="current_list" value="{{ shoppingList.id }}">
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>

        </div>
    </div>
</div>
{% endif %}
