{% extends 'base.html.twig' %}

{% block title %}Edit Floor Plan{% endblock %}

{% block body %}
<div class="d-flex flex-column mb-4 border-bottom pb-3">

    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h4 mb-0">{{ floorPlan.type.value }} - {{ floorPlan.suburb }}</h1>
            <a href="{{ path('app_floor_plan_index') }}" class="btn btn-outline-secondary btn-sm">
                ← Back to list
            </a>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label for="snapDistance">Snap Distance:</label>
            <select id="snapDistance">
                <option value="0">Off</option>
                <option value="1" selected>1 Step</option>
                <option value="2">2 Steps</option>
                <option value="3">3 Steps</option>
                <option value="4">4 Steps</option>
            </select>
            <span id="node-count" class="badge bg-secondary">0 nodes</span>

            <button id="undo-node" type="button" class="btn btn-outline-secondary btn-sm">
                Undo last node
            </button>

            <div id="node-editor">
                <label>X: <input type="number" id="edit-x"></label>
                <label>Y: <input type="number" id="edit-y"></label>
            </div>

            <button id="delete-node" type="button" class="btn btn-outline-secondary btn-sm">
                Delete node
            </button>

            <form method="POST" action="{{ path('app_floorplan_to_supermarket_save', {'id': floorPlan.id}) }}"
                  id="nodesForm" class="d-flex align-items-center gap-2">
                <input type="hidden" name="nodes" id="nodesInput">
                <button id="save-nodes" type="submit" class="btn btn-primary btn-sm">
                    💾 Save as Supermarket
                </button>
            </form>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-2 mb-0" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<div id="floorplan-wrapper" data-floorplan-id="{{ floorPlan.id }}" data-raw-data="{{ floorPlan.rawData|json_encode|e('html_attr') }}">
    <svg id="overlay" style="border:1px solid #ccc; width:100%; height:100vh;"></svg>
</div>

<style>
    .node { 
        fill: #0d6efd; 
        stroke: #0d6efd; 
        stroke-width: 2; 
        cursor: pointer; 
    }

    .node-selected {
        fill: #ff4444;
        stroke: #ff4444;
        stroke-width: 2;
        cursor: pointer; 
    }
</style>

<script>
const svg = document.getElementById('overlay');
const nodes = [];
const nodeCountEl = document.getElementById('node-count');
const saveBtn = document.getElementById('save-nodes');
const EDGE_BUFFER = 50; // space around nodes for shelves/aisles
const RENDER_SCALE = 30; // adjust until it feels right

const wrapper = document.getElementById('floorplan-wrapper');
const rawData = JSON.parse(wrapper.dataset.rawData || '{}');
const nodesData = rawData.path || []; // ✅ only the path array

// Shared coordinates for snapping
const sharedX = new Set();
const sharedY = new Set();

let selectedNode = null;

const guideLayer = document.createElementNS(
    'http://www.w3.org/2000/svg',
    'g'
);
guideLayer.setAttribute('id', 'guide-layer');
svg.appendChild(guideLayer);
svg.insertBefore(guideLayer, svg.firstChild);


// Draw existing nodes and populate array
let pathLine = null;
const visualScale = rawData.visualScale || 1;
const scaledPath = nodesData.map(n => ({
    x: n.x * visualScale,
    y: n.y * visualScale
}));

if (scaledPath.length) {

    const xs = scaledPath.map(n => n.x);
    const ys = scaledPath.map(n => n.y);

    const minX = Math.min(...xs);
    const minY = Math.min(...ys);
    const maxX = Math.max(...xs);
    const maxY = Math.max(...ys);

    const width = maxX - minX;
    const height = maxY - minY;

    const normalizedPath = scaledPath.map(n => ({
        x: n.x - minX + EDGE_BUFFER,
        y: n.y - minY + EDGE_BUFFER
    }));

    svg.setAttribute(
        'viewBox',
        `0 0 ${width + EDGE_BUFFER * 2} ${height + EDGE_BUFFER * 2}`
    );

    // 🔥 draw path line first
    pathLine = drawPathLine(normalizedPath);

    // 🔥 then draw nodes
    normalizedPath.forEach(n => {
        const circle = drawNode(n.x, n.y);
        nodes.push({ x: n.x, y: n.y, element: circle });
        drawGuidesForNode(n.x, n.y);
    });

    // populate shared coordinates for snapping
    normalizedPath.forEach(n => {
        sharedX.add(n.x);
        sharedY.add(n.y);
    });
}

let SNAP_DISTANCE = 1 * visualScale; // default = 1 steps
document.getElementById('snapDistance').addEventListener('change', e => {
    const steps = parseInt(e.target.value, 10);
    SNAP_DISTANCE = steps * visualScale;
});

document.getElementById('delete-node').addEventListener('click', () => {
    if (!selectedNode) return;

    selectedNode.element.remove();
    const index = nodes.indexOf(selectedNode);
    if (index !== -1) nodes.splice(index, 1);

    selectedNode = null;
    updateNodeCount();
});

updateNodeCount();

function drawGuidesForNode(x, y) {

    const viewBox = svg.viewBox.baseVal;

    // --- Vertical line ---
    const vLine = document.createElementNS('http://www.w3.org/2000/svg','line');
    vLine.setAttribute('x1', x);
    vLine.setAttribute('x2', x);
    vLine.setAttribute('y1', viewBox.y);
    vLine.setAttribute('y2', viewBox.y + viewBox.height);

    // --- Horizontal line ---
    const hLine = document.createElementNS('http://www.w3.org/2000/svg','line');
    hLine.setAttribute('y1', y);
    hLine.setAttribute('y2', y);
    hLine.setAttribute('x1', viewBox.x);
    hLine.setAttribute('x2', viewBox.x + viewBox.width);

    [vLine, hLine].forEach(line => {
        line.setAttribute('stroke', '#00ff00');
        line.setAttribute('stroke-width', '0.5');
        line.setAttribute('opacity', '0.25');
        line.setAttribute('pointer-events', 'none');
        guideLayer.appendChild(line);
    });

    // --- X label (top of vertical line) ---
    // --- X label (top of vertical line) ---
    const labelY = viewBox.y + 25; // move down from top edge

    const xLabel = document.createElementNS('http://www.w3.org/2000/svg','text');

    xLabel.setAttribute('x', x - 2); // slight offset from line
    xLabel.setAttribute('y', labelY);

    xLabel.textContent = Math.round(x);

    // rotate around the label anchor
    xLabel.setAttribute(
        'transform',
        `rotate(-90 ${x - 2} ${labelY})`
    );

    // --- Y label (left of horizontal line) ---
    const yLabel = document.createElementNS('http://www.w3.org/2000/svg','text');
    yLabel.setAttribute('x', viewBox.x + 2);
    yLabel.setAttribute('y', y - 2);
    yLabel.textContent = Math.round(y);

    [xLabel, yLabel].forEach(label => {
        label.setAttribute('fill', '#00ff00');
        label.setAttribute('font-size', '8');
        label.setAttribute('opacity', '0.6');
        label.setAttribute('pointer-events', 'none');
        label.setAttribute('font-family', 'monospace');
        guideLayer.appendChild(label);
    });
}


function rebuildAllGuides() {
    guideLayer.innerHTML = '';
    nodes.forEach(n => drawGuidesForNode(n.x, n.y));
}


function drawPathLine(points) {
    const polyline = document.createElementNS(
        'http://www.w3.org/2000/svg',
        'polyline'
    );

    const pointString = points
        .map(p => `${p.x},${p.y}`)
        .join(' ');

    polyline.setAttribute('points', pointString);
    polyline.setAttribute('fill', 'none');
    polyline.setAttribute('stroke', '#ff4444');
    polyline.setAttribute('stroke-width', '2');
    polyline.setAttribute('pointer-events', 'none');

    polyline.classList.add('path-line');

    // Insert behind nodes
    svg.insertBefore(polyline, svg.firstChild);

    return polyline;
}


// --- Node creation ---
function drawNode(x, y) {
    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');

    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', 5); // stable visual size

    circle.classList.add('node');
    svg.appendChild(circle);

    circle.addEventListener('click', e => {
        selectedNode = nodes.find(n => n.element === circle);
        showInNodeEditor(selectedNode);
        selectNode(circle);
    });

    return circle;
}

function selectNode(circle) {

    // remove previous highlight
    nodes.forEach(n => n.element.classList.remove('node-selected'));

    const node = nodes.find(n => n.element === circle);
    if (!node) return;

    selectedNode = node;

    circle.classList.add('node-selected');

    // populate coordinate inputs
    document.getElementById('nodeX').value = Math.round(node.x);
    document.getElementById('nodeY').value = Math.round(node.y);
}

const editor = document.getElementById('node-editor');
const inputX = document.getElementById('edit-x');
const inputY = document.getElementById('edit-y');

function showInNodeEditor(node) {
    inputX.value = Math.round(node.x);
    inputY.value = Math.round(node.y);
}

function updateSelectedNode() {
    if (!selectedNode) return;

    const newX = parseFloat(inputX.value);
    const newY = parseFloat(inputY.value);

    // Remove old shared coords
    sharedX.delete(selectedNode.x);
    sharedY.delete(selectedNode.y);

    // Update data
    selectedNode.x = newX;
    selectedNode.y = newY;

    // Update SVG
    selectedNode.element.setAttribute('cx', newX);
    selectedNode.element.setAttribute('cy', newY);

    // Re-add shared coords
    sharedX.add(newX);
    sharedY.add(newY);

    rebuildAllGuides();
}

inputX.addEventListener('input', updateSelectedNode);
inputY.addEventListener('input', updateSelectedNode);

function createNode(x, y) {
    const circle = drawNode(x, y);
    nodes.push({ x, y, element: circle });
    drawGuidesForNode(x, y);
    updateNodeCount();
}


// --- Direction locking & snapping ---
let lastNode = null;
let directionLock = null;
const LOCK_THRESHOLD = 2 * visualScale;
let ignoreNextSnapX = false;
let ignoreNextSnapY = false;

svg.addEventListener('click', e => {
    if (e.target !== svg) return;

    const pt = svg.createSVGPoint();
    pt.x = e.clientX; pt.y = e.clientY;
    let { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

    if (lastNode) {
        if (directionLock === 'horizontal') y = lastNode.y;
        if (directionLock === 'vertical') x = lastNode.x;
    }

    ({ x, y } = snapToSharedCoordinates(x, y));
    createNode(x, y);

    if (e.shiftKey) { sharedX.add(x); sharedY.add(y); }

    directionLock = null;
    ignoreNextSnapX = false;
    ignoreNextSnapY = false;
    lastNode = nodes[nodes.length - 1];
});

svg.addEventListener('mousemove', e => {
    if (!lastNode) return;

    const pt = svg.createSVGPoint();
    pt.x = e.clientX; pt.y = e.clientY;
    let { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

    const dx = Math.abs(x - lastNode.x), dy = Math.abs(y - lastNode.y);
    if (!directionLock && (dx > LOCK_THRESHOLD || dy > LOCK_THRESHOLD)) {
        directionLock = dx > dy ? 'horizontal' : 'vertical';
    }

    if (directionLock === 'horizontal') y = lastNode.y;
    if (directionLock === 'vertical') x = lastNode.x;

    if (directionLock !== 'vertical') {
        for (const sy of sharedY) if (Math.abs(y - sy) <= SNAP_DISTANCE) y = sy;
    }
    if (directionLock !== 'horizontal') {
        for (const sx of sharedX) if (Math.abs(x - sx) <= SNAP_DISTANCE) x = sx;
    }
});

document.addEventListener('keydown', e => {
    if (e.key.toLowerCase() === 'x') ignoreNextSnapX = true;
    if (e.key.toLowerCase() === 'y') ignoreNextSnapY = true;
});

// --- Undo ---
document.getElementById('undo-node').addEventListener('click', () => {
    if (!nodes.length) return;
    const last = nodes.pop();
    last.element.remove();
    updateNodeCount();
});

// --- Snapping function ---
function snapToSharedCoordinates(x, y) {
    let sx = x;
    let sy = y;

    let closestX = null;
    let minDx = SNAP_DISTANCE;

    for (const px of sharedX) {
        const dx = Math.abs(x - px);
        if (dx <= minDx) {
            minDx = dx;
            closestX = px;
        }
    }

    if (closestX !== null) sx = closestX;

    let closestY = null;
    let minDy = SNAP_DISTANCE;

    for (const py of sharedY) {
        const dy = Math.abs(y - py);
        if (dy <= minDy) {
            minDy = dy;
            closestY = py;
        }
    }

    if (closestY !== null) sy = closestY;

    return { x: sx, y: sy };
}

// --- Node count update ---
function updateNodeCount() {
    nodeCountEl.textContent = `${nodes.length} nodes`;
    saveBtn.disabled = nodes.length === 0;
}


// --- Form submission ---
const form = document.getElementById('nodesForm');
const nodesInput = document.getElementById('nodesInput');

form.addEventListener('submit', e => {
    nodesInput.value = JSON.stringify({ path: nodes });
});
</script>

{% endblock %}