{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
<div class="toolbar">
    <a href="{{ path('app_supermarket_index') }}" class="btn btn-outline-secondary btn-sm">← Back to list</a>
    <button type="button" class="btn btn-primary" id="createShelfBtn">Create New Shelf</button>
    <button type="button" class="btn btn-danger" id="deleteShelfBtn" disabled>Delete Shelf</button>
    <button type="button" class="btn btn-secondary" id="toggleFullSelectBtn" disabled>Toggle Full Select</button>

    <form method="POST" action="/supermarket/{{ supermarket.id }}/shelves/save" id="shelfForm">
        <input type="hidden" name="shelves" id="shelfInput">
        <button type="submit" class="btn btn-primary mt-3">Save Shelves</button>
    </form>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-2 mb-0" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>



<!-- SVG editor -->
<div id="supermarket-wrapper" >
    <svg id="shelfEditor"
        viewBox="0 0 {{ viewBox.width }} {{ viewBox.height }}"
        class="w-100 border"
        preserveAspectRatio="xMinYMin meet"
        data-shelves="{{ shelves|json_encode|e('html_attr') }}"
        data-edges="{{ edges|json_encode|e('html_attr') }}"
        data-nodes="{{ nodes|json_encode|e('html_attr') }}"
        >
    </svg>
</div>

<style>
   #supermarket-wrapper {
        position: relative;
        width: 100vw;
        height: calc(100vh - 140px); /* leave room for header */
        overflow: hidden;
    }

    #shelfEditor {
        width: 100%;
        height: 100%;
        display: block;
    }

.shelf.full-select {
    stroke:#c78590;
    stroke-width: 2;
}
.shelf.selected {
    stroke-dasharray: 4;
}
.edge-handle {
    fill: transparent;
    pointer-events: all;
}
.toolbar {
  display: flex;
  gap: 8px;
  padding: 8px;
  border-bottom: 1px solid #ccc;
}


</style>

<script>
const SVG_NS = "http://www.w3.org/2000/svg";
let activeShelfId = null;
let resizeState = null;

const SNAP_DISTANCE = 2;
const svg = document.getElementById('shelfEditor');
const shelves = JSON.parse(svg.dataset.shelves);
const edgesData = JSON.parse(svg.dataset.edges);
const nodesData = JSON.parse(svg.dataset.nodes);

// --- Initial render ---
renderShelves();

// Draw edges - need nodes map for this
const nodes = {};
nodesData.forEach(n => {
    nodes[n.id] = n;
});
edgesData.forEach(e => {
    const from = nodes[e.from];
    const to   = nodes[e.to];

    // invisible edges - only visible with styles added
    const line = document.createElementNS(SVG_NS, 'line');
    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('path');

    svg.appendChild(line);
});

// --- Rendering ---
function renderShelves() {
    svg.innerHTML = '';

    shelves.forEach(shelf => {
        if(shelf.deleted) return;

        const g = document.createElementNS(SVG_NS, 'g');
        g.dataset.id = shelf.clientId;

        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', shelf.x);
        rect.setAttribute('y', shelf.y);
        rect.setAttribute('width', shelf.width);
        rect.setAttribute('height', shelf.height);
        rect.classList.add('shelf');

        if(shelf.fullSelect) rect.classList.add('full-select');

        rect.addEventListener('mousedown', () => selectShelf(shelf.clientId));
        if (shelf.clientId === activeShelfId) rect.classList.add('selected');

        g.appendChild(rect);

        if (shelf.clientId === activeShelfId) addEdgeHandles(g, shelf);

        svg.appendChild(g);
    });
}

function selectShelf(clientId) {
    activeShelfId = clientId;
    const hasSelection = !!activeShelfId;
    document.getElementById('toggleFullSelectBtn').disabled = !hasSelection;
    document.getElementById('deleteShelfBtn').disabled = !hasSelection;
    renderShelves();
}

// toggle full select button listener
document.getElementById('toggleFullSelectBtn').addEventListener('click', () => {
    if (!activeShelfId) return;

    const shelf = shelves.find(s => s.clientId === activeShelfId);
    if (!shelf) return;

    shelf.fullSelect = !shelf.fullSelect;

    renderShelves();
    console.log('Toggled fullSelect for shelf', shelf.id, shelf.fullSelect);
    console.log(shelves)
});

// Delete button listener
document.getElementById('deleteShelfBtn').addEventListener('click', () => {
    if (!activeShelfId) return;

    // Use strict equality to match UUID strings
    const index = shelves.findIndex(s => s.clientId === activeShelfId);
    if (index === -1) return;

    shelves[index].deleted = true;   // remove shelf
    activeShelfId = null;       // clear selection

    document.getElementById('deleteShelfBtn').disabled = true; // disable button
    renderShelves();
});

let creatingShelf = false;

// Enable “create shelf” mode
document.getElementById('createShelfBtn').addEventListener('click', () => {
    creatingShelf = true;
    svg.style.cursor = 'crosshair';
});

// When user clicks on SVG, create new shelf
svg.addEventListener('click', (e) => {
    if (!creatingShelf) return;

    // Calculate SVG coordinates from client coordinates
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    const svgP = pt.matrixTransform(svg.getScreenCTM().inverse());

    const newShelf = {
        id: null,
        clientId: crypto.randomUUID(),
        x: svgP.x - 15, // small default size centered on click
        y: svgP.y - 5,
        width: 25,
        height: 25,
        fullSelect: false,
    };

    shelves.push(newShelf);
    activeShelfId = newShelf.clientId;

    creatingShelf = false;
    svg.style.cursor = 'default';

    renderShelves();
});


// --- Edge handles ---
const HANDLE_THICKNESS = 5;

function addEdgeHandles(group, shelf) {
    const edges = [
        { edge: 'n', x: shelf.x, y: shelf.y - HANDLE_THICKNESS/2, w: shelf.width, h: HANDLE_THICKNESS, cursor: 'ns-resize' },
        { edge: 's', x: shelf.x, y: shelf.y + shelf.height - HANDLE_THICKNESS/2, w: shelf.width, h: HANDLE_THICKNESS, cursor: 'ns-resize' },
        { edge: 'w', x: shelf.x - HANDLE_THICKNESS/2, y: shelf.y, w: HANDLE_THICKNESS, h: shelf.height, cursor: 'ew-resize' },
        { edge: 'e', x: shelf.x + shelf.width - HANDLE_THICKNESS/2, y: shelf.y, w: HANDLE_THICKNESS, h: shelf.height, cursor: 'ew-resize' },
    ];

    edges.forEach(({ edge, x, y, w, h, cursor }) => {
        const handle = document.createElementNS(SVG_NS, 'rect');
        handle.setAttribute('x', x);
        handle.setAttribute('y', y);
        handle.setAttribute('width', w);
        handle.setAttribute('height', h);
        handle.classList.add('edge-handle');
        handle.style.cursor = cursor;

        handle.addEventListener('mousedown', e => startResize(e, shelf.clientId, edge));
        group.appendChild(handle);
    });
}

// --- Resize logic ---
function startResize(event, shelfId, edge) {
    event.stopPropagation();
    const shelf = shelves.find(s => s.clientId === shelfId);

    resizeState = {
        shelfId,
        edge,
        startX: event.clientX,
        startY: event.clientY,
        startShelf: { ...shelf }
    };

    window.addEventListener('mousemove', onResizeMove);
    window.addEventListener('mouseup', endResize);
}

function onResizeMove(e) {
    if (!resizeState) return;

    const shelf = shelves.find(s => s.clientId === resizeState.shelfId);
    const dx = e.clientX - resizeState.startX;
    const dy = e.clientY - resizeState.startY;
    const start = resizeState.startShelf;

    switch(resizeState.edge) {
        case 'e':
            shelf.width = Math.max(5, start.width + dx);
            break;
        case 'w':
            shelf.x = start.x + dx;
            shelf.width = Math.max(5, start.width - dx);
            break;
        case 's':
            shelf.height = Math.max(5, start.height + dy);
            break;
        case 'n':
            shelf.y = start.y + dy;
            shelf.height = Math.max(5, start.height - dy);
            break;
    }

    snapShelf(shelf);
    renderShelves();
}

function endResize() {
    resizeState = null;
    window.removeEventListener('mousemove', onResizeMove);
    window.removeEventListener('mouseup', endResize);
}

// --- Snapping ---


function snapShelf(shelf) {
    shelves.forEach(other => {
        if (other.clientId === shelf.clientId) return;

        // Horizontal snap
        if (Math.abs(shelf.x + shelf.width - other.x) < SNAP_DISTANCE) shelf.width = other.x - shelf.x;
        if (Math.abs(shelf.x - (other.x + other.width)) < SNAP_DISTANCE) shelf.x = other.x + other.width;

        // Vertical snap
        if (Math.abs(shelf.y + shelf.height - other.y) < SNAP_DISTANCE) shelf.height = other.y - shelf.y;
        if (Math.abs(shelf.y - (other.y + other.height)) < SNAP_DISTANCE) shelf.y = other.y + other.height;
    });
}

document.getElementById('shelfForm').addEventListener('submit', e => {

    // sanitize shelves before submit - remove clientId and include deleted flag
    const payload = shelves.map(shelf => ({
        id: shelf.id ?? null,      // only real DB ids
        x: shelf.x,
        y: shelf.y,
        width: shelf.width,
        height: shelf.height,
        deleted: !!shelf.deleted,
        fullSelect: !!shelf.fullSelect,
    }));

    document.getElementById('shelfInput').value = JSON.stringify(payload);
});


</script>





{% endblock %}