<div class="modal fade map-modal" id="pathModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header d-flex justify-content-between">
                <button type="button"
                        id="pathCancelBtn"
                        class="map-nav-button"
                        data-bs-dismiss="modal">
                    Back To List
                </button>

                <button type="button"
                        id="place-item-map"
                        class="map-nav-button">
                    Place Item On Map
                </button>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="path-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="path-edges-layer"></g>
                        <g id="path-entrance-layer"></g>
                    </svg>
                </div>
            </div>

            <div class="modal-footer">
                <div class="title">
                    <span id="modalItemName" class="title"></span>
                    <span id="modalItemQty"></span>
                    <!-- wrap notes in its own block container -->
                    <div id="modalItemNotes"></div>
                </div>
                <button id="skip-item-map" class="pick-skip skip" type="button">Skip</button>
                <button id="pick-item-map" class="pick-skip pick" type="button">Pick Item</button>
            </div>
        </div>
    </div>
</div>


