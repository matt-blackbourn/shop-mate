{% extends 'base.html.twig' %}

{% block title %}Store Mapper{% endblock %}

{% block body %}

<div class="mapper-page d-flex flex-column">

    <!-- HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left: Menu -->
            <div class="header-left d-flex align-items-center">
                <button class="menu-button" aria-label="Open menu">☰</button>
            </div>

            <!-- Center: Title -->
            <div class="header-center flex-grow-1 text-center fw-semibold">
                Store Mapper
            </div>

            <!-- Right: Save -->
            <div class="header-right d-flex align-items-center">
            <button type="button" id="save-map" disabled title="Save changes" class="btn-dark-base border-green">
                <i class="bi bi-check-lg"></i>
            </button>
            </div>
        </div>
    </div>

    <!-- MENU (outside header for z-index safety) -->
    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close">×</button>
        <ul>
            <li><a href="{{ path('app_home') }}">Back to List</a></li>
        </ul>
    </nav>

    <!-- BODY (MAP) -->
    <div class="page-body">
        <div class="mapper-map-container">
            <svg class="mapper-svg"></svg>

            <svg class="mapper-arrow" viewBox="-10 -10 20 20">
                <polygon points="0,-10 5,5 -5,5" fill="#00d4ff"/>
            </svg>
        </div>
    </div>

    <!-- FOOTER (NUMBERPAD CONTROLS) -->
    <div class="page-footer mapper-footer">

        <!-- Direction + Enter Row -->
        <div class="mapper-actions">
            <button class="btn-dark-base border-yellow" data-direction="left">
                <i class="bi bi-arrow-left"></i>
            </button>

        <!-- Display -->
            <div class="mapper-display">
                <span id="stepDisplay">0</span>
            </div>

            <button class="btn-dark-base border-yellow" data-direction="right">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>

        <!-- Number Pad -->
        <div class="mapper-numpad">
            {% for n in [1,2,3,4,5,6,7,8,9] %}
                <button class="btn-dark-base border-yellow keypad" data-number="{{ n }}">{{ n }}</button>
            {% endfor %}
            <button class="btn-dark-base border-red keypad">⌫</button>
            <button class="btn-dark-base border-yellow keypad" data-number="0">0</button>
            <button class="btn-dark-base border-green keypad">Enter</button>

        </div>

    </div>

</div>




<style>
.mapper-page {
    height: 100dvh;   /* important for mobile */
    background: #1c212b;
    color: #e9ecef;
    display: flex;
    flex-direction: column;
}

/* HEADER */
.page-header {
    background-color: #2b303b;
    border-bottom: 1px solid #343a46;
    position: sticky;
    top: 0;
    z-index: 1030;
}

.header-btn {
    background: #1c212b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

.header-btn:hover {
    background: #343a46;
}

/* BODY */
.page-body {
    flex: 1;
    min-height: 0;      /* CRITICAL */
    overflow: hidden;
    position: relative;
}

.mapper-map-container {
    position: absolute;
    inset: 0;
}

.mapper-svg {
    width: 100%;
    height: 100%;
}

.mapper-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    transform-origin: 50% 50%;
    pointer-events: none;
}

/* FOOTER */
.mapper-footer {
    background: #2b303b;
    border-top: 1px solid #343a46;

    height: 30dvh;          /* 👈 controlled size */
    max-height: 420px;      /* safety cap for large phones */

    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
}

/* Display */
.mapper-display {
    background: #11151c;
    border: 1px solid #343a46;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 18px;
    text-align: right;
    font-weight: bold;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    width: 100%;
    height: 100%;
}

.mapper-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    align-items: stretch;
}


/* Numpad */
.mapper-numpad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 1fr); /* force 4 even rows */
    gap: 6px;
    flex: 1;  
}

.keypad {
    padding: 0.25rem 0.5rem;
}

</style>

{% endblock %}