{% extends 'base.html.twig' %}

{% block title %}Supermarket index{% endblock %}

{% block body %}
    <h1>Supermarket index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for supermarket in supermarkets %}
            <tr>
                <td>{{ supermarket.id }}</td>
                <td>{{ supermarket.type.value }} - {{ supermarket.suburb }}</td>
                <td>
                    {# <a href="{{ path('admin_assign_food_edges', {'id': supermarket.id}) }}">assign food</a> #}
                    {# <a href="{{ path('app_supermarket_edit', {'id': supermarket.id}) }}">edit</a> #}
                    {# <a href="{{ path('app_supermarket_draw_nodes', {'id': supermarket.id}) }}">nodes</a> #}
                    {% if supermarket.imagePath %}
                        <a href="{{ path('app_supermarket_draw_edges_overlay', {'id': supermarket.id}) }}">Edges - image overlay</a>
                    {% else %}
                        <a href="{{ path('app_supermarket_draw_edges', {'id': supermarket.id}) }}">Edges</a>
                    {% endif %}

                    {% if supermarket.shelves|length == 0 %}| <a href="{{ path('app_supermarket_draw_shelves', {'id': supermarket.id}) }}">Generate Shelves</a>{% endif %}

                    | <a href="{{ path('app_supermarket_edit_shelves', {'id': supermarket.id}) }}">Edit shelves</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# <a href="{{ path('app_supermarket_new') }}">Create new</a> #}

    <a href="{{ path('app_home') }}">Home</a>
{% endblock %}
