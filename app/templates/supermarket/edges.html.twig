{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
    <div class="d-flex align-items-center gap-3 mb-3 border-bottom pb-2">
          <h1 class="h4 mb-0">{{ supermarket.name }}</h1>

        <a href="{{ path('app_supermarket_index') }}"
        class="btn btn-link btn-sm text-muted">
            Back to list
        </a>
        <button
            id="save-edges"
            class="btn btn-success btn-sm ms-auto"
        >
            Save edges
        </button>
    </div>


    <div id="supermarket-wrapper" data-supermarket-id="{{ supermarket.id }}" data-nodes="{{ nodes|json_encode|e('html_attr') }}">
        <img
            id="supermarket-img"
            src="{{ asset('uploads/supermarkets/' ~ supermarket.imagePath) }}"
            width="{{ supermarket.width }}"
            height="{{ supermarket.height }}"
            alt="Floor plan"
        >
        {# top left = 0,0 #}
        <svg
            id="overlay"
            width="{{ supermarket.width }}"
            height="{{ supermarket.height }}"
            viewBox="0 0 {{ supermarket.width }} {{ supermarket.height }}"
            preserveAspectRatio="none"
        >
        </svg>
    </div>

<style>
    #supermarket-wrapper {
        position: relative;
        display: inline-block;
    }
    #overlay {
        position: absolute;
        top: 0;
        left: 0;
    }
  .node {
    fill: #0d6efd;
    cursor: pointer;
    }

    .node-selected {
    fill: orange;
    stroke: black;
    stroke-width: 2;
    }

    .edge {
    stroke: rgba(0, 123, 255, 0.6);
    stroke-width: 3;
    cursor: pointer;
    }

    .edge:hover {
    stroke: red;
    }

</style>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('supermarket-wrapper');
    const svg = document.getElementById('overlay');
    const nodesData = JSON.parse(wrapper.dataset.nodes);

    const nodes = {};   // id -> { id, x, y, element }
    const edges = [];

    let selectedNode = null;

    /* -----------------------------
     * Load & draw nodes
     * ----------------------------- */
    nodesData.forEach(n => {
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', n.x);
        circle.setAttribute('cy', n.y);
        circle.setAttribute('r', 6);
        circle.classList.add('node');

        svg.appendChild(circle);

        nodes[n.id] = { ...n, element: circle };
    });

    /* -----------------------------
     * Helpers
     * ----------------------------- */
    function findNearestNode(x, y, maxDistance = 20) {
        let nearest = null;
        let minDist = Infinity;

        Object.values(nodes).forEach(node => {
            const dx = node.x - x;
            const dy = node.y - y;
            const dist = Math.sqrt(dx * dx + dy * dy);

            if (dist < minDist) {
                minDist = dist;
                nearest = node;
            }
        });

        return minDist <= maxDistance ? nearest : null;
    }

    function selectNode(node) {
        selectedNode = node;
        node.element.classList.add('node-selected');
    }

    function clearSelection() {
        if (selectedNode) {
            selectedNode.element.classList.remove('node-selected');
            selectedNode = null;
        }
    }

    function edgeExists(a, b) {
        return edges.some(e =>
            (e.from === a.id && e.to === b.id) ||
            (e.from === b.id && e.to === a.id)
        );
    }

    // stopPropagation() prevents node-selection firing
    function createEdge(a, b) {
        if (edgeExists(a, b)) return;

        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', a.x);
        line.setAttribute('y1', a.y);
        line.setAttribute('x2', b.x);
        line.setAttribute('y2', b.y);
        line.classList.add('edge');

        // CLICK TO REMOVE
        line.addEventListener('click', e => {
            e.stopPropagation();

            const index = edges.findIndex(ed => ed.element === line);
            if (index !== -1) {
                edges[index].element.remove();
                edges.splice(index, 1);
            }
        });

        svg.prepend(line);

        edges.push({
            from: a.id,
            to: b.id,
            element: line
        });
    }

    /* -----------------------------
     * Click handling
     * ----------------------------- */
    svg.addEventListener('click', e => {
        const pt = svg.createSVGPoint();
        pt.x = e.clientX;
        pt.y = e.clientY;
        const { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

        const nearest = findNearestNode(x, y);
        if (!nearest) return;

        if (!selectedNode) {
            selectNode(nearest);
            return;
        }

        if (selectedNode.id === nearest.id) {
            clearSelection();
            return;
        }

        createEdge(selectedNode, nearest);
        clearSelection();
    });

// Save edges button (bulk persist)
    document.getElementById('save-edges').addEventListener('click', async () => {
        const supermarketId = wrapper.dataset.supermarketId;

        const payload = edges.map(e => ({
            from: e.from,
            to: e.to
        }));

        if (!payload.length) {
            alert('No edges to save');
            return;
        }

        try {
            const res = await fetch(`/supermarket/ajax/${supermarketId}/edges/save`,
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                }
            );

            if (!res.ok) throw new Error('Failed');

            alert('Edges saved');
        } catch (e) {
            alert('Error saving edges');
            console.error(e);
        }
    });
});
   
</script>

{% endblock %}
