{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
<div class="toolbar">
  <button id="auto-generate">Auto-generate shelves</button>
  <button id="draw-mode">Draw shelf</button>
  <button id="select-mode" class="active">Select</button>
  <button id="delete-shelf">Delete</button>
  <button id="save-shelves">Save</button>
</div>

<svg 
    id="shelf-editor" 
    width="1200" 
    height="800"
    data-nodes="{{ nodes|json_encode|e('html_attr') }}"
    data-edges="{{ edges|json_encode|e('html_attr') }}"
    data-map="{{ map|json_encode|e('html_attr') }}"
>
  <g id="edges-layer"></g>
  <g id="shelves-layer"></g>
</svg>

<style>
.toolbar {
  display: flex;
  gap: 8px;
  padding: 8px;
  border-bottom: 1px solid #ccc;
}

.toolbar button.active {
  background: #ffd54f;
}

#shelf-editor {
  background: #fafafa;
  cursor: crosshair;
}

.edge {
  stroke: #0d6efd;
  stroke-width: 4;
}

.shelf {
  fill: #e0e0e0;
  stroke: #999;
  cursor: move;
}

.shelf.selected {
  stroke: #ff9800;
  stroke-width: 2;
}

.shelf.draft {
  fill: rgba(200,200,200,0.4);
  stroke-dasharray: 4;
}


</style>
<script>
const svg = document.getElementById('shelf-editor');
const edgesLayer = document.getElementById('edges-layer');
const shelvesLayer = document.getElementById('shelves-layer');
const autoGenerateBtn = document.getElementById('auto-generate');

const SVG_NS = 'http://www.w3.org/2000/svg';

let mode = 'select'; // 'draw' | 'select'
let shelves = [];
let activeShelfId = null;

let tempRect = null;
let startX = 0;
let startY = 0;
let dragOffsetX = 0;
let dragOffsetY = 0;



// set viewBox so SVG scales cleanly
const edgesData = JSON.parse(svg.dataset.edges);
const nodesData = JSON.parse(svg.dataset.nodes);
const [mapWidth, mapHeight] = JSON.parse(svg.dataset.map);
svg.setAttribute('viewBox', `0 0 ${mapWidth} ${mapHeight}`);

const nodes = {};
nodesData.forEach(n => {
    nodes[n.id] = n;
});

edgesData.forEach(e => {
    const from = nodes[e.from];
    const to   = nodes[e.to];

    // visible edge
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('edge');

    edgesLayer.appendChild(line);
});

autoGenerateBtn.onclick = autoGenerateShelves;

// auto generate shelves from edges
function autoGenerateShelves() {
  shelvesLayer.innerHTML = '';
  shelves = [];

  const aisleWidth = 80;
  const shelfDepth = 30;
  const offset = aisleWidth / 2 + shelfDepth / 2;
  const MIN_LENGTH = 150;
  const TOLERANCE = 5;

  edgesData.forEach(edge => {
    const dx = edge.x2 - edge.x1;
    const dy = edge.y2 - edge.y1;

    const absDx = Math.abs(dx);
    const absDy = Math.abs(dy);

    // ---------- HORIZONTAL AISLE ----------
    if (absDy <= TOLERANCE && absDx >= MIN_LENGTH) {
      const x = Math.min(edge.x1, edge.x2);
      const y = edge.y1;
      const width = absDx;

      // shelves above & below
      shelves.push(
        {
          id: crypto.randomUUID(),
          x,
          y: y - offset - shelfDepth / 2,
          width,
          height: shelfDepth,
          edgeId: edge.id
        },
        {
          id: crypto.randomUUID(),
          x,
          y: y + offset - shelfDepth / 2,
          width,
          height: shelfDepth,
          edgeId: edge.id
        }
      );

      return;
    }

    // ---------- VERTICAL AISLE ----------
    if (absDx <= TOLERANCE && absDy >= MIN_LENGTH) {
      const x = edge.x1;
      const y = Math.min(edge.y1, edge.y2);
      const height = absDy;

      // shelves left & right
      shelves.push(
        {
          id: crypto.randomUUID(),
          x: x - offset - shelfDepth / 2,
          y,
          width: shelfDepth,
          height,
          edgeId: edge.id
        },
        {
          id: crypto.randomUUID(),
          x: x + offset - shelfDepth / 2,
          y,
          width: shelfDepth,
          height,
          edgeId: edge.id
        }
      );

      return;
    }

    // ---------- DIAGONAL / SHORT EDGE ----------
    // ignored for shelf generation
  });

  shelves.forEach(drawShelf);
}



function drawShelf(shelf) {
  const rect = document.createElementNS(SVG_NS, 'rect');

  rect.setAttribute('x', shelf.x);
  rect.setAttribute('y', shelf.y);
  rect.setAttribute('width', shelf.width);
  rect.setAttribute('height', shelf.height);
  rect.dataset.id = shelf.id;
    rect.dataset.edgeId = shelf.edgeId ?? '';
  rect.classList.add('shelf', 'auto');

  shelvesLayer.appendChild(rect);
}

// Drawing new shelves (drag to create)
svg.addEventListener('pointerdown', e => {
  if (mode !== 'draw') return;

  startX = e.offsetX;
  startY = e.offsetY;

  tempRect = document.createElementNS(SVG_NS, 'rect');
  tempRect.classList.add('shelf', 'draft');
  shelvesLayer.appendChild(tempRect);
});

svg.addEventListener('pointermove', e => {
  if (!tempRect) return;

  const x = Math.min(startX, e.offsetX);
  const y = Math.min(startY, e.offsetY);
  const w = Math.abs(e.offsetX - startX);
  const h = Math.abs(e.offsetY - startY);

  tempRect.setAttribute('x', x);
  tempRect.setAttribute('y', y);
  tempRect.setAttribute('width', w);
  tempRect.setAttribute('height', h);
});

svg.addEventListener('pointerup', () => {
  if (!tempRect) return;

  const shelf = {
    id: crypto.randomUUID(),
    x: +tempRect.getAttribute('x'),
    y: +tempRect.getAttribute('y'),
    width: +tempRect.getAttribute('width'),
    height: +tempRect.getAttribute('height')
  };

  shelves.push(shelf);
  tempRect.dataset.id = shelf.id;
  tempRect.classList.remove('draft');
  tempRect = null;
});

// selecting and moving shelves
shelvesLayer.addEventListener('pointerdown', e => {
  if (mode !== 'select') return;
  if (e.target.tagName !== 'rect') return;

  activeShelfId = e.target.dataset.id;
  document.querySelectorAll('.shelf').forEach(r => r.classList.remove('selected'));
  e.target.classList.add('selected');

  dragOffsetX = e.offsetX - e.target.x.baseVal.value;
  dragOffsetY = e.offsetY - e.target.y.baseVal.value;
});

svg.addEventListener('pointermove', e => {
  if (!activeShelfId || mode !== 'select') return;

  const rect = document.querySelector(`[data-id="${activeShelfId}"]`);
  rect.x.baseVal.value = e.offsetX - dragOffsetX;
  rect.y.baseVal.value = e.offsetY - dragOffsetY;
});

svg.addEventListener('pointerup', () => {
  activeShelfId = null;
});

// delete and mode buttons
document.getElementById('draw-mode').onclick = () => setMode('draw');
document.getElementById('select-mode').onclick = () => setMode('select');

function setMode(newMode) {
  mode = newMode;
  document.querySelectorAll('.toolbar button').forEach(b => b.classList.remove('active'));
  document.getElementById(`${newMode}-mode`).classList.add('active');
}

document.getElementById('delete-shelf').onclick = () => {
  if (!activeShelfId) return;

  shelves = shelves.filter(s => s.id !== activeShelfId);
  document.querySelector(`[data-id="${activeShelfId}"]`)?.remove();
  activeShelfId = null;
};

// save shelves
document.getElementById('save-shelves').onclick = () => {
  console.log('Shelves to save:', shelves);

  // POST shelves to backend here
};



</script>

{% endblock %}