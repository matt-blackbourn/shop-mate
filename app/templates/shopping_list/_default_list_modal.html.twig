{% if availableLists|length %}
<div class="modal fade  editPageModal" id="defaultListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="POST" action="/shoppinglist/default">
                <div class="modal-header">
                    <h5 class="modal-title">Set Default Shopping List</h5>
                    <button type="button" class="btn" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg text-white"></i>
                    </button>
                </div>

                <div class="modal-body">
                    <select id="listSelect" name="list_id" class="form-select w-100">
                        {% for list in availableLists %}
                            {% if list.type.value == 'normal'%}
                                <option 
                                    value="{{ list.id }}"
                                >
                                    {% if app.user.defaultList and list.id == app.user.defaultList.id %}
                                        {{ list.name }} (default)
                                    {% else %}
                                        {{ list.name }}
                                    {% endif %}
                                </option>
                            {% endif %}
                        {% endfor %}
                    </select>
                    <input type="hidden" name="current_list" value="{{ shoppingList.id }}">
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>

        </div>
    </div>
</div>
{% endif %}
