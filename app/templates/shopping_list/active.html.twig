function drawEntranceArrow(node) {
    let layer = getLayer('placement-map', 'placement-entrance-layer');

    // --- create group ---
    const g = document.createElementNS(SVG_NS, 'g');
    g.classList.add('node', 'entrance');
    g.setAttribute('transform', `translate(${node.x}, ${node.y})`);

    // Halo
    const ring = document.createElementNS(SVG_NS, 'circle');
    ring.setAttribute('r', 15);

    // Base circle
    const circle = document.createElementNS(SVG_NS, 'circle');
    circle.setAttribute('r', 10);

    g.appendChild(ring);
    g.appendChild(circle);

    const firstEdge = edgesData.find(e => e.from === node.id);
    if (firstEdge) {
        const dx = firstEdge.x2 - firstEdge.x1; // horizontal distance
        const dy = firstEdge.y2 - firstEdge.y1; // vertical distance
        const angle = Math.atan2(dy, dx) * (180 / Math.PI); // rotation in degrees

        const arrowLength = dx ? Math.abs(dx) : Math.abs(dy); // length of the line
        const arrowTipWidth = arrowLength/5; // size of the tip

        // Arrow line starting at node center
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', 0);
        line.setAttribute('y1', 0);
        line.setAttribute('x2', arrowLength);
        line.setAttribute('y2', 0);
        line.setAttribute('transform', `rotate(${angle})`);
        line.classList.add('arrow-line');
        g.appendChild(line);

        // Arrow tip at end of line
        const tip = document.createElementNS(SVG_NS, 'path');
        tip.setAttribute('d', `M0 ${-arrowTipWidth/2} L${arrowTipWidth} 0 L0 ${arrowTipWidth/2} Z`);
        tip.setAttribute('fill', '#f2b66d');

        // Translate the tip along the rotated X axis so it sits exactly at the end of the line
        tip.setAttribute('transform', `rotate(${angle}) translate(${arrowLength},0)`);
        g.appendChild(tip);
    }

    // append to entrance layer
    layer.appendChild(g);
}


function isWallShelf(shelf, edge) {
    const edgeIsHorizontal = edge.y1 === edge.y2;
    const edgeIsVertical   = edge.x1 === edge.x2;

    const shelfMinX = shelf.x;
    const shelfMaxX = shelf.x + shelf.width;
    const shelfMinY = shelf.y;
    const shelfMaxY = shelf.y + shelf.height;

    const otherEdges = edgesData.filter(e => e !== edge);

    for (const e of otherEdges) {

        const eIsHorizontal = e.y1 === e.y2;
        const eIsVertical   = e.x1 === e.x2;

        // Must be parallel
        if (edgeIsHorizontal && !eIsHorizontal) continue;
        if (edgeIsVertical   && !eIsVertical)   continue;

        if (edgeIsHorizontal) {
            // Must overlap shelf in X
            const overlapsX =
                Math.min(shelfMaxX, Math.max(e.x1, e.x2)) >
                Math.max(shelfMinX, Math.min(e.x1, e.x2));

            if (!overlapsX) continue;

            // Must be on opposite side of shelf
            const edgeIsAbove = edge.y1 < shelfMinY;
            const eIsAbove    = e.y1 < shelfMinY;

            if (edgeIsAbove !== eIsAbove) {
                return false; // aisle shelf
            }
        }

        if (edgeIsVertical) {
            // Must overlap shelf in Y
            const overlapsY =
                Math.min(shelfMaxY, Math.max(e.y1, e.y2)) >
                Math.max(shelfMinY, Math.min(e.y1, e.y2));

            if (!overlapsY) continue;

            // Must be on opposite side
            const edgeIsLeft = edge.x1 < shelfMinX;
            const eIsLeft    = e.x1 < shelfMinX;

            if (edgeIsLeft !== eIsLeft) {
                return false; // aisle shelf
            }
        }
    }

    return true; // no opposite parallel edge → wall shelf
}



function linesIntersect(l1, l2) {
    // Horizontal
    if (l2.y1 === l2.y2) {
        // l2 horizontal
        return (
            l1.x1 >= Math.min(l2.x1, l2.x2) &&
            l1.x1 <= Math.max(l2.x1, l2.x2) &&
            l1.y1 <= l2.y1 && l1.y2 >= l2.y2 || l1.y1 >= l2.y2 && l1.y2 <= l2.y1
        );
    }
    // Vertical
    if (l2.x1 === l2.x2) {
        return (
            l1.y1 >= Math.min(l2.y1, l2.y2) &&
            l1.y1 <= Math.max(l2.y1, l2.y2) &&
            l1.x1 <= l2.x1 && l1.x2 >= l2.x2 || l1.x1 >= l2.x2 && l1.x2 <= l2.x1
        );
    }

    return false;
}


