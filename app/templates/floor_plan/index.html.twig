{% extends 'base.html.twig' %}

{% block title %}FloorPlan index{% endblock %}

{% block body %}
    <h1>FloorPlan index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Suburb</th>
                <th>DateCreated</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for floorPlan in floorPlans %}
            <tr>
                <td>{{ floorPlan.id }}</td>
                <td>{{ floorPlan.suburb }}</td>
                <td>{{ floorPlan.dateCreated ? floorPlan.dateCreated|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ floorPlan.type.value }}</td>
                <td>
                    <a href="{{ path('app_floor_plan_edit', {'id': floorPlan.id}) }}">edit</a>
                    | <a href="{{ path('app_floorplan_nodes', {'id': floorPlan.id}) }}">nodes</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
