<div class="modal fade map-modal" id="placementModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h6 class="modal-title">
                    Tap the aisle this item belongs in. </br>
                    Tap again to change aisle side:
                </h6>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="placement-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="placement-edges-layer"></g>
                        <g id="placement-entrance-layer"></g>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>
<style>

.edge {
    stroke: #0f1115;
    stroke-width: 10;
    stroke-linecap: round;
}

.edge-hit {
    stroke: transparent;
    stroke-width: 50;
    cursor: pointer;
    pointer-events: stroke;
}

.edge:hover {
    stroke: #3d4658;
}

.edge.selected {
    stroke: #51cf66;
    stroke-width: 20;
    animation: pulse 1s infinite;
    filter: drop-shadow(0 0 6px rgba(77,171,247,0.8));
}

.edge.dimmed {
    opacity: 0.3;
}


.edge-side {
    fill: #6bb37a;
    opacity: 0;
    transition: opacity 0.15s ease;
}

.node.entrance {
    paint-order: stroke fill; /* ensures arrow is above circle */
}

.node.entrance circle:first-child {
    fill: #51cf66;
}

.node.entrance circle:nth-child(2) {
    fill: #51cf66;
}

.node.entrance path {
    fill: #51cf66; /* same as node */
}
.node.entrance .arrow-line {
    stroke: #51cf66;   /* same bright color */
    stroke-width: 6;
    stroke-linecap: round;
}

/* ----------------------
   Animations
   ---------------------- */
@keyframes pulse {
    0%   { stroke-width: 8;  opacity: 0.7; }
    50%  { stroke-width: 12; opacity: 1; }
    100% { stroke-width: 8;  opacity: 0.7; }
}
</style>

<script>


// Vector math to offset left/right
function highlightAisleSide(edge, aisleSide) {
    const { from, to, sideRect } = edge;

    const dx = to.x - from.x;
    const dy = to.y - from.y;
    const len = Math.hypot(dx, dy);
    if (len === 0) return;

    // rectangle thickness (distance from aisle center to side)
    // SAME constants as shelf generation
    const directionFactor = edge.from.id < edge.to.id ? 1 : -1;
    const geometrySide = aisleSide * directionFactor;
    const offset = (AISLE_WIDTH / 2 ) * geometrySide;

    // compute perpendicular vector
    const px = -dy / len;
    const py = dx / len;

    // rectangle center = middle of aisle, offset toward side
    const cx = (from.x + to.x)/2 + px * offset/2;
    const cy = (from.y + to.y)/2 + py * offset/2;

    // rectangle rotation angle
    const angle = Math.atan2(dy, dx) * 180 / Math.PI;

    sideRect.setAttribute('width', len);          // along aisle
    sideRect.setAttribute('height', Math.abs(offset)); // perpendicular
    sideRect.setAttribute('x', cx - len/2);       // center it
    sideRect.setAttribute('y', cy - Math.abs(offset)/2);
    sideRect.setAttribute('transform', `rotate(${angle}, ${cx}, ${cy})`);

    sideRect.style.opacity = 1;
}

function selectEdge(edgeId) {
    edgeId = Number(edgeId);
    const edge = placementEdgeEls.get(edgeId);

    if (placementState.edgeId === edgeId) {
        placementState.aisleSide *= -1;
    } else {
        clearSelection();
        placementState.edgeId = edgeId;
        placementState.aisleSide = -1;
    }

   // Highlight the edge on the map
    edge.line.classList.add('selected');

    highlightAisleSide(edge, placementState.aisleSide);
    updatePlacementPayload();

    confirmBtn.disabled = false;
}

function preselectEdge(edgeId, aisleSide) {
    edgeId = Number(edgeId);
    clearSelection();

    placementState.edgeId = edgeId;
    placementState.aisleSide = aisleSide;

    const edge = placementEdgeEls.get(edgeId);
    if (!edge) return;

    edge.line.classList.add('selected');

    highlightAisleSide(edge, placementState.aisleSide);
}

function updatePlacementPayload() {
    console.log(placementState);
    document.getElementById('placementPayload').value = JSON.stringify(placementState);
}

function clearSelection() {
    placementEdgeEls.forEach(({ line, sideRect }) => {
        line.classList.remove('selected');
        if (sideRect) sideRect.style.opacity = 0;
    });

    placementState.edgeId = null;
    placementState.aisleSide = null;
}
</script>