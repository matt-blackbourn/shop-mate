<div class="modal fade editPageModal" id="defaultSupermarketModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="POST" action="/supermarket/default">
                <div class="modal-header">
                    <h5 class="modal-title">Set Default Supermarket</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <select id="defaultSelect" name="supermarket_id" class="form-select w-100">
                        {% for supermarket in supermarkets %}
                            <option 
                                value="{{ supermarket.id }}"
                                {% if app.user.defaultSupermarket and supermarket.id == app.user.defaultSupermarket.id %}
                                    selected
                                {% endif %}
                            >
                                {{ supermarket.type.value }} - {{ supermarket.suburb }}
                            </option>
                        {% endfor %}
                    </select>
                    <input type="hidden" name="current_list" value="{{ shoppingList.id }}">
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>

        </div>
    </div>
</div>
