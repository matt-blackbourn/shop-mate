<script>

// map drawing state
const container = document.getElementById('shoppingListContainer');
const nodesData = JSON.parse(container.dataset.nodes);
const edgesData = JSON.parse(container.dataset.edges);
const shelvesData = JSON.parse(container.dataset.shelves);
const segments = JSON.parse(container.dataset.segments);
const entranceNodeId = container.dataset.entranceNodeId;  
const supermarketId = container.dataset.supermarketId;  
const listId = container.dataset.listId;  
const placementStatuses = JSON.parse(document.getElementById('data').dataset.placementStatus);
const otherPlacementEdgeEls = new Map(); 
const pathEdgeEls = new Map(); 
const SVG_NS = "http://www.w3.org/2000/svg";
const shelfEls = []; // keep refs + geometry
const mapSvg = document.getElementById("map-svg");
const AISLE_WIDTH = container.dataset.aisleWidth

const MAP_MODE_PATH = 'path';
const MAP_MODE_PLACEMENT = 'placement';
let mapRotation = 0;
let currentRotation = 0;
let mapView = false
let mapMode = 'path';


// store original viewBox in SVG units
if (!mapSvg.dataset.originalViewBox) {
    const vb = mapSvg.viewBox.baseVal;
    mapSvg.dataset.originalViewBox = `${vb.x} ${vb.y} ${vb.width} ${vb.height}`;
}

/*
 we loop over edges data a lot of times in this code, it probably needs optimising
*/
const currentItemState = {
    itemId: null,
    name: null,
    quantity: null,
    notes: null,
};

// other state
let processingQueue = false;
let pickQueueTimer = null;
const pickQueue = [];
const placementState = {
    supermarketId: supermarketId,
    listId: listId,
    foodItemId: null,
    edgeId: null,
    aisleSide: null,
    currentNodeId: null,
};

// build a lookup for nodes and draw entrance node
const nodes = {};
nodesData.forEach(n => {
    if (n.id == entranceNodeId) {
        drawEntranceArrow(n);
    }
    nodes[n.id] = n;
});

// Draw edges (path display)
edgesData.forEach(e => {
    const from = nodes[e.from];
    const to   = nodes[e.to];
    const layer = getLayer('map-svg', 'edges-layer');

    // invisible edges - only visible with styles added
    const line = document.createElementNS(SVG_NS, 'line');
    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('path-edge');
    line.dataset.edgeId = e.id;

    e.el = line; // Keep this for later (used in path map to highlight same-edge placements) - might be able to use it for more things

    layer.appendChild(line);
});

const edgeByNodes = new Map();
edgesData.forEach(edge => {
    const el = document.querySelector(`[data-edge-id="${edge.id}"]`);
    if (!el) {
        return;
    }

    edgeByNodes.set(`${edge.from}->${edge.to}`, {
        ...edge,
        el
    });

    edgeByNodes.set(`${edge.to}->${edge.from}`, {
        ...edge,
        el
    });
});

// 2. Build routeState
const mappedSegments = segments.filter(s => s.placementEdgeId !== null);
const unmappedSegments = segments.filter(s => s.placementEdgeId === null);
const routeState = {
    segments: [
        ...mappedSegments,
        ...unmappedSegments // appended AFTER mapped
    ].map(s => ({
        ...s,
        edges: []
    })),
    currentSegment: 0,
    pickedItemIds: new Set(),
    currentItem: {
        itemId: null,
        name: null,
        quantity: null,
        notes: null,
    },
};


// 3. Resolve segment edges
routeState.segments.forEach(segment => {
    segment.edges = resolveEdgesForSegment(segment);
});

// Initial setup
drawShelves(shelvesData)
updateMapView();
setMapMode(MAP_MODE_PATH);

document.getElementById('placeItemBtn').addEventListener('click', () => {
    setMapMode(MAP_MODE_PLACEMENT);
});

document.getElementById('placementCancelBtn').addEventListener('click', () => {
    if(mapView){
        setMapMode(MAP_MODE_PATH);
    } else {
        const modalEl = document.getElementById('mapModal');
        const modal = bootstrap.Modal.getInstance(modalEl);
        modal.hide();
    }
});

function setMapMode(mode) {
    mapMode = mode;

    const placementInstructions = document.getElementById('placementInstructions'); // currently blank
    const placementConfirmBtn = document.getElementById('placementConfirmBtn');
    const placementCancelBtn = document.getElementById('placementCancelBtn');
    const mapBackBtn = document.getElementById('mapBackBtn');
    const foodInfo = document.getElementById('foodInfo');
    const placeItemBtn = document.getElementById('placeItemBtn');
    const skipBtn = document.getElementById('skip-item-map');
    const pickBtn = document.getElementById('pick-item-map');
    const entranceLayer = document.getElementById('entrance-layer');
    const edgesLayer = document.getElementById('edges-layer');


    if (mode === MAP_MODE_PLACEMENT) {
        // show these
        placementInstructions.classList.remove('d-none');
        placementConfirmBtn.classList.remove('d-none');
        placementCancelBtn.classList.remove('d-none');
        entranceLayer.classList.remove('d-none');

        // hide these
        mapBackBtn.classList.add('d-none');
        skipBtn.classList.add('d-none');
        pickBtn.classList.add('d-none');
        foodInfo.classList.add('d-none');
        placeItemBtn.classList.add('d-none');
        edgesLayer.classList.add('d-none');

        clearShelfHighlights()

    } else {
        // hide these
        placementInstructions.classList.add('d-none');
        placementConfirmBtn.classList.add('d-none');
        placementCancelBtn.classList.add('d-none');
        entranceLayer.classList.add('d-none');

        // show these
        mapBackBtn.classList.remove('d-none');
        skipBtn.classList.remove('d-none');
        pickBtn.classList.remove('d-none');
        foodInfo.classList.remove('d-none');
        placeItemBtn.classList.remove('d-none');
        edgesLayer.classList.remove('d-none');

        highlightItemOnMap() // reset current placement highlight
    }

}


document.getElementById('rotate').addEventListener('click', () => {
    rotate180()
});

function setRotation(deg) {
    const mapInner = document.getElementById('map-inner');
    const vb = mapSvg.viewBox.baseVal;
    const cx = vb.x + vb.width / 2;
    const cy = vb.y + vb.height / 2;

    mapInner.setAttribute('transform', `rotate(${deg} ${cx} ${cy})`);
}

function rotate180(){
    const newRotation = (mapRotation + 180) % 360;

    const target = shortestAngle(currentRotation, newRotation);
    animateRotation(currentRotation, target, 600);

    mapRotation = newRotation;
    currentRotation = target;
}

function rotateMap(){
    setTimeout(() => {
        const newRotation = findRotationForNextItem();
        if (newRotation === null) return;

        const target = shortestAngle(currentRotation, newRotation);

        const vb = mapSvg.viewBox.baseVal;
        const width = vb.width;
        const height = vb.height;

        const start = { x: vb.x, y: vb.y, width: vb.width, height: vb.height };

        const isLandscape = newRotation === 90 || newRotation === 270;

        let end;

        if (isLandscape) {
            const segment = routeState.segments[routeState.currentSegment];
            const nodeB = nodes[segment.pathNodes[segment.pathNodes.length - 1]];

            end = {
                x: nodeB.x - width / 2,
                y: nodeB.y - height / 2,
                width,
                height
            };
        } else {
            const parts = mapSvg.dataset.originalViewBox.split(' ').map(Number);
            end = { x: parts[0], y: parts[1], width: parts[2], height: parts[3] };
        }

        // ✅ animate BOTH once
        animateRotation(currentRotation, target, 600);
        animateViewBox(mapSvg, start, end, 600);

        // ✅ update AFTER triggering animation
        currentRotation = target;
        mapRotation = newRotation;

    }, 500);
}

function shortestAngle(from, to) {
    let diff = (to - from) % 360;
    if (diff > 180) diff -= 360;
    if (diff < -180) diff += 360;
    return from + diff;
}

function animateRotation(from, to, duration = 600) {
    const startTime = performance.now();

    function step(now) {
        const t = Math.min(1, (now - startTime) / duration);

        // ease (same idea as you'd want visually)
        const eased = t < 0.5
            ? 2 * t * t
            : 1 - Math.pow(-2 * t + 2, 2) / 2;

        const current = from + (to - from) * eased;

        setRotation(current);

        if (t < 1) requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
}

function findRotationForNextItem(){
    const segment = routeState.segments[routeState.currentSegment];
    if(!segment){
        return null
    }

    const nodeA = nodes[segment.pathNodes[segment.pathNodes.length - 2]]; //  second last node in path
    const nodeB = nodes[segment.pathNodes[segment.pathNodes.length - 1]]; //  second last node in path

    // Skip map rotation/movement if no path nodes (same-edge placements)
    if(!nodeA || !nodeB){
        return null
    }

    // Compute the desired orientation from the edge
    const ax = nodeA.x;
    const bx = nodeB.x;
    const ay = nodeA.y;
    const by = nodeB.y;

    const dx = bx - ax;
    const dy = by - ay;
    const angle = Math.atan2(dy, dx) * 180 / Math.PI;

    // make edge face upward
    let targetRotation = -90 - angle;

    //Normalize the target to 0–360
    targetRotation = (targetRotation + 360) % 360;

    //Rotate the shortest direction
    let delta = targetRotation - mapRotation;
    if (delta > 180) delta -= 360;
    if (delta < -180) delta += 360;
    mapRotation += delta;

    return mapRotation;
}

function updateMapView() {
