<div class="modal fade map-modal" id="pathModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div class="modal-title">
                    <div class="title">
                        <span id="modalItemName" class="title"></span>
                        <span id="modalItemQty" class="app-muted"></span>
                    </div>

                    <div id="modalItemNotes" class="notes app-muted"></div>
                </div>

                <button id="pick" class="pick-skip" type="button">Picked</button>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="path-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="path-edges-layer"></g>
                        <g id="path-entrance-layer"></g>
                    </svg>
                </div>
            </div>

            <div class="modal-footer">
                <button id="skip-item" class="btn btn-secondary" type="button">Skip Item</button>
                <button type="button" id="pathCancelBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>


<style>
/* Base route styling */
.path-edge.route-upcoming,
.path-edge.route-active,
.path-edge.route-complete {
    stroke-width: 6;              /* thicker line */
    stroke-dasharray: 40 20;      /* long dash, clear gap */
    transition: stroke 200ms ease, opacity 200ms ease;
}

.path-edge.route-complete {
    stroke: #64748b;        /* slate-500 */
    opacity: 0.7;
    stroke-width: 4;
}

/* Active (warm, obvious) */
.path-edge.route-active {
    stroke: #f59e0b;        /* amber-500 */
    opacity: 1;
    stroke-width: 7;
    drop-shadow(0 0 8px rgba(245, 158, 11, 0.65))
    stroke-dasharray: 60 0; /* solid */
    animation: pulse 1s infinite;
}

/* Upcoming (same hue, hint only) */
.path-edge.route-upcoming {
    stroke: #f59e0b;
    opacity: 0.4;
    stroke-width: 4;
}

@keyframes pulse {
    0%   { stroke-width: 8;  opacity: 0.7; }
    50%  { stroke-width: 12; opacity: 1; }
    100% { stroke-width: 8;  opacity: 0.7; }
}

.location-side {
    fill: #f59e0b80
}

</style>
