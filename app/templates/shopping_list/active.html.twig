function onShelfClicked(shelf, click) {
    console.log(shelf)
    const edges = edgesNextToShelf(shelf, click);
    console.log(edges)
    if (!edges.length) return;

    let index = 0;
    // if user clicked same shelf again, cycle to next edge
    //  % edges.length loops back to the first edge after reaching the end of the list
    if (lastShelfSelection.shelfId === shelf.id) {
        index = (lastShelfSelection.edgeIndex + 1) % edges.length;
    }

    const edge = edges[index];
    const aisleSide = aisleSideForShelf(shelf, edge);

    // update last selection for toggling
    lastShelfSelection = {
        shelfId: shelf.id,
        edgeIndex: index
    };

    // existing logic you already have
