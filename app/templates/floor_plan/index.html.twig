{% extends 'base.html.twig' %}

{% block title %}FloorPlan index{% endblock %}

{% block body %}
    <h1>FloorPlan index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>RawData</th>
                <th>Suburb</th>
                <th>DateCreated</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for floor_plan in floor_plans %}
            <tr>
                <td>{{ floor_plan.id }}</td>
                <td>{{ floor_plan.rawData ? floor_plan.rawData|json_encode : '' }}</td>
                <td>{{ floor_plan.suburb }}</td>
                <td>{{ floor_plan.dateCreated ? floor_plan.dateCreated|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ floor_plan.type }}</td>
                <td>
                    <a href="{{ path('app_floor_plan_show', {'id': floor_plan.id}) }}">show</a>
                    <a href="{{ path('app_floor_plan_edit', {'id': floor_plan.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_floor_plan_new') }}">Create new</a>
{% endblock %}
