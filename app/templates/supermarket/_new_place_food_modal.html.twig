<div class="modal fade map-modal" id="placementModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h6 class="modal-title">
                    Tap the shelf this item belongs in. </br>
                    Tap again to change sides.
                </h6>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="placement-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="placement-edges-layer"></g>
                        <g id="placement-entrance-layer"></g>
                    </svg>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="placementCancelBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="placementForm" id="placementConfirmBtn" class="btn btn-primary" disabled>Save placement</button>
            </div>
            <form method="POST" action="/placement/save" id="placementForm">
                <input type="hidden" name="placement" id="placementPayload">
            </form>

        </div>
    </div>
</div>
