<div class="modal fade" id="selectSupermarketModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Select Supermarket</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="supermarketForm">
          {% for supermarket in supermarkets %}
            <div class="form-check">
              <input
                class="form-check-input"
                type="radio"
                name="supermarketId"
                id="supermarket-{{ supermarket.id }}"
                value="{{ supermarket.id }}"
                {% if supermarket.id == lastUsedSupermarketId %} checked {% endif %}
              >
              <label class="form-check-label" for="supermarket-{{ supermarket.id }}">
                {{ supermarket.name }}
              </label>
            </div>
          {% endfor %}
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirm-supermarket-btn" class="btn btn-success">Start shopping</button>
      </div>
    </div>
  </div>
</div>
