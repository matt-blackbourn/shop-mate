
{% if form is defined and form %}
<div class="modal fade" tabindex="-1" id="groupItemModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Place with a similar item</h5>
                <button type="button" class="btn" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg text-white"></i>
                </button>
            </div>

            {{ form_start(form) }}

                <div class="modal-body">

                    <div class="mb-3">
                        {{ form_label(form.groupWithItem) }}
                        {{ form_widget(form.groupWithItem) }}
                        {{ form_errors(form.groupWithItem) }}
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="cancel-btn" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" id="groupSubmit" class="confirm-btn">
                        Confirm
                    </button>
                </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>

<style>

/* Modal background/content */
#groupItemModal .modal-content {
    background-color: #0f1115;
    color: #e9ecef;
    border: 1px solid #1f2430;
}

/* Modal header */
#groupItemModal .modal-header {
    background-color: #121520;
    border-bottom: 1px solid #1f2430;
}

#groupItemModal .modal-title {
    color: #f1f3f5;
}

/* Modal body */
#groupItemModal .modal-body {
    background-color: #0f1115;
    padding: 1rem;
}

/* Form radio labels */
#groupItemModal .form-check-label {
    color: #e9ecef;
}

#groupItemModal .form-check-input:checked + .form-check-label {
    color: #51cf66; /* accent for checked selection */
}

/* Modal footer */
#groupItemModal .modal-footer {
    background-color: #121520;
    border-top: 1px solid #1f2430;
}

/* Cancel button */
.cancel-btn {
    background-color: #2b303b;
    border: 1px solid #2b303b;
    color: #f1f3f5;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}

.cancel-btn:hover {
    background-color: #343a46;
}

/* Confirm button */
.confirm-btn {
    background-color: #51cf66;
    border: 1px solid #51cf66;
    color: #0b0d12;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}

/* Header TomSelect variant */
#groupItemModal .ts-wrapper.single .ts-control {
    background-color: #1c212b;   /* match header */
    color: #e9ecef;
    border: 1px solid #343a46;
}

/* Input text */
#groupItemModal .ts-wrapper.single .ts-control input {
    background-color: transparent;
    color: #e9ecef;
}

/* Dropdown */
#groupItemModal .ts-dropdown {
    background-color: #2b303b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

/* Dropdown options */
#groupItemModal .ts-dropdown .ts-dropdown-option {
    color: #e9ecef;
}

/* Active option */
#groupItemModal .ts-dropdown .active,
#groupItemModal .ts-dropdown .active.create {
    background-color: #343a46;
    color: #e9ecef;
}
#groupItemModal .ts-control input::placeholder {
    color:rgb(128, 128, 128);      /* light gray for dark bg */
}

</style>

<script>

document.addEventListener('DOMContentLoaded', function () {
    new TomSelect('#{{ form.groupWithItem.vars.id }}', {
        create: false,
        sortField: { field: "text", direction: "asc" },
        openOnFocus: false,       // keep closed on focus
    });
});

document.getElementById('groupItemModal').addEventListener('shown.bs.modal', function () {
    const select = document.getElementById('{{ form.groupWithItem.vars.id }}');
    if (select.tomselect) {
        select.tomselect.focus();
    }
});

</script>

{% endif %}
