{% extends 'base.html.twig' %}

{% block title %}Edit Floor Plan{% endblock %}

{% block body %}
<div class="d-flex flex-column mb-4 border-bottom pb-3">

    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h4 mb-0">{{ floorPlan.type.value }} - {{ floorPlan.suburb }}</h1>
            <a href="{{ path('app_floor_plan_index') }}" class="btn btn-outline-secondary btn-sm">
                ← Back to list
            </a>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label for="snapDistance">Snap Distance:</label>
            <select id="snapDistance">
                <option value="5">5 px</option>
                <option value="10">10 px</option>
                <option value="15">15 px</option>
                <option value="20">20 px</option>
                <option value="30" selected>30 px</option>
                <option value="50">50 px</option>
            </select>
            <span id="node-count" class="badge bg-secondary">0 nodes</span>

            <button id="undo-node" type="button" class="btn btn-outline-secondary btn-sm">
                Undo last node
            </button>

            <form method="POST" action="{{ path('app_floorplan_to_supermarket_save', {'id': floorPlan.id}) }}"
                  id="nodesForm" class="d-flex align-items-center gap-2">
                <input type="hidden" name="nodes" id="nodesInput">
                <button id="save-nodes" type="submit" class="btn btn-primary btn-sm">
                    💾 Save as Supermarket
                </button>
            </form>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-2 mb-0" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<div id="floorplan-wrapper" data-floorplan-id="{{ floorPlan.id }}" data-raw-data="{{ floorPlan.rawData|json_encode|e('html_attr') }}">
    <svg id="overlay" style="border:1px solid #ccc; width:100%; height:100vh;"></svg>
</div>

<style>
    .node { fill: #0d6efd; stroke: #0d6efd; stroke-width: 2; cursor: pointer; }
</style>

<script>
const svg = document.getElementById('overlay');
const nodes = [];
const nodeCountEl = document.getElementById('node-count');
const saveBtn = document.getElementById('save-nodes');
const EDGE_BUFFER = 50; // space around nodes for shelves/aisles
const RENDER_SCALE = 30; // adjust until it feels right

const wrapper = document.getElementById('floorplan-wrapper');
const rawData = JSON.parse(wrapper.dataset.rawData || '{}');
const nodesData = rawData.path || []; // ✅ only the path array

// Shared coordinates for snapping
const sharedX = new Set();
const sharedY = new Set();

let SNAP_DISTANCE = 30;
document.getElementById('snapDistance').addEventListener('change', e => {
    SNAP_DISTANCE = parseInt(e.target.value, 10);
});

// Draw existing nodes and populate array
const visualScale = rawData.visualScale || 1;

// 1️⃣ Convert step coordinates to final coordinates
const scaledPath = nodesData.map(n => ({
    x: n.x * visualScale,
    y: n.y * visualScale
}));

if (scaledPath.length) {

    // 2️⃣ Compute bounds
    const xs = scaledPath.map(n => n.x);
    const ys = scaledPath.map(n => n.y);

    const minX = Math.min(...xs);
    const minY = Math.min(...ys);
    const maxX = Math.max(...xs);
    const maxY = Math.max(...ys);

    const width = maxX - minX;
    const height = maxY - minY;

    // 3️⃣ Normalize so top-left starts at (0,0)
    const normalizedPath = scaledPath.map(n => ({
        x: n.x - minX,
        y: n.y - minY
    }));

    // 4️⃣ Set SVG once to final size (+ optional buffer)
    svg.setAttribute(
        'viewBox',
        `0 0 ${width + EDGE_BUFFER * 2} ${height + EDGE_BUFFER * 2}`
    );

    // 5️⃣ Draw nodes shifted by buffer
    normalizedPath.forEach(n => {
        const x = n.x + EDGE_BUFFER;
        const y = n.y + EDGE_BUFFER;

        const circle = drawNode(x, y);
        nodes.push({ x, y, element: circle });
    });
}

updateNodeCount();


// --- Node creation ---
function drawNode(x, y) {
    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');

    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', 5); // stable visual size

    circle.classList.add('node');
    svg.appendChild(circle);

    return circle;
}

function createNode(x, y) {
    const circle = drawNode(x, y);
    nodes.push({ x, y, element: circle });
    updateNodeCount();
}

// --- Direction locking & snapping ---
let lastNode = null;
let directionLock = null;
const LOCK_THRESHOLD = 6;
let ignoreNextSnapX = false;
let ignoreNextSnapY = false;

svg.addEventListener('click', e => {
    if (e.target.tagName !== 'svg') return;

    const pt = svg.createSVGPoint();
    pt.x = e.clientX; pt.y = e.clientY;
    let { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

    if (lastNode) {
        if (directionLock === 'horizontal') y = lastNode.y;
        if (directionLock === 'vertical') x = lastNode.x;
    }

    ({ x, y } = snapToSharedCoordinates(x, y));
    createNode(x, y);

    if (e.shiftKey) { sharedX.add(x); sharedY.add(y); }

    directionLock = null;
    ignoreNextSnapX = false;
    ignoreNextSnapY = false;
    lastNode = nodes[nodes.length - 1];
});

svg.addEventListener('mousemove', e => {
    if (!lastNode) return;

    const pt = svg.createSVGPoint();
    pt.x = e.clientX; pt.y = e.clientY;
    let { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

    const dx = Math.abs(x - lastNode.x), dy = Math.abs(y - lastNode.y);
    if (!directionLock && (dx > LOCK_THRESHOLD || dy > LOCK_THRESHOLD)) {
        directionLock = dx > dy ? 'horizontal' : 'vertical';
    }

    if (directionLock === 'horizontal') y = lastNode.y;
    if (directionLock === 'vertical') x = lastNode.x;

    if (directionLock !== 'vertical') {
        for (const sy of sharedY) if (Math.abs(y - sy) <= SNAP_DISTANCE) y = sy;
    }
    if (directionLock !== 'horizontal') {
        for (const sx of sharedX) if (Math.abs(x - sx) <= SNAP_DISTANCE) x = sx;
    }
});

document.addEventListener('keydown', e => {
    if (e.key.toLowerCase() === 'x') ignoreNextSnapX = true;
    if (e.key.toLowerCase() === 'y') ignoreNextSnapY = true;
});

// --- Undo ---
document.getElementById('undo-node').addEventListener('click', () => {
    if (!nodes.length) return;
    const last = nodes.pop();
    last.element.remove();
    updateNodeCount();
});

// --- Snapping function ---
function snapToSharedCoordinates(x, y) {
    let sx = x, sy = y;
    if (!ignoreNextSnapX) for (const px of sharedX) if (Math.abs(x - px) <= SNAP_DISTANCE) sx = px;
    if (!ignoreNextSnapY) for (const py of sharedY) if (Math.abs(y - py) <= SNAP_DISTANCE) sy = py;
    return { x: sx, y: sy };
}

// --- Node count update ---
function updateNodeCount() {
    nodeCountEl.textContent = `${nodes.length} nodes`;
    saveBtn.disabled = nodes.length === 0;
}


// --- Form submission ---
const form = document.getElementById('nodesForm');
const nodesInput = document.getElementById('nodesInput');

form.addEventListener('submit', e => {
    nodesInput.value = JSON.stringify({ path: nodes });
});
</script>

{% endblock %}