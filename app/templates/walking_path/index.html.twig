{% extends 'base.html.twig' %}

{% block title %}WalkingPath index{% endblock %}

{% block body %}
    <h1>WalkingPath index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Converted</th>
                <th>Suburb</th>
                <th>DateCreated</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for walkingPath in walkingPaths %}
            <tr>
                <td>{% if walkingPath.converted %}Yes{% else %}No{% endif %}</td>
                <td>{{ walkingPath.suburb }}</td>
                <td>{{ walkingPath.dateCreated ? walkingPath.dateCreated|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ walkingPath.type.value }}</td>
                <td>
                    <a href="{{ path('app_walking_path_nodes', {'id': walkingPath.id}) }}">convert to map</a>
                    | <a href="{{ path('app_walking_path_edit', {'id': walkingPath.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_home') }}">Home</a>
{% endblock %}
