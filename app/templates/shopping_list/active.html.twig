{% extends 'base.html.twig' %}

{% block title %}Shopping{% endblock %}

{% block body %}

<div class="container py-3">

    <!-- Sticky header -->
    <div class="sticky-top bg-white border-bottom z-3">
        <div class="d-flex align-items-center justify-content-between px-2 py-2">

            <!-- Exit shopping -->
            <a href="{{ path('app_home') }}"
               class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span class="d-none d-sm-inline">Done</span>
            </a>

            <!-- Heading -->
            <h1 class="h6 mb-0 text-center flex-grow-1">
                Shopping @ {{ supermarket.name }}
            </h1>

            <!-- Edit list -->
            <a href=""
               class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-pencil"></i>
                <span class="d-none d-sm-inline">Edit</span>
            </a>

        </div>
    </div>

    <!-- Spacer -->
    <div class="sticky-spacer"></div>

    {% if showPlacementHint is defined and showPlacementHint %}
    <div class="alert alert-warning alert-dismissible fade show small" role="alert">
        Some items don’t have locations yet.
        <strong>Long-press</strong> an item or tap <strong>⋯</strong> to add one.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}

    <!-- Shopping items -->
    <div class="shopping-cards">

        {% for listItem in orderedList %}
            <div class="shopping-card" data-id="{{ listItem.id }}" data-placement-status="{{ listItem.placementStatus.value }}">

                <div class="card-header d-flex align-items-start justify-content-between">

                    <!-- LEFT META -->
                    <div class="card-meta">
                         <div class="dots-wrapper">
                            <!-- dots button -->
                            <button class="dots-btn" type="button" aria-label="Item options">
                                ⋯
                            </button>

                            <!-- placement menu (hidden by default) -->
                            <div class="dots-modal">
                                <p class="modal-text"></p>
                                <div class="modal-actions">
                                    <button class="modal-btn primary"></button>
                                    <button class="modal-btn secondary"></button>
                                </div>
                            </div>
                        </div>

                        {# placement indicator #}
                        {% set status = listItem.placementStatus.value %}

                        {% if status in ['system', 'confirmed'] %}
                            <i class="bi bi-check-circle-fill placement-icon confirmed"
                            title="{{ status == 'system' ? 'System placement' : 'Your placement' }}"></i>

                        {% elseif status in ['provisional', 'category'] %}
                            <i class="bi bi-question-circle-fill placement-icon provisional"
                            title="{{ status == 'provisional'
                                ? 'Placed by another user - please confirm'
                                : 'Category-based placement only' }}"></i>

                        {% else %}
                            <i class="bi bi-exclamation-triangle-fill placement-icon missing"
                            title="No location"></i>
                        {% endif %}
                    </div>

                    <!-- MAIN CONTENT -->
                    <div class="card-main">
                        <div class="title">
                            {{ listItem.foodItem.name }}
                            {% if listItem.quantity %}
                                <span class="text-muted">({{ listItem.quantity }})</span>
                            {% endif %}
                        </div>

                        {% if listItem.notes %}
                            <div class="notes small text-muted">
                                {{ listItem.notes }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- PICKED -->
                    <button class="pick-btn" type="button">
                        Picked
                    </button>

                </div>
            </div>
        {% endfor %}
    </div>
</div>


<style>
/* Shopping card container */
.shopping-card {
    background: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,.1);
    user-select: none;        /* prevents text selection */
    -webkit-user-select: none;
    -ms-user-select: none;
    -moz-user-select: none;
    touch-action: pan-y;      /* allows vertical scroll but prevents unwanted drag */
}

/* Card header layout */
.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

/* Left meta (dots + placement indicator) */
.card-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-right: 8px;
    flex-shrink: 0;
}

/* Dots button */
.dots-btn {
    all: unset;
    font-size: 18px;
    line-height: 1;
    color: #999;
    cursor: pointer;
    padding: 4px;
}
.dots-btn:active {
    opacity: 0.6;
}

/* Placement indicator icons */
.placement-icon {
    font-size: 0.9rem;
    margin-right: 6px;
}
.placement-icon.confirmed {
    color: #198754; /* green */
}
.placement-icon.provisional {
    color: #ffc107; /* yellow */
}
.placement-icon.missing {
    color: #dc3545; /* red */
}

/* Picked button */
.pick-btn {
    all: unset;
    display: inline-flex;
    align-items: center;
    font-size: 0.8rem;
    padding: 4px 10px;
    border-radius: 999px;
    background: #e6f4ea;
    color: #1e7e34;
    font-weight: 500;
    min-height: 32px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
}
.pick-btn:active {
    transform: scale(0.96);
    background: #d7eddc;
}

/* Card main title */
.title {
    font-size: 1.1rem;
    font-weight: 600;
    padding-right: 8px;
    flex: 1;
    min-width: 0;              /* allows truncation */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Notes / quantity */
.qty, .notes {
    font-size: .85rem;
    color: #666;
    margin-top: 4px;
}

/* Dots modal (replaces previous dropdown menu) */
.dots-wrapper {
    position: relative;
}
.dots-modal {
    display: none;
    position: absolute;
    top: 100%; /* below the button */
    left: 0;
    background: white;
    border-radius: 12px;
    border: 1px solid #ccc;
    padding: 12px;
    width: 220px;
    box-shadow: 0 4px 12px rgba(0,0,0,.15);
    z-index: 100;
}
.dots-wrapper.active .dots-modal {
    display: block;
}

/* Modal text and actions */
.modal-text {
    font-size: 0.875rem;
    margin-bottom: 10px;
}
.modal-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}
.modal-btn {
    flex: 1 1 auto;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    border: none;
}
.modal-btn.primary {
    background-color: #0d6efd;
    color: white;
}
.modal-btn.secondary {
    background-color: #e2e6ea;
    color: #333;
}g                                               nmmmmmmmmmmmmmmmmmmmnmmmmmmmmmmmmmmmmm un


</style>

<script>
// Pick item function
document.querySelectorAll('.pick-btn').forEach(btn => {
    btn.addEventListener('click', e => {
        const card = e.target.closest('.shopping-card');
        pickItem(card);
    });
});

document.querySelectorAll('.dots-btn').forEach(btn => {
    btn.addEventListener('click', e => {
        e.stopPropagation();
        openPlacementMenu(e.target.closest('.shopping-card'));
    });
});

function openPlacementMenu(card) {
    const wrapper = card.querySelector('.dots-wrapper');
    if (!wrapper) return;

    const modal = wrapper.querySelector('.dots-modal');
    const textEl = modal.querySelector('.modal-text');
    const primaryBtn = modal.querySelector('.modal-btn.primary');
    const secondaryBtn = modal.querySelector('.modal-btn.secondary');

    // read placement status from data attribute or JS variable
    const status = card.dataset.placementStatus; // 'system', 'confirmed', 'provisional', 'category', 'none'

    // reset buttons
    primaryBtn.style.display = 'inline-block';
    secondaryBtn.style.display = 'inline-block';

    switch (status) {
        case 'system':
        case 'confirmed':
            textEl.textContent = "This item has already been placed. Does it belong somewhere else?";
            primaryBtn.textContent = "Place somewhere else";
            secondaryBtn.style.display = 'none'; // optional, only 1 action
            break;
        case 'provisional':
            textEl.textContent = "This item has been placed by another user.";
            primaryBtn.textContent = "Confirm placement";
            secondaryBtn.textContent = "Place somewhere else";
            break;
        case 'category':
            textEl.textContent = "This item is located with other items in this category. Help us place it properly.";
            primaryBtn.textContent = "Place somewhere else";
            secondaryBtn.style.display = 'none';
            break;
        case 'none':
        default:
            textEl.textContent = "We don’t know where this item belongs.";
            primaryBtn.textContent = "Place somewhere";
            secondaryBtn.style.display = 'none';
            break;
    }

    wrapper.classList.add('active');

    // close when clicking outside
    const closeOutside = (e) => {
        if (!wrapper.contains(e.target)) {
            wrapper.classList.remove('active');
            document.removeEventListener('click', closeOutside);
        }
    };
    document.addEventListener('click', closeOutside);

    // wire buttons
    primaryBtn.onclick = () => {
        console.log('Primary action clicked for', card.dataset.id);
        wrapper.classList.remove('active');
        document.removeEventListener('click', closeOutside);
        // TODO: navigate to placement screen or open placement form
    };
    secondaryBtn.onclick = () => {
        console.log('Secondary action clicked for', card.dataset.id);
        wrapper.classList.remove('active');
        document.removeEventListener('click', closeOutside);
        // TODO: navigate to placement screen or open placement form
    };
}



function pickItem(card) {
    if (card.dataset.picking) return;
    card.dataset.picking = '1';

    // Animate immediately
    card.style.transition = 'transform 0.2s ease, opacity 0.2s ease';
    card.style.transform = 'translateX(-120%)';
    card.style.opacity = '0';

    // Remove from DOM after animation
    setTimeout(() => card.remove(), 200);

    // Fire-and-forget request
    fetch(`/shoppinglist/ajax/pick/${card.dataset.id}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/json'
        }
    }).catch(() => {
        // Later: show toast / undo
        console.error('Failed to mark item as picked');
    });
}
</script>
{% endblock %}
