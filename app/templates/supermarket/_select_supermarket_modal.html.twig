<div class="modal fade" id="selectSupermarketModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Select Supermarket</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form id="supermarketForm">
          {% for supermarket in supermarkets %}
            <div class="form-check">
              <input
                class="form-check-input"
                type="radio"
                name="supermarketId"
                id="supermarket-{{ supermarket.id }}"
                value="{{ supermarket.id }}"
                {% if supermarket.id == lastUsedSupermarketId %} checked {% endif %}
              >
              <label class="form-check-label" for="supermarket-{{ supermarket.id }}">
                {{ supermarket.name }}
              </label>
            </div>
          {% endfor %}
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="cancel-btn" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirm-supermarket-btn" class="confirm-btn">Start shopping</button>
      </div>

    </div>
  </div>
</div>
<style>

/* Modal background/content */
#selectSupermarketModal .modal-content {
    background-color: #0f1115;
    color: #e9ecef;
    border: 1px solid #1f2430;
}

/* Modal header */
#selectSupermarketModal .modal-header {
    background-color: #121520;
    border-bottom: 1px solid #1f2430;
}

#selectSupermarketModal .modal-title {
    color: #f1f3f5;
}

/* Close button */
#selectSupermarketModal .btn-close {
    filter: invert(1) opacity(0.8);
}

#selectSupermarketModal .btn-close:hover {
    opacity: 1;
}

/* Modal body */
#selectSupermarketModal .modal-body {
    background-color: #0f1115;
    padding: 1rem;
}

/* Form radio labels */
#selectSupermarketModal .form-check-label {
    color: #e9ecef;
}

#selectSupermarketModal .form-check-input:checked + .form-check-label {
    color: #51cf66; /* accent for checked selection */
}

/* Modal footer */
#selectSupermarketModal .modal-footer {
    background-color: #121520;
    border-top: 1px solid #1f2430;
}

/* Cancel button */
.cancel-btn {
    background-color: #2b303b;
    border: 1px solid #2b303b;
    color: #f1f3f5;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}

.cancel-btn:hover {
    background-color: #343a46;
}

/* Confirm button */
.confirm-btn {
    background-color: #51cf66;
    border: 1px solid #51cf66;
    color: #0b0d12;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}


</style>