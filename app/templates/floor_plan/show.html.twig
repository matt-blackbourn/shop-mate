{% extends 'base.html.twig' %}

{% block title %}FloorPlan{% endblock %}

{% block body %}
    <h1>FloorPlan</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ floor_plan.id }}</td>
            </tr>
            <tr>
                <th>RawData</th>
                <td>{{ floor_plan.rawData ? floor_plan.rawData|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Suburb</th>
                <td>{{ floor_plan.suburb }}</td>
            </tr>
            <tr>
                <th>DateCreated</th>
                <td>{{ floor_plan.dateCreated ? floor_plan.dateCreated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ floor_plan.type }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_floor_plan_index') }}">back to list</a>

    <a href="{{ path('app_floor_plan_edit', {'id': floor_plan.id}) }}">edit</a>

    {{ include('floor_plan/_delete_form.html.twig') }}
{% endblock %}
