{% extends 'base.html.twig' %}

{% block title %}Edit Shopping List{% endblock %}

{% block body %}

<div class="list-page">

    <!-- HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left -->
            <div class="btn-group">
                <button type="button" class="btn-dark-base" data-bs-toggle="dropdown">
                    <i class="bi bi-list-ul"></i>
                </button>
                <ul class="dropdown-menu">
                    <li>
                        <a href="" id="quickAddItems" data-quick-add-items="{{ quickAddItems|json_encode|e('html_attr') }}">Quick-add Items</a>
                    </li>
                    <li>
                        <a href="" id="defaultSupermarket">Set Default Supermarket</a>
                    </li>
                    <li class="desktop-only">
                        <a href="{{ path('app_supermarket_index') }}">Supermarkets</a>
                    </li>
                    <li class="desktop-only">
                        <a href="{{ path('app_walking_path_index') }}">Path Data</a>
                    </li>
                    <li>
                        <a href="{{ path('app_walking_path_new') }}">Store Mapper</a>
                    </li>
                    <li>
                        <a href="" id="defaultList">Set Default List</a>
                    </li>
                    <li>
                        <a href="" id="switchList">Change List</a>
                    </li>
                    <li>
                        <a href="" id="sendInvite">Invite Someone to Your List</a>
                    </li>
                    <li>
                        <a href="{{ path('app_logout') }}">Logout</a>
                    </li>
                </ul>
            </div>

            <!-- Center -->
            <div class="flex-grow-1 d-flex justify-content-center">
                {{ shoppingList.owner.username }}
            </div>

            <!-- Right -->
            <div class="d-flex align-items-center">
                <a href="" id="trolleyButton" class="btn-dark-base border-green">
                    <i class="bi bi-cart-fill"></i>
                </a>
            </div>
        </div>
    </div>

    {# Flash messages #}
    <div class="flash-container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible mt-2 mb-0" role="alert" data-auto-fade="{{ label == 'success' ? '1' : '0' }}">
                {{ message|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    </div>

    <!-- BODY -->
    <div class="page-body flex-grow-1 overflow-auto px-2 pt-2">
        {{ form_start(form) }}

        <div
            id="listItems"
            class="d-flex flex-column gap-2"
            data-prototype="{{ form_widget(form.listItems.vars.prototype)|e('html_attr') }}"
        >
            {% for itemForm in form.listItems %}
                <div class="card list-item collapsed">
                    <div class="card-body p-2">

                        <!-- Header -->
                        <div class="d-flex align-items-center justify-content-between item-header">
                            <div class="fw-semibold food-label">
                                <span class="label-name">New item</span><span class="label-qty"></span><span class="label-notes"></span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn-dark-base btn-compact remove-item">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Collapsible body -->
                        <div class="item-body mt-2">
                            {{ form_widget(itemForm.foodItem, { attr: { class: 'form-select form-select-sm food-select' } }) }}

                            <div class="d-flex align-items-center gap-2 mt-2">

                                <!-- Notes -->
                                <div class="flex-grow-1">
                                    {{ form_widget(itemForm.notes, {
                                        attr: {
                                            class: 'form-control form-control-sm notes-input',
                                            placeholder: 'Notes'
                                        }
                                    }) }}
                                </div>

                                <!-- Quantity controls -->
                                <div class="d-flex align-items-center gap-1 qty-control">
                                    <button type="button" class="qty-down btn-dark-base btn-compact">−</button>

                                    <span class="fw-semibold qty-display px-2">
                                        {{ itemForm.quantity.vars.value ?? 1 }}
                                    </span>

                                    {{ form_widget(itemForm.quantity, {
                                        attr: { class: 'd-none quantity-input', value: itemForm.quantity.vars.value ?? 1 }
                                    }) }}

                                    <button type="button" class="qty-up btn-dark-base btn-compact">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% do form.listItems.setRendered %}
        </div>
        {{ form_end(form) }}

    </div>



    <!-- FOOTER -->
    <div class="page-footer">
        <div class="d-flex gap-2 p-2">

            <button type="button" id="add-item" class="flex-grow-1 btn-dark-base border-green">
                <i class="bi bi-plus"></i>
                Add item
            </button>

            <button type="button" id="save-list" disabled>
                <i class="bi bi-check-lg"></i>
            </button>

            <button type="button" id="refresh-page" class="btn-dark-base">
                <i class="bi bi-arrow-clockwise"></i>
            </button>

        </div>
    </div>


</div>

