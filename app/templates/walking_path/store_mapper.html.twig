{% extends 'base.html.twig' %}

{% block title %}Store Mapper{% endblock %}

{% block body %}

<div class="mapper-page d-flex flex-column">

    <!-- HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100 gap-2">

            <!-- Left: Menu -->
            <div class="header-left d-flex align-items-center">
                <button id="menu-button" aria-label="Open menu" class="btn-dark-base" ><i class="bi bi-list-ul"></i></button>
            </div>

            <div class="header-center flex-grow-1 text-center fw-semibold">
                <div class="mapper-display"><span id="stepDisplay">0</span></div>
            </div>

            <div class="btn-group">
                <button type="button" id="legAction" class="btn-dark-base" data-bs-toggle="dropdown">
                    <i class="bi bi-floppy"></i>
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" id="saveLeg">Save Last Leg</a></li>
                    <li><a class="dropdown-item" href="#" id="addWaypoint">Add Waypoint</a></li>
                    <li><a class="dropdown-item" href="#" id="saveSupermarket" data-bs-toggle="modal" data-bs-target="#walkingPathModal">Submit Floor Plan</a></li>
                </ul>
            </div>
       
            <button type="button" id="returnToWaypoint" class="btn-dark-base">
                <i class="bi bi-geo-alt-fill"></i>
            </button>
            <button type="button" id="repeatLeg" class="btn-dark-base">
                <i class="bi bi-repeat"></i>
            </button>
        </div>
    </div>

    <!-- MENU (outside header for z-index safety) -->
    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close">×</button>
        <ul>
            <li><a href="{{ path('app_home') }}">Back to List</a></li>
            <li><button type="button" id="clearSession">Clear Session</button></li>
        </ul>
    </nav>

    <!-- BODY (MAP) -->
    <div class="page-body">
        <div class="mapper-map-container">
            <svg class="mapper-svg"></svg>
            <div id="overlayMessage" class="overlay-message"></div>
        </div>
    </div>

    <!-- FOOTER (NUMBERPAD CONTROLS) -->
    <div class="mapper-footer">

        <div class="mapper-actions">
            <button class="btn-dark-base border-yellow" data-direction="left"><i class="bi bi-arrow-left"></i></i></i></button>
            <button class="btn-dark-base border-yellow" data-direction="right"><i class="bi bi-arrow-right"></i></i></i></button>
            <button class="btn-dark-base border-green">Enter</button>
        </div>

        <!-- Number Pad -->
        <div class="mapper-numpad">
            {% for n in [1,2,3,4,5,6,7,8,9] %}
                <button class="btn-dark-base" data-number="{{ n }}">{{ n }}</button>
            {% endfor %}
            <button class="btn-dark-base">⌫</button>
            <button class="btn-dark-base" data-number="0">0</button>
            <button id="undo" type="button" class="btn-dark-base"><i class="bi bi-arrow-counterclockwise"></i></button>

        </div>

    </div>

</div>

{# Modal form for submission #}
<div class="modal fade" id="walkingPathModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="walkingPathForm">
                <div class="modal-header">
                    <h5 class="modal-title">Submit Floor Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                {{ form_start(form) }}
                <div class="modal-body">
                    {{ form_row(form.supermarketType) }}
                    {{ form_row(form.suburb) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                {{ form_end(form) }}
            </form>
        </div>
    </div>
</div>

<style>
#phaseDescription {
    white-space: pre-line;
}

.mapper-page {
    height: 100dvh;   /* important for mobile */
    background: #1c212b;
    color: #e9ecef;
    display: flex;
    flex-direction: column;
}

/* HEADER */
.page-header {
    background-color: #2b303b;
    border-bottom: 1px solid #343a46;
    position: sticky;
    top: 0;
    z-index: 1030;
}

.header-btn {
    background: #1c212b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

.header-btn:hover {
    background: #343a46;
}

/* BODY */
.page-body {
    flex: 1;
    min-height: 0;      /* CRITICAL */
    overflow: hidden;
    position: relative;
}

.mapper-map-container {
    position: absolute;
    inset: 0;
}

.mapper-svg {
    width: 100%;
    height: 100%;
}

.mapper-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    transform-origin: 50% 50%;
    pointer-events: none;
}

/* FOOTER */
.mapper-footer {
    background: #2b303b;
    border-top: 1px solid #343a46;

    height: 30dvh;          /* 👈 controlled size */
    max-height: 420px;      /* safety cap for large phones */

    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
}

/* Display */
.mapper-display {
    background: #11151c;
    border: 1px solid #343a46;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 18px;
    text-align: right;
    font-weight: bold;

    display: flex;
    justify-content: center;
    text-align: center;
    color: 'white';

    width: 100%;
    height: 100%;
}

.mapper-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    align-items: stretch;
}


/* Numpad */
.mapper-numpad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 1fr); /* force 4 even rows */
    gap: 6px;
    flex: 1;  
}


/* temporary highlight state */
.btn-dark-base.clicked {
    background-color: #fab005; /* yellow highlight */
    color: #000;               /* optional text color change */
}

.mapper-svg {
    transition: transform 1s ease;
}

.arrow-line, .arrow-tip {
    stroke: white;
    fill: white;
}

.normal-path {
    stroke: #fab005; 
    fill: #fab005; 
}
.repeat-path {
    stroke: white; 
    fill: white; 
}
.overlay-message {
    position: fixed;
    top: 10%;
    left: 50%;
    transform: translate(-50%, 10px);
    
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid transparent; /* default */
    
    font-size: 14px;
    pointer-events: none;

    opacity: 0;
    transition: opacity 0.5s ease;

    z-index: 9999; /* 🔥 important */
}

.overlay-message.show {
    opacity: 1;
    transform: translate(-50%, 10px);
}

/* states */
.overlay-message.success {
    border-color: #51cf66; /* green */
}

.overlay-message.error {
    border-color: #ff6b6b; /* red */
}

/* Dark mode dropdown */
.btn-group .dropdown-menu {
    background-color: #1f1f1f; /* dark background */
    border: 1px solid #333;    /* optional border */
}

.btn-group .dropdown-item {
    color: #f8f9fa;            /* light text */
}

.btn-group .dropdown-item:hover,
.btn-group .dropdown-item:focus {
    background-color: #333;    /* highlight on hover/focus */
    color: #fff;
}

/* Optional: active state if needed */
.btn-group .dropdown-item.active {
    background-color: #444;
    color: #fff;
}

</style>

<script>
(function() {

    const SVG_NS = "http://www.w3.org/2000/svg";
    const svg = document.querySelector('.mapper-svg');
    const pathLayer = document.createElementNS(SVG_NS, 'g');
    pathLayer.classList.add('path-layer');
    svg.appendChild(pathLayer);
    svg.setAttribute('viewBox', '-150 -150 300 300');

    const stepDisplay = document.getElementById('stepDisplay');
    const footer = document.querySelector('.mapper-footer');
    const saveBtn = document.getElementById('save-map');
    let VISUAL_SCALE = 20; // We need this because the screen uses svg units, which are tiny. This increases the size of the rendered path without affecting the underlying coordinate system used for calculations

    const TYPE_NORMAL = 1;
    const TYPE_REPEAT = 2;
    const TYPE_RETURN = 3;

    let directionArrow; // persistent arrow group
    let mapRotation = 0;
    let stepsBuffer = '';
    let path = [{ x: 0, y: 0, steps: 0, type: TYPE_NORMAL }]
    let headings = [0];
    let currentHeading = 0;
    let hasChanges = false;
    let rotateTimer = null;
    let savedLeg = null;
    let waypoints = [];
    let currentWaypointIndex = 0;
    let cycleWaypoints = true

    createDirectionArrow();

    document.addEventListener('DOMContentLoaded', () => {
        restoreFromLocalStorage();
    });

    document.querySelector('#clearSession').addEventListener('click', clearMappingSession);

    // button highlight on click (temporary visual feedback)
    document.querySelectorAll('.btn-dark-base').forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.add('clicked');
            setTimeout(() => btn.classList.remove('clicked'), 50);
        });
    });

    let overlayTimer;
    function showOverlayMessage(text, type = 'success') {
        const el = document.getElementById('overlayMessage');

        // reset previous state
        el.classList.remove('success', 'error');

        // apply new state
        el.classList.add(type);
        el.textContent = text;
        el.classList.add('show');

        clearTimeout(overlayTimer);

        overlayTimer = setTimeout(() => {
            el.classList.remove('show');
        }, 2000);
    }

    document.getElementById('undo').addEventListener('click', undoLeg);
    document.getElementById('saveLeg').addEventListener('click', saveLastLeg)
    document.getElementById('repeatLeg').addEventListener('click', reapplySavedLeg)
    document.getElementById('addWaypoint').addEventListener('click', addWaypoint)
    document.getElementById('returnToWaypoint').addEventListener('click', returnToLastWaypoint)

    function saveLastLeg() {
        if (path.length < 2) return;

        const a = path[path.length - 2];
        const b = path[path.length - 1];

        savedLeg = {
            dx: b.x - a.x,
            dy: b.y - a.y,
            steps: b.steps // ✅ leg length directly
        };

        showOverlayMessage(`Leg saved: ${savedLeg.steps} steps`);
    }

    function reapplySavedLeg() {
        if (!savedLeg){
            showOverlayMessage('Save a leg first!', 'error');
            return;
        }

        const current = path[path.length - 1];

        // --- go opposite direction ---
        const outPoint = {
            x: current.x - savedLeg.dx,
            y: current.y - savedLeg.dy,
            steps: savedLeg.steps,
            type: 2
        };

        path.push(outPoint);

        // --- come back ---
        const returnPoint = {
            x: outPoint.x + savedLeg.dx,
            y: outPoint.y + savedLeg.dy,
            steps: savedLeg.steps,
            type: 3
        };

        path.push(returnPoint);
        drawPath();
    }

    function addWaypoint() {
        if (!path.length) return;

        const last = path[path.length - 1]; // endpoint of current path

        // Add new waypoint
        waypoints.push({
            x: last.x,
            y: last.y
        });

        // Make this the current waypoint for cycling
        currentWaypointIndex = waypoints.length - 1;

        // Tag the last path point with the waypoint index
        last.waypointIndex = currentWaypointIndex;

        saveToLocalStorage()
        drawPath();
        showOverlayMessage(`Waypoint ${waypoints.length} saved!`, 'success');
    }

    function returnToLastWaypoint() {
        if (!waypoints.length) {
            showOverlayMessage(`No waypoints saved!`,'error');
            return;
        }

        // If last leg is already a return, overwrite it
        const last = path[path.length - 1];
        if (last && last.type === TYPE_RETURN) {
            path.pop();
        }

        // Once we reach the end of the waypoints list, we go back to the last position in the path 
        if(!cycleWaypoints){
            path.push({
                x: path[path.length-1].x,
                y: path[path.length-1].y,
                steps: 0,
                type: TYPE_RETURN,
            });

            cycleWaypoints = true
            updateDirectionArrow();
            drawPath();
            showOverlayMessage(`Back at last known location`, 'success');

            return
        }

        // Decrement currentWaypointIndex for reverse cycling
        // Wrap around to the last waypoint if we go below 0
        currentWaypointIndex = (currentWaypointIndex - 1 + waypoints.length) % waypoints.length;

        // Push new return leg
        const waypoint = waypoints[currentWaypointIndex];
        path.push({
            x: waypoint.x,
            y: waypoint.y,
            steps: 0,
            type: TYPE_RETURN,
        });

        if(currentWaypointIndex === 0){
            cycleWaypoints = false;
        }

        updateDirectionArrow();
        drawPath();
        showOverlayMessage( `Returned to waypoint ${currentWaypointIndex + 1}`, 'success');
    }

    function createDirectionArrow() {
        directionArrow = document.createElementNS(SVG_NS, 'g');
        directionArrow.classList.add('direction-arrow');

        // Arrow line
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', 0);
        line.setAttribute('y1', 0);
        line.setAttribute('x2', 10); // initial length, will be scaled
        line.setAttribute('y2', 0);
        
        line.setAttribute('stroke-width', 1);
        line.classList.add('arrow-line');

        // Arrow tip
        const tip = document.createElementNS(SVG_NS, 'path');
        tip.setAttribute('d', `M0 -4 L8 0 L0 4 Z`); // initial tip
        tip.classList.add('arrow-tip');
        tip.setAttribute('transform', `translate(25,0)`);

        directionArrow.appendChild(line);
        directionArrow.appendChild(tip);

        svg.appendChild(directionArrow);

        // initial positioning
        updateDirectionArrow();
    }

    function updateDirectionArrow() {
        const last = path[path.length - 1];
        if (!directionArrow || !path.length) return;

        const angleDeg = currentHeading * (180 / Math.PI);

        // update transform (position & rotation)
        directionArrow.setAttribute(
            'transform',
            `translate(${last.x * VISUAL_SCALE}, ${last.y * VISUAL_SCALE}) rotate(${angleDeg - 90})`
        );

        // --- scale visuals ---
        const line = directionArrow.querySelector('.arrow-line');
        const tip = directionArrow.querySelector('.arrow-tip');

        // derive a stable scale from viewport instead
        const viewBox = svg.viewBox.baseVal;
        const screenScale = Math.min(viewBox.width, viewBox.height);
        const scale = clamp(screenScale / 300, 0.8, 2.5);

        // Line length can be proportional to VISUAL_SCALE
        const lineLength = 20 * scale;
        line.setAttribute('x2', lineLength);
        line.setAttribute('stroke-width', clamp(VISUAL_SCALE / 5, 2, 8));

        const tipWidth = 8 * scale;
        const tipHeight = 4 * scale;
        tip.setAttribute('d', `M0 ${-tipHeight} L${tipWidth} 0 L0 ${tipHeight} Z`);
        tip.setAttribute('transform', `translate(${lineLength},0)`);
    }

    function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
    }


    // Handle modal form submission
    document.getElementById('walkingPathForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const payload = {
            supermarketType: document.querySelector('#walking_path_supermarketType').value,
            suburb: document.querySelector('#walking_path_suburb').value,
            rawData: JSON.parse(localStorage.getItem('storeMapping') || '{}'),
        };

        try {
            const response = await fetch('/walkingpath/save', { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => null);
                const message = errorData?.error || 'Submission failed';
                throw new Error(message);
            }

            // Only clear localStorage on success
            localStorage.removeItem('storeMapping');

            alert('Path data submitted successfully!');
            window.location.href = '/';

        } catch (err) {

            console.error('Submission error message:', err.message);
            alert('Submission failed — your progress is still saved offline.');
        }
    });
    
    function updateDisplay() {
        stepDisplay.textContent = stepsBuffer || '0';
    }

    function rotateMap() {
        clearTimeout(rotateTimer);

        rotateTimer = setTimeout(() => {
            const headingDeg = currentHeading * 180 / Math.PI;
            const baseRotation = getBaseRotation();

            // Snap heading to 180°
            const snappedHeading = Math.round(headingDeg / 180) * 180;
            let targetRotation = baseRotation - snappedHeading;
            targetRotation = normalizeAngle(targetRotation);

            // Smooth shortest-path rotation (max ±180)
            let delta = normalizeAngle(targetRotation - mapRotation);
            mapRotation += delta;

            svg.style.transform = `rotate(${mapRotation}deg)`;
            svg.style.transformOrigin = "center center";

            updateViewBox();
        }, 200);
    }

    function normalizeAngle(angle) {
        return ((angle % 360) + 540) % 360 - 180;
    }

    function getBaseRotation() {
        const { width, height } = getPathAspect();

        // If wider than tall → rotate base by 90°
        if (width > height) {
            return 90; // or 270 depending on preference
        }

        return 0;
    }

    function getPathAspect() {
        let minX = path[0].x;
        let maxX = path[0].x;
        let minY = path[0].y;
        let maxY = path[0].y;

        for (let p of path) {
            minX = Math.min(minX, p.x);
            maxX = Math.max(maxX, p.x);
            minY = Math.min(minY, p.y);
            maxY = Math.max(maxY, p.y);
        }

        return {
            width: maxX - minX,
            height: maxY - minY
        };
    }


    function getLineClass(lineType) {
        switch(lineType) {
            case TYPE_NORMAL: return 'normal-path';
            case TYPE_REPEAT: return 'repeat-path';
            case TYPE_RETURN: return '';
            default: return 'normal-path';
        }
    }

    function drawPath() {
        pathLayer.innerHTML = '';

        for (let i = 1; i < path.length; i++) {
            const p1 = path[i - 1];
            const p2 = path[i];

            // 🔥 Apply visual scale HERE (not in stored data)
            const x1 = p1.x * VISUAL_SCALE;
            const y1 = p1.y * VISUAL_SCALE;
            const x2 = p2.x * VISUAL_SCALE;
            const y2 = p2.y * VISUAL_SCALE;

            const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute('x1', x1);
            line.setAttribute('y1', y1);
            line.setAttribute('x2', x2);
            line.setAttribute('y2', y2);
            line.setAttribute('stroke-width', Math.max(1, VISUAL_SCALE / 10));
            line.setAttribute('class', getLineClass(p2.type));

            const dashLength = Math.max(1, VISUAL_SCALE / 5);
            const gapLength = Math.max(1, VISUAL_SCALE / 5);
            line.setAttribute('stroke-dasharray', `${dashLength} ${gapLength}`);

            pathLayer.appendChild(line);

            const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            dot.setAttribute('cx', x2);
            dot.setAttribute('cy', y2);
            dot.setAttribute('r', Math.max(2, VISUAL_SCALE / 6));
            dot.setAttribute('fill', p2.waypointIndex !== undefined ? '#51cf66' : '#fa5252');
            pathLayer.appendChild(dot);

            const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
            text.setAttribute('x', (x1 + x2) / 2);
            text.setAttribute('y', (y1 + y2) / 2 - VISUAL_SCALE / 5);
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('font-size', Math.max(8, VISUAL_SCALE / 2));
            text.textContent = p2.steps;

            // ✅ If this leg is locked, show 'Entry' in a different color
            if (p2.locked) {
                text.textContent = 'Entry';
                text.setAttribute('fill', 'white');
            } else if(p2.type !== TYPE_RETURN) {
                // dont print the number on return legs
                text.textContent = p2.steps;
                text.setAttribute('fill', 'white');
            }

            pathLayer.appendChild(text);
        }

        updateViewBox();
    }

    function updateViewBox() {
        if (!path.length) return;

        const basePadding = 40;
        const arrowLength = (20 * VISUAL_SCALE / 10) + (8 * VISUAL_SCALE / 10);
        const padding = basePadding + arrowLength;

        let minX = path[0].x * VISUAL_SCALE;
        let maxX = path[0].x * VISUAL_SCALE;
        let minY = path[0].y * VISUAL_SCALE;
        let maxY = path[0].y * VISUAL_SCALE;

        for (let p of path) {
            const scaledX = p.x * VISUAL_SCALE;
            const scaledY = p.y * VISUAL_SCALE;

            minX = Math.min(minX, scaledX);
            maxX = Math.max(maxX, scaledX);
            minY = Math.min(minY, scaledY);
            maxY = Math.max(maxY, scaledY);
        }

        const width = maxX - minX + padding * 2;
        const height = maxY - minY + padding * 2;

        svg.setAttribute( 'viewBox', `${minX - padding} ${minY - padding} ${width} ${height}`);
    }

    /* -----------------------------
        Actions
    ----------------------------- */

    function turn(dir) {
        if (dir === 'left') currentHeading -= Math.PI / 2;
        if (dir === 'right') currentHeading += Math.PI / 2;

        currentHeading = (currentHeading + Math.PI * 2) % (Math.PI * 2);

        updateDirectionArrow(); // rotate instantly
    }

    function addLeg() {
        const steps = parseInt(stepsBuffer);
        if (!steps || steps <= 0) return;

        const last = path[path.length - 1];
        const logicalDistance = steps; // raw units

        // --- compute new leg coordinates ---
        const newX = Math.round(last.x + logicalDistance * Math.sin(currentHeading));
        const newY = Math.round(last.y - logicalDistance * Math.cos(currentHeading));

        // --- build a temporary path including the new leg ---
        const tempPath = [...path, { x: newX, y: newY, steps }];

        // --- compute bounds and VISUAL_SCALE using updated path ---
        const allX = tempPath.map(p => p.x);
        const allY = tempPath.map(p => p.y);
        const minX = Math.min(...allX);
        const maxX = Math.max(...allX);
        const minY = Math.min(...allY);
        const maxY = Math.max(...allY);

        const width = maxX - minX;
        const height = maxY - minY;

        const baseSize = 20;          
        const referenceSize = 200;    
        VISUAL_SCALE = Math.max(4, baseSize * Math.sqrt(width * height) / referenceSize);

        // --- push new leg ---
        path.push({ 
            x: newX, 
            y: newY, 
            steps: steps,
            type: TYPE_NORMAL 
        });
        headings.push(currentHeading);

        // --- reset step buffer and update visuals ---
        stepsBuffer = '';
        updateDirectionArrow();
        rotateMap()
        updateDisplay();
        drawPath();
        saveToLocalStorage()
    }

    function undoLeg() {
        let removedPoint = null;

        // Find the last leg that is not locked
        for (let i = path.length - 1; i > 0; i--) {
            if (!path[i].locked) {
                removedPoint = path[i];   // ✅ capture before removing
                path.splice(i, 1);
                headings.splice(i, 1);
                break;
            }
        }

        // --- waypoint cleanup ---
        if (
            removedPoint &&
            removedPoint.type === TYPE_RETURN &&
            removedPoint.waypointIndex !== undefined
        ) {
            // Only remove if it's the last waypoint (stack-safe)
            if (removedPoint.waypointIndex === waypoints.length - 1) {
                waypoints.pop();
                currentWaypointIndex = Math.max(0, waypoints.length - 1);
            }
        }

        // --- recompute bounds ---
        const allX = path.map(p => p.x);
        const allY = path.map(p => p.y);
        const minX = Math.min(...allX);
        const maxX = Math.max(...allX);
        const minY = Math.min(...allY);
        const maxY = Math.max(...allY);

        const width = maxX - minX;
        const height = maxY - minY;

        // --- recompute VISUAL_SCALE dynamically ---
        const baseSize = 20;
        const referenceSize = 200;
        VISUAL_SCALE = Math.max(4, baseSize * Math.sqrt(width * height) / referenceSize);

        // --- update visuals ---
        updateDirectionArrow();
        drawPath();
        saveToLocalStorage();
    }

    function backspace() {
        stepsBuffer = stepsBuffer.slice(0, -1);
        updateDisplay();
    }

    function addDigit(digit) {
        stepsBuffer += digit;
        updateDisplay();
    }

    /* -----------------------------
        Event Delegation (Footer)
    ----------------------------- */

    footer.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;

        if (btn.dataset.direction) {
            turn(btn.dataset.direction);
            return;
        }

        if (btn.dataset.number !== undefined) {
            addDigit(btn.dataset.number);
            return;
        }

        if (btn.textContent.trim() === 'Enter') {
            addLeg();
            return;
        }

        if (btn.textContent.trim() === '⌫') {
            backspace();
            return;
        }
    });


    function clearMappingSession() {
        if (!confirm('Clear this mapping session? This cannot be undone.')) {
            return;
        }

        localStorage.removeItem('storeMapping');
        window.location.reload();
    }

    function getMappingState() {
        return {
            path: path,
            headings: headings,
            currentHeading: currentHeading,
            visualScale: VISUAL_SCALE,
        };
    }

    function saveToLocalStorage() {
        try {
            localStorage.setItem('storeMapping', JSON.stringify(getMappingState()));
        } catch (e) {
            console.warn('Failed to save mapping to localStorage', e);
        }
    }

    function restoreFromLocalStorage() {
        const saved = localStorage.getItem('storeMapping');

        if (saved) {
            try {
                const state = JSON.parse(saved);

                path = state.path || [];
                headings = state.headings || [];
                currentHeading = state.currentHeading || 0;
                VISUAL_SCALE = state.visualScale || 20;

            } catch (e) {
                console.warn('Failed to restore mapping', e);
            }
        }

        // --- if no path was restored, create a default 4-step leg ---
        if (!path || path.length <= 1) {

            path = [{ x: 0, y: 0, steps: 0, type: TYPE_NORMAL }];
            headings = [0]; // start facing up
            currentHeading = 0;

            const last = path[path.length - 1];
            const steps = 4;

            const newX = Math.round(last.x + steps * Math.sin(currentHeading));
            const newY = Math.round(last.y - steps * Math.cos(currentHeading));

            path.push({ x: newX, y: newY, steps, type: TYPE_NORMAL, locked: true }); // starter leg
            headings.push(currentHeading);
        }

        // --- rebuild waypoints[] ---
        waypoints = [];
        currentWaypointIndex = 0;
        path.forEach(p => {
            if (p.waypointIndex !== undefined) {
                waypoints[p.waypointIndex] = { x: p.x, y: p.y };
            }
        });

        drawPath();
        updateDirectionArrow();
    }

})();
</script>

{% endblock %}