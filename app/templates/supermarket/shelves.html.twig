{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
<div class="toolbar">
    <button id="auto-generate">Auto-generate shelves</button>
    <button id="undoGroupsBtn" class="btn btn-outline-secondary">Undo</button>
    <button id="saveGroupsBtn" class="btn btn-warning">Save shelving groups</button>
    <div id="saveFlash" class="save-flash"></div>
</div>

<svg 
    id="shelf-editor" 
    width="1200" 
    height="800"
    data-nodes="{{ nodes|json_encode|e('html_attr') }}"
    data-edges="{{ edges|json_encode|e('html_attr') }}"
    data-map="{{ map|json_encode|e('html_attr') }}"
>
  <g id="edges-layer"></g>
  <g id="shelves-layer"></g>
</svg>

<style>
.toolbar {
  display: flex;
  gap: 8px;
  padding: 8px;
  border-bottom: 1px solid #ccc;
}

.toolbar button.active {
  background: #ffd54f;
}

#shelf-editor {
  background: #fafafa;
  cursor: crosshair;
}

.edge {
  stroke: #0d6efd;
  stroke-width: 4;
}

.shelf {
  fill: #e0e0e0;
  stroke: #999;
  cursor: move;
}

.shelf.selected {
  stroke: #ff9800;
  stroke-width: 2;
}

.shelf.draft {
  fill: rgba(200,200,200,0.4);
  stroke-dasharray: 4;
}

.save-flash {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #198754;
  color: white;
  padding: 10px 14px;
  border-radius: 6px;
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
}

.save-flash.show {
  opacity: 1;
}

</style>
<script>
const svg = document.getElementById('shelf-editor');
const edgesLayer = document.getElementById('edges-layer');
const shelvesLayer = document.getElementById('shelves-layer');
const autoGenerateBtn = document.getElementById('auto-generate');

const SVG_NS = 'http://www.w3.org/2000/svg';

let mode = 'select'; // 'draw' | 'select'
let shelves = [];
let activeShelfId = null;

let tempRect = null;
let startX = 0;
let startY = 0;
let dragOffsetX = 0;
let dragOffsetY = 0;



// set viewBox so SVG scales cleanly
const edgesData = JSON.parse(svg.dataset.edges);
const nodesData = JSON.parse(svg.dataset.nodes);
const [mapWidth, mapHeight] = JSON.parse(svg.dataset.map);
svg.setAttribute('viewBox', `0 0 ${mapWidth} ${mapHeight}`);

const nodes = {};
nodesData.forEach(n => {
    nodes[n.id] = n;
});

edgesData.forEach(e => {
    const from = nodes[e.from];
    const to   = nodes[e.to];

    // visible edge
    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);
    line.classList.add('edge');

    edgesLayer.appendChild(line);
});

const nodeMap = new Map();
edgesData.forEach(edge => {
  const a = `${edge.x1},${edge.y1}`;
  const b = `${edge.x2},${edge.y2}`;

  if (!nodeMap.has(a)) nodeMap.set(a, []);
  if (!nodeMap.has(b)) nodeMap.set(b, []);

  nodeMap.get(a).push(edge);
  nodeMap.get(b).push(edge);
});

autoGenerateBtn.onclick = autoGenerateShelves;

// Edge Grouping
let shelfGroups = [];   // persisted later
let undoStack = [];
let isSelecting = false;
let selectStart = null;
let selectionRectEl = null;

function rectIntersects(a, b) {
  return !(
    a.x + a.width < b.x ||
    b.x + b.width < a.x ||
    a.y + a.height < b.y ||
    b.y + b.height < a.y
  );
}

svg.addEventListener('mousedown', e => {
  if (e.button !== 0) return; // left mouse only

  isSelecting = true;
  selectStart = getSvgPoint(e);

  selectionRectEl = document.createElementNS("http://www.w3.org/2000/svg", "rect");
  selectionRectEl.setAttribute("x", selectStart.x);
  selectionRectEl.setAttribute("y", selectStart.y);
  selectionRectEl.setAttribute("width", 0);
  selectionRectEl.setAttribute("height", 0);
  selectionRectEl.setAttribute("fill", "rgba(255,0,0,0.1)");
  selectionRectEl.setAttribute("stroke", "red");
  selectionRectEl.setAttribute("stroke-dasharray", "4");

  svg.appendChild(selectionRectEl);
});

svg.addEventListener('mousemove', e => {
  if (!isSelecting || !selectionRectEl) return;

  const p = getSvgPoint(e);

  const x = Math.min(selectStart.x, p.x);
  const y = Math.min(selectStart.y, p.y);
  const w = Math.abs(p.x - selectStart.x);
  const h = Math.abs(p.y - selectStart.y);

  selectionRectEl.setAttribute("x", x);
  selectionRectEl.setAttribute("y", y);
  selectionRectEl.setAttribute("width", w);
  selectionRectEl.setAttribute("height", h);
});

svg.addEventListener('mouseup', () => {
  if (!isSelecting || !selectionRectEl) return;

  isSelecting = false;

  const groupRect = {
    x: parseFloat(selectionRectEl.getAttribute("x")),
    y: parseFloat(selectionRectEl.getAttribute("y")),
    width: parseFloat(selectionRectEl.getAttribute("width")),
    height: parseFloat(selectionRectEl.getAttribute("height"))
  };

  svg.removeChild(selectionRectEl);
  selectionRectEl = null;

  createShelfGroup(groupRect);
});

function createShelfGroup(selectionRect) {
  const groupedShelves = shelves.filter(shelf =>
    rectIntersects(selectionRect, shelf)
  );

  if (!groupedShelves.length) return;

  pushUndoState();

  // Compute bounding box of group
  const x1 = Math.min(...groupedShelves.map(s => s.x));
  const y1 = Math.min(...groupedShelves.map(s => s.y));
  const x2 = Math.max(...groupedShelves.map(s => s.x + s.width));
  const y2 = Math.max(...groupedShelves.map(s => s.y + s.height));

  const group = {
    id: crypto.randomUUID(),
    shelves: groupedShelves.map(s => s.id),
    x: x1,
    y: y1,
    width: x2 - x1,
    height: y2 - y1
  };

  shelfGroups.push(group);
  console.log('Created shelf group:', group);
  drawShelfGroup(group);
}

function drawShelfGroup(group) {
  const rect = document.createElementNS("http://www.w3.org/2000/svg", "rect");

  rect.setAttribute("x", group.x);
  rect.setAttribute("y", group.y);
  rect.setAttribute("width", group.width);
  rect.setAttribute("height", group.height);
  rect.setAttribute("fill", "none");
  rect.setAttribute("stroke", "red");
  rect.setAttribute("stroke-width", "2");

  rect.dataset.groupId = group.id;

  shelvesLayer.appendChild(rect);
}

function getSvgPoint(evt) {
  const pt = svg.createSVGPoint();
  pt.x = evt.clientX;
  pt.y = evt.clientY;
  return pt.matrixTransform(svg.getScreenCTM().inverse());
}

function pushUndoState() {
  undoStack.push(JSON.stringify(shelfGroups));
}

function restoreUndoState() {
  if (!undoStack.length) return;

  shelfGroups = JSON.parse(undoStack.pop());
  redrawShelfGroups();
}

function redrawShelfGroups() {
  document.querySelectorAll('[data-group-id]').forEach(el => el.remove());
  shelfGroups.forEach(drawShelfGroup);
}

document.getElementById('undoGroupsBtn').addEventListener('click', restoreUndoState);
document.getElementById('saveGroupsBtn').addEventListener('click', saveGroups);

function saveGroups() {
  fetch('/api/shelf-groups', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({
      groups: shelfGroups
    })
  })
  .then(r => {
    if (!r.ok) throw new Error();
    flashSaved();
  })
  .catch(() => flashError());
}

function flashSaved() {
  const el = document.getElementById('saveFlash');
  el.textContent = 'Shelving groups saved';
  el.style.background = '#198754';
  el.classList.add('show');

  setTimeout(() => el.classList.remove('show'), 2000);
}

function flashError() {
  const el = document.getElementById('saveFlash');
  el.textContent = 'Save failed';
  el.style.background = '#dc3545';
  el.classList.add('show');

  setTimeout(() => el.classList.remove('show'), 2000);
}

function getPerpendicularIntersections(edge, edgesData, TOLERANCE) {
  const intersections = [];

  const isHorizontal = Math.abs(edge.y2 - edge.y1) <= TOLERANCE;
  const isVertical   = Math.abs(edge.x2 - edge.x1) <= TOLERANCE;

  edgesData.forEach(other => {
    if (other === edge) return;

    const otherHorizontal = Math.abs(other.y2 - other.y1) <= TOLERANCE;
    const otherVertical   = Math.abs(other.x2 - other.x1) <= TOLERANCE;

    // horizontal ↔ vertical only
    if (isHorizontal && otherVertical) {
      const y = edge.y1;
      const x = other.x1;

      const oxMin = Math.min(other.y1, other.y2);
      const oxMax = Math.max(other.y1, other.y2);
      const exMin = Math.min(edge.x1, edge.x2);
      const exMax = Math.max(edge.x1, edge.x2);

      if (y >= oxMin && y <= oxMax && x >= exMin && x <= exMax) {
        intersections.push(x);
      }
    }

    if (isVertical && otherHorizontal) {
      const x = edge.x1;
      const y = other.y1;

      const oxMin = Math.min(other.x1, other.x2);
      const oxMax = Math.max(other.x1, other.x2);
      const exMin = Math.min(edge.y1, edge.y2);
      const exMax = Math.max(edge.y1, edge.y2);

      if (x >= oxMin && x <= oxMax && y >= exMin && y <= exMax) {
        intersections.push(y);
      }
    }
  });

  return intersections;
}

function hasPerpendicularAtPoint(x, y, currentEdge) {
  const key = `${x},${y}`;
  const connected = nodeMap.get(key) || [];

  const dx = Math.abs(currentEdge.x2 - currentEdge.x1);
  const dy = Math.abs(currentEdge.y2 - currentEdge.y1);

  const isHorizontal = dy < dx;

  return connected.some(edge => {
    if (edge === currentEdge) return false;

    const edx = Math.abs(edge.x2 - edge.x1);
    const edy = Math.abs(edge.y2 - edge.y1);

    const otherIsHorizontal = edy < edx;

    return isHorizontal !== otherIsHorizontal;
  });
}



// auto generate shelves from edges
function autoGenerateShelves() {
  shelvesLayer.innerHTML = '';
  shelves = [];

  const aisleWidth = 80;
  const shelfDepth = 30;
  const offset = aisleWidth / 2 + shelfDepth / 2;
  const MIN_LENGTH = 0;
  const TOLERANCE = 5;
  const END_CLEARANCE = 40; // half aisle width is a good start

  edgesData.forEach(edge => {
    const dx = edge.x2 - edge.x1;
    const dy = edge.y2 - edge.y1;

    const absDx = Math.abs(dx);
    const absDy = Math.abs(dy);

    // ---------- HORIZONTAL AISLE ----------
    if (absDy <= TOLERANCE && absDx >= MIN_LENGTH) {
        const y = edge.y1;

        let startX = Math.min(edge.x1, edge.x2);
        let endX   = Math.max(edge.x1, edge.x2);

        if (hasPerpendicularAtPoint(startX, y, edge)) {
            startX += END_CLEARANCE;
        }

        if (hasPerpendicularAtPoint(endX, y, edge)) {
            endX -= END_CLEARANCE;
        }

        const width = endX - startX;
        if (width <= 0) return;

        shelves.push(
            {
            id: crypto.randomUUID(),
            x: startX,
            y: y - offset - shelfDepth / 2,
            width,
            height: shelfDepth,
            edgeId: edge.id
            },
            {
            id: crypto.randomUUID(),
            x: startX,
            y: y + offset - shelfDepth / 2,
            width,
            height: shelfDepth,
            edgeId: edge.id
            }
        );

        return;
    }

    // ---------- VERTICAL AISLE ----------
    if (absDx <= TOLERANCE && absDy >= MIN_LENGTH) {
        const x = edge.x1;

        let startY = Math.min(edge.y1, edge.y2);
        let endY   = Math.max(edge.y1, edge.y2);

        if (hasPerpendicularAtPoint(x, startY, edge)) {
            startY += END_CLEARANCE;
        }

        if (hasPerpendicularAtPoint(x, endY, edge)) {
            endY -= END_CLEARANCE;
        }

        const height = endY - startY;
        if (height <= 0) return;

        shelves.push(
            {
            id: crypto.randomUUID(),
            x: x - offset - shelfDepth / 2,
            y: startY,
            width: shelfDepth,
            height,
            edgeId: edge.id
            },
            {
            id: crypto.randomUUID(),
            x: x + offset - shelfDepth / 2,
            y: startY,
            width: shelfDepth,
            height,
            edgeId: edge.id
            }
        );

        return;
    }

  });

  shelves.forEach(drawShelf);
}



function drawShelf(shelf) {
  const rect = document.createElementNS(SVG_NS, 'rect');

  rect.setAttribute('x', shelf.x);
  rect.setAttribute('y', shelf.y);
  rect.setAttribute('width', shelf.width);
  rect.setAttribute('height', shelf.height);
  rect.dataset.id = shelf.id;
    rect.dataset.edgeId = shelf.edgeId ?? '';
  rect.classList.add('shelf', 'auto');

  shelvesLayer.appendChild(rect);
}



</script>

{% endblock %}