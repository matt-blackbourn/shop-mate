{% extends 'base.html.twig' %}

{% block title %}Supermarket index{% endblock %}

{% block body %}
    <h1>Supermarket index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for supermarket in supermarkets %}
            <tr>
                <td>{{ supermarket.id }}</td>
                <td>{{ supermarket.type.value }} - {{ supermarket.suburb }}</td>
                <td>
                    {% if supermarket.imagePath %}
                        <a href="{{ path('app_supermarket_draw_edges_overlay', {'id': supermarket.id}) }}">Edges - image overlay</a>
                    {% else %}
                        <a href="{{ path('app_supermarket_draw_edges', {'id': supermarket.id}) }}">Map</a>
                    {% endif %}

                    {% if supermarket.shelves|length == 0 %}
                    | <a href="{{ path('app_supermarket_draw_shelves', {'id': supermarket.id}) }}">Generate Shelves</a>
                    {% else %}

                    | <a href="{{ path('app_supermarket_edit_shelves', {'id': supermarket.id}) }}">Shelves</a>
                    {% endif %}
                    | <a href="{{ path('app_supermarket_delete', {'id': supermarket.id}) }}"
                        class="text-danger"
                        onclick="return confirm('Delete this supermarket?\\n\\nAll nodes, edges, shelves, and mapped food items will be permanently removed.')">
                        Delete
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {# <a href="{{ path('app_supermarket_new') }}">Create new</a> #}

    <a href="{{ path('app_home') }}">Home</a>
{% endblock %}
