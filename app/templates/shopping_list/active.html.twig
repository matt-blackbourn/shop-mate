{% extends 'base.html.twig' %}

{% block title %}Shopping{% endblock %}

{% block body %}

<div class="container py-3">

    <!-- Sticky header -->
    <div class="sticky-top bg-white border-bottom z-3">
        <div class="d-flex align-items-center justify-content-between px-2 py-2">

            <!-- Exit shopping -->
            <a href="{{ path('app_home') }}"
               class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span class="d-none d-sm-inline">Done</span>
            </a>

            <!-- Heading -->
            <h1 class="h6 mb-0 text-center flex-grow-1">
                Shopping @ {{ shoppingList.supermarket.name }}
            </h1>

            <!-- Edit list -->
            <a href="{{ path('app_shopping_list_edit', { id: shoppingList.id }) }}"
               class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-pencil"></i>
                <span class="d-none d-sm-inline">Edit</span>
            </a>

        </div>
    </div>

    <!-- Spacer -->
    <div class="sticky-spacer"></div>

    {% if showPlacementHint is defined and showPlacementHint %}
    <div class="alert alert-warning alert-dismissible fade show small" role="alert">
        Some items don’t have locations yet.
        <strong>Long-press</strong> an item or tap <strong>⋯</strong> to add one.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}

    <!-- Shopping items -->
    <div class="shopping-cards">

        {% for listItem in orderedList %}
            <div class="shopping-card" data-id="{{ listItem.id }}">

                <div class="card-header d-flex align-items-start justify-content-between">

                    <!-- LEFT META -->
                    <div class="card-meta">
                        <button class="dots-btn" type="button" aria-label="Item options">
                            ⋯
                        </button>

                        {# placement indicator #}
                        {% set status = listItem.placementStatus.value %}

                        {% if status == 'system' %}
                            <span class="placement-indicator system" title="System placement"></span>
                        {% elseif status == 'user_confirmed' %}
                            <span class="placement-indicator confirmed" title="Your placement"></span>
                        {% elseif status == 'user_provisional' %}
                            <span class="placement-indicator provisional" title="Placed by another user (confirmable)"></span>
                        {% elseif status == 'category' %}
                            <span class="placement-indicator category" title="Category placement"></span>
                        {% else %}
                            <span class="placement-indicator missing" title="No location"></span>
                        {% endif %}
                    </div>

                    <!-- MAIN CONTENT -->
                    <div class="card-main">
                        <div class="title">
                            {{ listItem.foodItem.name }}
                            {% if listItem.quantity %}
                                <span class="text-muted">({{ listItem.quantity }})</span>
                            {% endif %}
                        </div>

                        {% if listItem.notes %}
                            <div class="notes small text-muted">
                                {{ listItem.notes }}
                            </div>
                        {% endif %}
                    </div>

                    <!-- PICKED -->
                    <button class="pick-btn" type="button">
                        Picked
                    </button>

                </div>


            </div>
        {% endfor %}

    </div>

</div>


<style>
.shopping-card {
    background: white;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,.1);
    touch-action: pan-y;
}

.notes {
    margin-left: 0.25rem;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Allow title to truncate instead of pushing */
.title {
  font-size: 1.1rem;
  font-weight: 600;
  padding-right: 8px;
  flex: 1;
  min-width: 0;              /* IMPORTANT */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.qty, .notes {
    font-size: .85rem;
    color: #666;
    margin-top: 4px;
}

.pick-btn {
  all: unset;              /* nukes Bootstrap styles */
  display: inline-flex;
  align-items: center;

  font-size: 0.8rem;
  padding: 4px 10px;
  border-radius: 999px;
  background: #e6f4ea;
  color: #1e7e34;
  font-weight: 500;
  min-height: 32px;

  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
}


.pick-btn:active {
    transform: scale(0.96);
    background: #d7eddc;
}

.card-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-right: 8px;
    flex-shrink: 0;
}
.dots-btn {
    all: unset;
    font-size: 18px;
    line-height: 1;
    color: #999;
    cursor: pointer;
    padding: 4px;
}

.dots-btn:active {
    opacity: 0.6;
}
.dots-btn {
    all: unset;
    font-size: 18px;
    line-height: 1;
    color: #999;
    cursor: pointer;
    padding: 4px;
}

.dots-btn:active {
    opacity: 0.6;
}
.placement-indicator {
    width: 10px;
    height: 10px;
    display: inline-block;
}

/* Fully placed – green dot */
.placement-indicator.full {
    background: #2da44e;
    border-radius: 50%;
}

/* Approximate – yellow hollow dot */
.placement-indicator.approx {
    border: 2px solid #f0ad4e;
    border-radius: 50%;
}

/* Missing – warning triangle */
.placement-indicator.missing {
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 10px solid #d9534f;
}
.card-main {
    flex: 1;
    min-width: 0;
}

/* Base placement indicator */
.placement-indicator {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;  /* circular dot */
    margin-right: 6px;
    vertical-align: middle;
}

/* SYSTEM placement - highest authority / immutable */
.placement-indicator.system {
    background-color: #0d6efd; /* Bootstrap primary blue */
}

/* USER_CONFIRMED - placed by current user */
.placement-indicator.confirmed {
    background-color: #198754; /* Bootstrap green */
}

/* USER_PROVISIONAL - placed by another user, needs confirmation */
.placement-indicator.provisional {
    background-color: #ffc107; /* yellow / warning */
}

/* CATEGORY placement - inferred by category */
.placement-indicator.category {
    background-color: #6c757d; /* grey / neutral */
}

/* NONE - no placement at all */
.placement-indicator.missing {
    background-color: #dc3545; /* Bootstrap red */
}

</style>

<script>
// Pick item function
document.querySelectorAll('.pick-btn').forEach(btn => {
    btn.addEventListener('click', e => {
        const card = e.target.closest('.shopping-card');
        pickItem(card);
    });
});

// Long-press + dots menu (without breaking Picked)
document.querySelectorAll('.shopping-card').forEach(card => {
    addLongPress(card, e => {
        if (e.target.closest('.pick-btn')) return;
        openPlacementMenu(card);
    });
});

document.querySelectorAll('.dots-btn').forEach(btn => {
    btn.addEventListener('click', e => {
        e.stopPropagation();
        openPlacementMenu(e.target.closest('.shopping-card'));
    });
});



function pickItem(card) {
    if (card.dataset.picking) return;
    card.dataset.picking = '1';

    // Animate immediately
    card.style.transition = 'transform 0.2s ease, opacity 0.2s ease';
    card.style.transform = 'translateX(-120%)';
    card.style.opacity = '0';

    // Remove from DOM after animation
    setTimeout(() => card.remove(), 200);

    // Fire-and-forget request
    fetch(`/shoppinglist/ajax/pick/${card.dataset.id}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Content-Type': 'application/json'
        }
    }).catch(() => {
        // Later: show toast / undo
        console.error('Failed to mark item as picked');
    });
}
</script>
{% endblock %}
