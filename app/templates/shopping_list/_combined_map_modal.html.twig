<div class="modal fade map-modal" id="mapModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header d-flex justify-content-between gap-2">

                <div id='foodInfo' class="title">
                    <span id="modalItemName"></span>
                    <span id="modalItemQty"></span>
                    <div id="modalItemNotes"></div>
                </div>
                    <!-- Placement Instructions -->
                <div id="placementInstructions" class="d-none">
                    <h6>Tap the shelf where this item belongs.<br>
                        Tap again to change aisle sides.</h6>
                </div>

                <button type="button" id="rotate" class="btn-dark-base">
                    <i class="bi-arrow-repeat"></i>
                </button>
                <button type="button" id="placeItemBtn" class="btn-dark-base border-green">
                    <i class="bi-geo-alt-fill"></i>
                </button>

            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="map-svg" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="map-inner">
                            <g id="edges-layer"></g>
                            <g id="entrance-layer"></g>
                            <g id="shelves-layer"></g>
                        </g>
                    </svg>
                    
                </div>
            </div>

            <div class="modal-footer">

                <!-- Left button -->
                <button type="button" id="mapBackBtn" class="map-nav-button" data-bs-dismiss="modal">
                    <i class="bi-arrow-left"></i> Back
                </button>
                <button type="button" id="placementCancelBtn" class="map-nav-button d-none">
                    Cancel
                </button>

                <!-- Path Mode Buttons -->
                <button id="skip-item-map" class="btn-dark-base border-yellow">Skip</button>
                <button id="pick-item-map" class="btn-dark-base border-green">Pick Item</button>

                <!-- Placement Mode Button -->
                <button type="submit" form="placementForm" id="placementConfirmBtn" class="btn-dark-base border-green" disabled>
                    Save placement
                </button>

            </div>

            <form method="POST" action="/placement/save" id="placementForm">
                <input type="hidden" name="placement" id="placementPayload">
            </form>

        </div>
    </div>
</div>