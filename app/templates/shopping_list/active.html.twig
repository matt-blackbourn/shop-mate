{% extends 'base.html.twig' %}

{% block title %}Shopping{% endblock %}

{% block body %}

<div 
    class="container py-3"
    id="shoppingListContainer"
    data-nodes="{{ nodes|json_encode|e('html_attr') }}"
    data-edges="{{ edges|json_encode|e('html_attr') }}"
    data-shelves="{{ shelves|json_encode|e('html_attr') }}"
    data-segments="{{ segments|json_encode|e('html_attr') }}"
    data-entrance-node-id="{{ supermarket.entranceNode.id }}"
    data-supermarket-id="{{ supermarket.id }}" 
    data-list-id="{{ shoppingList.id }}" 
    data-aisle-width='{{ supermarket.aisleWidth }}'
    data-shelf-depth='{{ supermarket.shelfDepth }}'
>

    <div class="sticky-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <div class="header-left d-flex align-items-center gap-2">
                <a href="{{ path('app_home') }}" class="btn-dark-base border-yellow">
                    <i class="bi bi-check-circle-fill"></i>
                </a>
                <form method="POST" action="/shoppinglist/unpick">
                    <input type="hidden" name="shoppingListId" value="{{ shoppingList.id }}">
                    <input type="hidden" name="supermarketId" value="{{ supermarket.id }}">
                    <button type="submit" id="unpickBtn" disabled class="btn-dark-base">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </form>
            </div>

            <div class="header-center flex-grow-1 d-flex justify-content-center">
                <h6>
                    {{ supermarket.type.value }} - {{ supermarket.suburb }}
                </h6>
            </div>

            <div class="header-right d-flex align-items-center">
                <a href="" id="mapButton" class="btn-dark-base">
                    <i class="bi-grid-3x3"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Spacer -->
    <div class="sticky-spacer"></div>

    {# {% if showPlacementHint is defined and showPlacementHint %}
    <div class="alert alert-dismissible fade show small" role="alert">
        Some items don’t have locations yet.
        <strong>Long-press</strong> an item or tap <strong>⋯</strong> to add one.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %} #}


    <!-- Spacer -->
    <div class="sticky-spacer"></div>

    {# {% if showPlacementHint is defined and showPlacementHint %}
    <div class="alert alert-warning alert-dismissible fade show small" role="alert">
        Some items don’t have locations yet.
        <strong>Long-press</strong> an item or tap <strong>⋯</strong> to add one.
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %} #}

    <!-- Shopping items -->
    <div class="shopping-cards" id="data" data-placement-status="{{ placementStatus|json_encode|e('html_attr') }}">

    {% for routedItem in orderedList %}
        {% set listItem = routedItem.item %}

        <div 
            class="shopping-card"
            data-id="{{ listItem.id }}"
            data-placement-status="{{ listItem.placementStatus.value }}"
            data-food-item-id="{{ listItem.foodItem.id }}"
            data-food-item-name="{{ listItem.foodItem.name }}"
            data-item-notes="{{ listItem.notes }}"
            data-item-quantity="{{ listItem.quantity }}"
            data-placement-edge-id="{{ routedItem.placement ? routedItem.placement.edge.id : '' }}"
            data-placement-aisle-side="{{ routedItem.placement ? routedItem.placement.aisleSide : '' }}"
        >

            <div class="card-header d-flex justify-content-between">

                <!-- LEFT META -->
                <div class="card-meta">
                    <div class="placement-wrapper">
                        <button class="placement-btn" type="button" aria-label="Item options">
                            {# placement indicator #}
                            {% set status = listItem.placementStatus.value %}

                            {% if status in ['system', 'confirmed'] %}
                                <i class="bi bi-check placement-icon confirmed"></i>

                            {% elseif status in ['provisional', 'group'] %}
                                <i class="bi bi-question-circle placement-icon provisional"></i>

                            {% else %}
                                <i class="bi bi-exclamation-triangle-fill placement-icon missing"></i>
                            {% endif %}
                        </button>

                        <div class="placement-menu">
                            <div class="sheet-handle"></div>
                            <p class="menu-text"></p>
                            <div class="modal-actions">
                                <button type="button" class="menu-btn" id="mapItem"></button>
                                <button type="button" class="menu-btn" id="groupItem"></button>
                                <button type="button" class="menu-btn" id="skip-item">Skip Item</button>
                            </div>
                        </div>
                    </div>

               
                </div>

                <!-- MAIN CONTENT -->
                <div class="card-main">
                    <div class="title">
                        {{ listItem.foodItem.name }}
                        {% if listItem.quantity and listItem.quantity > 1 %}
                            <span class="app-muted">({{ listItem.quantity }})</span>
                        {% endif %}
                    </div>

                    {% if listItem.notes %}
                        <div class="app-muted notes">
                            {{ listItem.notes }}
                        </div>
                    {% endif %}
                </div>

                <button class="pick-btn-list btn-dark-base border-green" type="button">Pick Item</button>

            </div>
        </div>
        {% endfor %}
    </div>

    {# Flash messages #}
    <div class="flash-container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible mt-2 mb-0" role="alert" data-auto-fade="{{ label == 'success' ? '1' : '0' }}">
                {{ message|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
    </div>

</div>
<div id="sheetBackdrop" class="sheet-backdrop"></div>

{% include 'food_item/_group_item_modal.html.twig' %}
