<div class="modal fade map-modal" id="pathModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h6 class="modal-title">
                    Tap the aisle this item belongs in. </br>
                    Tap again to change aisle side:
                </h6>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="path-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="path-edges-layer"></g>
                        <g id="path-entrance-layer"></g>
                    </svg>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="placementCancelBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="placementForm" id="placementConfirmBtn" class="btn btn-primary" disabled>Save placement</button>
            </div>
            <form method="POST" action="/placement/save" id="placementForm">
                <input type="hidden" name="placement" id="placementPayload">
            </form>

        </div>
    </div>
</div>


<style>
/* Base route styling */
.path-edge.route-upcoming,
.path-edge.route-active,
.path-edge.route-complete {
    stroke-width: 6;              /* thicker line */
    stroke-dasharray: 40 20;      /* long dash, clear gap */
    transition: stroke 200ms ease, opacity 200ms ease;
}

.path-edge.route-complete {
    stroke: #64748b;        /* slate-500 */
    opacity: 0.7;
    stroke-width: 4;
}

/* Active (warm, obvious) */
.path-edge.route-active {
    stroke: #f59e0b;        /* amber-500 */
    opacity: 1;
    stroke-width: 7;
    drop-shadow(0 0 8px rgba(245, 158, 11, 0.65))
    stroke-dasharray: 60 0; /* solid */
    animation: pulse 1s infinite;
}

/* Upcoming (same hue, hint only) */
.path-edge.route-upcoming {
    stroke: #f59e0b;
    opacity: 0.4;
    stroke-width: 4;
}

@keyframes pulse {
    0%   { stroke-width: 8;  opacity: 0.7; }
    50%  { stroke-width: 12; opacity: 1; }
    100% { stroke-width: 8;  opacity: 0.7; }
}

{# /* Visited segments (blue, subtle) */
.path-edge.route-complete {
    stroke: var(--app-blue, #3b82f6); /* or your app blue */
    opacity: 0.5;
    stroke-width: 4;
}

/* Current target segment (strong green) */
.path-edge.route-active {
    stroke: #22c55e;
    opacity: 1;
    stroke-width: 5;
}

/* Remaining segments (green but very see-through) */
.path-edge.route-upcoming {
    stroke: #22c55e;
    opacity: 0.5;
    stroke-width: 4;
} #}



</style>

