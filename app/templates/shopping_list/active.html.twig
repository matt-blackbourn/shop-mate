function onItemPicked(itemId) {
    const id = Number(itemId);

    // Record the pick
    routeState.pickedItemIds.add(id);

    const idx = routeState.segments.findIndex(
        s => s.itemId === id
    );
    if (idx === -1) return;

    // record physical location of user in placement state in case of placement made mid-shop
    placementState.currentNodeId = routeState.segments[idx].targetNodeId;

    // Only recalc guidance if the user picked the current target
    if (idx === routeState.currentSegment) {
        const next = routeState.segments.findIndex(
            s => !routeState.pickedItemIds.has(s.itemId)
        );

        routeState.currentSegment = next === -1 ? routeState.segments.length : next;
    }

    updateMapView();
    highlightItemOnMap();
    rotateMap()
}

// draw shelves
function drawShelves(shelvesData) {
    const shelfLayer = document.getElementById('shelves-layer');

    shelvesData.forEach(shelf => {
        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', shelf.x);
        rect.setAttribute('y', shelf.y);
        rect.setAttribute('width', shelf.width);
        rect.setAttribute('height', shelf.height);
        rect.classList.add('shelf');
        shelfLayer.appendChild(rect);

        shelfEls.push({
            el: rect,
            ...shelf
        });
    });
}

function getLayer(svgId, layerId) {
    return document.getElementById(svgId).querySelector(`#${layerId}`);
}

function drawEntranceArrow(node) {
    let layer = getLayer('map-svg', 'entrance-layer');

    const g = document.createElementNS(SVG_NS, 'g');
    g.classList.add('node', 'entrance');
    g.setAttribute('transform', `translate(${node.x}, ${node.y})`);

    //const ring = document.createElementNS(SVG_NS, 'circle');
    //const circle = document.createElementNS(SVG_NS, 'circle');
    //g.appendChild(ring);
    //g.appendChild(circle);

    let arrowLength = 0;

    const firstEdge = edgesData.find(e => e.from === node.id);
    if (firstEdge) {

        const dx = firstEdge.x2 - firstEdge.x1;
        const dy = firstEdge.y2 - firstEdge.y1;

        const angle = Math.atan2(dy, dx) * (180 / Math.PI);

        const edgeLength = Math.sqrt(dx*dx + dy*dy); // true edge length
        const arrowTipWidth = edgeLength / 3;

        const lineLength = edgeLength - arrowTipWidth; // shorten line

        arrowLength = edgeLength;

        // Arrow line
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', 0);
        line.setAttribute('y1', 0);
        line.setAttribute('x2', lineLength);
        line.setAttribute('y2', 0);
        line.setAttribute('transform', `rotate(${angle})`);
        line.setAttribute('stroke-width', edgeLength / 8);
        line.classList.add('arrow-line');
        g.appendChild(line);

        // Arrow tip
        const tip = document.createElementNS(SVG_NS, 'path');
        tip.setAttribute('d', `M0 ${-arrowTipWidth/2} L${arrowTipWidth} 0 L0 ${arrowTipWidth/2} Z`);
        tip.setAttribute('fill', '#f2b66d');

        tip.setAttribute('transform', `rotate(${angle}) translate(${lineLength},0)`);
        g.appendChild(tip);
    }

    //ring.setAttribute('r', arrowLength / 7);
    //circle.setAttribute('r', arrowLength / 8);

    layer.appendChild(g);
}


function linesIntersect(l1, l2) {
    // Horizontal
    if (l2.y1 === l2.y2) {
        // l2 horizontal
        return (
            l1.x1 >= Math.min(l2.x1, l2.x2) &&
            l1.x1 <= Math.max(l2.x1, l2.x2) &&
            l1.y1 <= l2.y1 && l1.y2 >= l2.y2 || l1.y1 >= l2.y2 && l1.y2 <= l2.y1
        );
    }
    // Vertical
    if (l2.x1 === l2.x2) {
        return (
            l1.y1 >= Math.min(l2.y1, l2.y2) &&
            l1.y1 <= Math.max(l2.y1, l2.y2) &&
            l1.x1 <= l2.x1 && l1.x2 >= l2.x2 || l1.x1 >= l2.x2 && l1.x2 <= l2.x1
        );
    }

    return false;
}


