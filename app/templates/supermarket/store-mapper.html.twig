{% extends 'base.html.twig' %}

{% block title %}Store Mapper{% endblock %}

{% block body %}

<div class="mapper-page d-flex flex-column">

    <!-- HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left: Menu -->
            <div class="header-left d-flex align-items-center">
                <button class="menu-button" aria-label="Open menu">☰</button>
            </div>

            <!-- Center: Title -->
            <div class="header-center flex-grow-1 text-center fw-semibold">
                Store Mapper
            </div>

            <!-- Right: Save -->
            <div class="header-right d-flex align-items-center">
            <button type="button" class="btn-dark-base">
                <i class="bi bi-arrow-counterclockwise"></i>
            </button>
            <button type="button" id="save-map" disabled title="Save changes" class="btn-dark-base border-green">
                <i class="bi bi-check-lg"></i>
            </button>
            </div>
        </div>
    </div>

    <!-- MENU (outside header for z-index safety) -->
    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close">×</button>
        <ul>
            <li><a href="{{ path('app_home') }}">Back to List</a></li>
        </ul>
    </nav>

    <!-- BODY (MAP) -->
    <div class="page-body">
        <div class="mapper-map-container">
            <svg class="mapper-svg"></svg>

        </div>
    </div>

    <!-- FOOTER (NUMBERPAD CONTROLS) -->
    <div class="page-footer mapper-footer">

        <!-- Direction + Enter Row -->
        <div class="mapper-actions">
            <button class="btn-dark-base border-yellow" data-direction="left">
                <i class="bi bi-arrow-left"></i>
            </button>

        <!-- Display -->
            <div class="mapper-display">
                <span id="stepDisplay">0</span>
            </div>

            <button class="btn-dark-base border-yellow" data-direction="right">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>

        <!-- Number Pad -->
        <div class="mapper-numpad">
            {% for n in [1,2,3,4,5,6,7,8,9] %}
                <button class="btn-dark-base" data-number="{{ n }}">{{ n }}</button>
            {% endfor %}
            <button class="btn-dark-base border-red">⌫</button>
            <button class="btn-dark-base" data-number="0">0</button>
            <button class="btn-dark-base border-green">Enter</button>

        </div>

    </div>

</div>




<style>
.mapper-page {
    height: 100dvh;   /* important for mobile */
    background: #1c212b;
    color: #e9ecef;
    display: flex;
    flex-direction: column;
}

/* HEADER */
.page-header {
    background-color: #2b303b;
    border-bottom: 1px solid #343a46;
    position: sticky;
    top: 0;
    z-index: 1030;
}

.header-btn {
    background: #1c212b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

.header-btn:hover {
    background: #343a46;
}

/* BODY */
.page-body {
    flex: 1;
    min-height: 0;      /* CRITICAL */
    overflow: hidden;
    position: relative;
}

.mapper-map-container {
    position: absolute;
    inset: 0;
}

.mapper-svg {
    width: 100%;
    height: 100%;
}

.mapper-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    transform-origin: 50% 50%;
    pointer-events: none;
}

/* FOOTER */
.mapper-footer {
    background: #2b303b;
    border-top: 1px solid #343a46;

    height: 30dvh;          /* 👈 controlled size */
    max-height: 420px;      /* safety cap for large phones */

    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
}

/* Display */
.mapper-display {
    background: #11151c;
    border: 1px solid #343a46;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 18px;
    text-align: right;
    font-weight: bold;

    display: flex;
    align-items: center;
    justify-content: flex-end;

    width: 100%;
    height: 100%;
}

.mapper-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    align-items: stretch;
}


/* Numpad */
.mapper-numpad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 1fr); /* force 4 even rows */
    gap: 6px;
    flex: 1;  
}

/* temporary highlight state */
.btn-dark-base.clicked {
    background-color: #fab005; /* yellow highlight */
    color: #000;               /* optional text color change */
}



</style>

<script>
(function() {

    const SVG_NS = "http://www.w3.org/2000/svg";
    const svg = document.querySelector('.mapper-svg');
    const pathLayer = document.createElementNS(SVG_NS, 'g');
    pathLayer.classList.add('path-layer');
    svg.appendChild(pathLayer);
    svg.setAttribute('viewBox', '-150 -150 300 300');

    const stepDisplay = document.getElementById('stepDisplay');
    const footer = document.querySelector('.mapper-footer');
    const undoBtn = document.querySelector('.bi-arrow-counterclockwise')?.closest('button');
    const saveBtn = document.getElementById('save-map');
    const STEP_SCALE = 20; // pixels per step
    let VISUAL_SCALE = 20;

    let directionArrow; // persistent arrow group
    let stepsBuffer = '';
    let path = [{ x: 0, y: 0, steps: 0 }];
    let headings = [0];
    let currentHeading = 0;
    let hasChanges = false;

    /* -----------------------------
        UI Updates
    ----------------------------- */

    createDirectionArrow();

    // button highlight on click (temporary visual feedback)
    document.querySelectorAll('.btn-dark-base').forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.add('clicked');
            setTimeout(() => btn.classList.remove('clicked'), 50);
        });
    });

    function createDirectionArrow() {
        directionArrow = document.createElementNS(SVG_NS, 'g');
        directionArrow.classList.add('direction-arrow');

        // Arrow line
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', 0);
        line.setAttribute('y1', 0);
        line.setAttribute('x2', 25); // initial length, will be scaled
        line.setAttribute('y2', 0);
        line.setAttribute('stroke', '#fab005');
        line.setAttribute('stroke-width', VISUAL_SCALE / 10);
        line.classList.add('arrow-line');

        // Arrow tip
        const tip = document.createElementNS(SVG_NS, 'path');
        tip.setAttribute('d', `M0 -4 L8 0 L0 4 Z`); // initial tip
        tip.setAttribute('fill', '#fab005');
        tip.classList.add('arrow-tip');
        tip.setAttribute('transform', `translate(25,0)`);

        directionArrow.appendChild(line);
        directionArrow.appendChild(tip);

        svg.appendChild(directionArrow);

        // initial positioning
        updateDirectionArrow();
    }

    function updateDirectionArrow() {
        if (!directionArrow) return;
        const last = path[path.length - 1];

        const angleDeg = currentHeading * (180 / Math.PI);

        // update transform (position & rotation)
        directionArrow.setAttribute(
            'transform',
            `translate(${last.x}, ${last.y}) rotate(${angleDeg - 90})`
        );

        // --- scale visuals ---
        const line = directionArrow.querySelector('.arrow-line');
        const tip = directionArrow.querySelector('.arrow-tip');

        // Line length can be proportional to VISUAL_SCALE
        const lineLength = 10 * VISUAL_SCALE / 10; 
        line.setAttribute('x2', lineLength);
        line.setAttribute('stroke-width', Math.max(1, VISUAL_SCALE / 5));

        // Tip size & position scaled
        const tipWidth = 6 * VISUAL_SCALE / 10;
        const tipHeight = 3 * VISUAL_SCALE / 10;
        tip.setAttribute('d', `M0 ${-tipHeight} L${tipWidth} 0 L0 ${tipHeight} Z`);
        tip.setAttribute('transform', `translate(${lineLength},0)`);
    }



    function updateDisplay() {
        stepDisplay.textContent = stepsBuffer || '0';
    }

    function enableSave() {
        hasChanges = true;
        if (saveBtn) saveBtn.disabled = false;
    }

    /* -----------------------------
        Drawing
    ----------------------------- */

    function drawPath() {

        pathLayer.innerHTML = '';

        for (let i = 1; i < path.length; i++) {
            const p1 = path[i - 1];
            const p2 = path[i];

            const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute('x1', p1.x);
            line.setAttribute('y1', p1.y);
            line.setAttribute('x2', p2.x);
            line.setAttribute('y2', p2.y);
            line.setAttribute('stroke-width', VISUAL_SCALE / 10);
            line.setAttribute('stroke', '#51cf66');


            // scale dash array
            const dashLength = Math.max(1, VISUAL_SCALE / 5); // length of dash
            const gapLength = Math.max(1, VISUAL_SCALE / 5);  // gap between dashes
            line.setAttribute('stroke-dasharray', `${dashLength} ${gapLength}`);
            pathLayer.appendChild(line);

            const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            dot.setAttribute('cx', p2.x);
            dot.setAttribute('cy', p2.y);
            dot.setAttribute('r', VISUAL_SCALE / 6);
            dot.setAttribute('fill', '#51cf66');
            
            pathLayer.appendChild(dot);

            const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
            text.setAttribute('x', (p1.x + p2.x) / 2);
            text.setAttribute('y', (p1.y + p2.y)/2 - VISUAL_SCALE / 5);
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('font-size', Math.max(8, VISUAL_SCALE / 2));
            text.setAttribute('stroke', '#fa5252');
            text.setAttribute('fill', '#fa5252'); 
            text.textContent = p2.steps;
            
            pathLayer.appendChild(text);
        }

        updateViewBox();
    }

    function updateViewBox() {
        if (!path.length) return;

        const padding = 40;
        let minX = path[0].x, maxX = path[0].x;
        let minY = path[0].y, maxY = path[0].y;

        for (let p of path) {
            minX = Math.min(minX, p.x);
            maxX = Math.max(maxX, p.x);
            minY = Math.min(minY, p.y);
            maxY = Math.max(maxY, p.y);
        }

        const width = maxX - minX + padding * 2;
        const height = maxY - minY + padding * 2;

        svg.setAttribute('viewBox', `${minX - padding} ${minY - padding} ${width} ${height}`);

    }

    /* -----------------------------
        Actions
    ----------------------------- */

    function turn(dir) {
        if (dir === 'left') currentHeading -= Math.PI / 2;
        if (dir === 'right') currentHeading += Math.PI / 2;

        currentHeading = (currentHeading + Math.PI * 2) % (Math.PI * 2);

        updateDirectionArrow(); // rotate instantly
    }

    function addLeg() {
        const steps = parseInt(stepsBuffer);
        if (!steps || steps <= 0) return;

        const last = path[path.length - 1];
        const scaledDistance = steps * STEP_SCALE;

        // --- compute new leg coordinates ---
        const newX = last.x + scaledDistance * Math.sin(currentHeading);
        const newY = last.y - scaledDistance * Math.cos(currentHeading);

        // --- push new leg first ---
        path.push({ 
            x: newX, 
            y: newY, 
            steps: steps
        });
        headings.push(currentHeading);

        // --- compute bounds and VISUAL_SCALE using updated path ---
        const allX = path.map(p => p.x);
        const allY = path.map(p => p.y);
        const minX = Math.min(...allX);
        const maxX = Math.max(...allX);
        const minY = Math.min(...allY);
        const maxY = Math.max(...allY);

        const width = maxX - minX;
        const height = maxY - minY;

        const baseSize = 20;          
        const referenceSize = 200;    
        VISUAL_SCALE = Math.max(4, baseSize * Math.sqrt(width * height) / referenceSize);
        console.log('VISUAL_SCALE:', VISUAL_SCALE);

        // --- reset step buffer and update visuals ---
        stepsBuffer = '';
        updateDirectionArrow();
        updateDisplay();
        drawPath();
        enableSave();
    }

    function undoLeg() {
        if (path.length > 1) {
            path.pop();           // remove last point
            headings.pop();       // remove last heading

            // --- recompute bounds ---
            const allX = path.map(p => p.x);
            const allY = path.map(p => p.y);
            const minX = Math.min(...allX);
            const maxX = Math.max(...allX);
            const minY = Math.min(...allY);
            const maxY = Math.max(...allY);

            const width = maxX - minX;
            const height = maxY - minY;

            // --- recompute VISUAL_SCALE dynamically ---
            const baseSize = 20;       // starting base size
            const referenceSize = 200; // designed reference width/height
            VISUAL_SCALE = Math.max(4, baseSize * Math.sqrt(width * height) / referenceSize);

            // --- update visuals ---
            updateDirectionArrow();
            drawPath();
            enableSave();
        }
    }

    function backspace() {
        stepsBuffer = stepsBuffer.slice(0, -1);
        updateDisplay();
    }

    function addDigit(digit) {
        stepsBuffer += digit;
        updateDisplay();
    }

    /* -----------------------------
        Event Delegation (Footer)
    ----------------------------- */

    footer.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;

        if (btn.dataset.direction) {
        turn(btn.dataset.direction);
        return;
        }

        if (btn.dataset.number !== undefined) {
        addDigit(btn.dataset.number);
        return;
        }

        if (btn.textContent.trim() === 'Enter') {
        addLeg();
        return;
        }

        if (btn.textContent.trim() === '⌫') {
        backspace();
        return;
        }
    });

    /* -----------------------------
        Header Undo Button
    ----------------------------- */

    if (undoBtn) {
        undoBtn.addEventListener('click', undoLeg);
    }

    /* -----------------------------
        Init
    ----------------------------- */

    updateDisplay();

})();
</script>

{% endblock %}