function openPlacementMenu(card) {
    const wrapper = card.querySelector('.dots-wrapper');
    if (!wrapper) return;

    const modal = wrapper.querySelector('.dots-modal');
    const textEl = modal.querySelector('.modal-text');
    const mapItemBtn = modal.querySelector('#mapItem');
    const groupItemBtn = modal.querySelector('#groupItem');

    // read placement status from data attribute or JS variable
    const status = card.dataset.placementStatus; // 'system', 'confirmed', 'provisional', 'group', 'none'

    // reset buttons
    mapItemBtn.style.display = 'inline-block';
    groupItemBtn.style.display = 'inline-block';
    console.log(status)

    switch (status) {
        case 'system':
        case 'confirmed':
            textEl.textContent = "This item has already been placed. Does it belong somewhere else?";
            mapItemBtn.textContent = "Place somewhere else";
            groupItemBtn.style.display = 'none'; // optional, only 1 action
            break;
        case 'provisional':
            textEl.textContent = "This item has been placed by another user.";
            mapItemBtn.textContent = "Confirm placement";
            groupItemBtn.textContent = "Place somewhere else";
            break;
        case 'group':
            textEl.textContent = "This is an approximate location based on similar items. Can you confirm it for us?";
            mapItemBtn.textContent = "Confirm location";
            groupItemBtn.style.display = 'Place somewhere else';
            break;
        case 'none':
        default:
            textEl.textContent = "We don’t know where this item belongs.";
            mapItemBtn.textContent = "Place On Map";
            groupItemBtn.textContent = "Place With Similar Item";
            break;
    }

    wrapper.classList.add('active');

    // close when clicking outside
    const closeOutside = (e) => {
        if (!wrapper.contains(e.target)) {
            wrapper.classList.remove('active');
            document.removeEventListener('click', closeOutside);
        }
    };
    document.addEventListener('click', closeOutside);

    // wire buttons
    mapItemBtn.onclick = () => {
        wrapper.classList.remove('active');
        document.removeEventListener('click', closeOutside);

        const itemEl = mapItemBtn.closest('.shopping-card');

        openPlacementModal(itemEl);
    };

    groupItemBtn.onclick = () => {
        wrapper.classList.remove('active');
        document.removeEventListener('click', closeOutside);
        const itemEl = mapItemBtn.closest('.shopping-card');

        openPlacementModal(itemEl);
    };
}

function enqueuePick(itemId) {
    pickQueue.push(itemId);
    processPickQueue();
}

async function processPickQueue() {
    if (processingQueue) return;
    processingQueue = true;

    while (pickQueue.length > 0) {
        const id = pickQueue.shift();

        try {
            await fetch(`/shoppinglist/ajax/pick/${id}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                }
            });
        } catch (e) {
            // console.error('Failed to mark item as picked', id);
            // optional: stash failed IDs for retry
        }
    }

    processingQueue = false;
}

