{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
<div class="d-flex flex-column mb-4 border-bottom pb-3">

    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left -->
            <div class="d-flex align-items-center">
                <button id="menu-button" class="btn-dark-base" aria-label="Open menu"><i class="bi bi-list-ul"></i></button>
            </div>

            <!-- Center -->
            <h6>{{ supermarket.type.value }} - {{ supermarket.suburb }}</h6>
            <div class="flex-grow-1 d-flex justify-content-center">
                <select id="phaseSelector">
                    <option value="1">Entrance Phase</option>
                    <option value="2">Post Entrance Phase</option>
                    <option value="3">Main Phase</option>
                    <option value="4">End Phase</option>
                </select>
            </div>

            <!-- Right -->
            <div class="d-flex align-items-center">
                <button id="save-aisle" type="button" class="btn-dark-base border-yellow">
                    <i class="bi bi-signpost"></i>
                </button>

                <form method="POST" action="/supermarket/{{ supermarket.id }}/edges/save"
                    id="edgesForm" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="edges" id="edgesInput">
                    <input type="hidden" name="nodes" id="nodesInput">
                    <button type="submit" class="btn-dark-base border-green"><i class="bi bi-check-lg"></i></button>
                </form>
            </div>
        </div>
    </div>

    
    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close" aria-label="Close menu">×</button>
        <ul>
            <li>
                <button id="remove-aisles" type="button">Remove Aisles</button>
            </li>
            <li class="desktop-only">
                <a href="{{ path('app_supermarket_index') }}">Supermarkets</a>
            </li>
            <li class="desktop-only">
                <a href="{{ path('app_home') }}">Shopping List</a>
            </li>
        </ul>
    </nav>
</div>

<div 
    id="supermarket-wrapper" 
    data-supermarket-id="{{ supermarket.id }}"  
    data-nodes="{{ nodes|json_encode|e('html_attr') }}"
    data-edges="{{ edges|json_encode|e('html_attr') }}"
    data-walking-path='{{ supermarket.scaledPathData|json_encode }}'
>
    <svg
        id="overlay"
        viewBox="0 0 {{ supermarket.width }} {{ supermarket.height }}"
        preserveAspectRatio="xMidYMid meet"
    >
    </svg>
</div>



<style>
    #supermarket-wrapper {
        position: relative;
        width: 100vw;
        height: calc(100vh - 140px); /* leave room for header */
        overflow: hidden;
    }

    #overlay {
        width: 100%;
        height: 100%;
        display: block;
    }
    .node {
        fill: #0d6efd;
        cursor: pointer;
    }      

    .node-selected {
        fill: orange;
        stroke: black;
        stroke-width: 2;
    }

    .edge {
        stroke-width: 5;
        cursor: pointer;
    }

    .edge:hover {
        stroke-width: 6;
    }

    .edge.selected {
        stroke-width: 7;
        stroke-dasharray: 6 4; /* optional but very nice */
    }

    .aisle {
        filter: drop-shadow(0 0 3px white);
    }

</style>
<script>

const wrapper = document.getElementById('supermarket-wrapper');
const svg = document.getElementById('overlay');
const phaseSelector = document.getElementById('phaseSelector');
const nodesData = JSON.parse(wrapper.dataset.nodes);
const edgeData = JSON.parse(wrapper.dataset.edges);
const supermarketId = JSON.parse(wrapper.dataset.supermarketId);
const walkingPath = JSON.parse(wrapper.dataset.walkingPath || '[]');
const SVG_NS = 'http://www.w3.org/2000/svg';

const nodes = {};   // id -> { id, x, y, element }
const edges = [];
const STROKE_WIDTH = 10; // default

let selectedNode = null;

const pathLayer = document.createElementNS(SVG_NS, 'g');
pathLayer.setAttribute('id', 'path-layer');
svg.appendChild(pathLayer);


/* -----------------------------
    * Load & draw nodes
    * ----------------------------- */
nodesData.forEach(n => {
    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    circle.setAttribute('cx', n.x);
    circle.setAttribute('cy', n.y);
    circle.setAttribute('r', 5);
    circle.classList.add('node');
    svg.appendChild(circle);

    nodes[n.id] = {
        ...n,
        element: circle,
        uuid: uuid()
    };
});

function createNode(x, y) {
    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', 5);
    circle.classList.add('node');

    svg.appendChild(circle);

    const nodeUuid = crypto.randomUUID();

    const node = {
        id: null,      // not in DB yet
        uuid: nodeUuid,
        x,
        y,
        element: circle
    };

    nodes[nodeUuid] = node; // key by UUID, not id
}

// optionally find node by either id or uuid
function getNode(key) {
    // key can be either id or uuid
    return nodes[key] || Object.values(nodes).find(n => n.uuid === key);
}


edgeData.forEach(e => {
    e.selected = false; // <-- add selected state
    const line = drawEdge(e);
    e.element = line;
    edges.push(e); // Prefill edges array so these are resubmitted with any changes
});

drawPathLine(walkingPath);

console.log(nodes, edges)

document.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        undoLastEdge();
    }
});

function undoLastEdge() {
    if (edges.length === 0) return;
    const last = edges.pop();
    last.element.remove();
}



function moveNode(dx, dy) {
    selectedNode.x += dx;
    selectedNode.y += dy;

    selectedNode.element.setAttribute('cx', selectedNode.x);
    selectedNode.element.setAttribute('cy', selectedNode.y);
}

// COPIED FROM FLOORPLAN EDIT
function drawPathLine(walkingPath) {
    const polyline = document.createElementNS(
        SVG_NS,
        'polyline'
    );

    const pointString = walkingPath
        .map(p => `${p.x},${p.y}`)
        .join(' ');

    polyline.setAttribute('points', pointString);
    polyline.setAttribute('fill', 'none');
    polyline.setAttribute('stroke', '#ff4444');
    polyline.setAttribute('stroke-width', '1');
    polyline.setAttribute('pointer-events', 'none');
    polyline.setAttribute('stroke-dasharray', '2 4');
    polyline.classList.add('path-line');
    pathLayer.appendChild(polyline);

    return polyline;
}

function drawEdge(edge) {
    // Ensure the edge has a selected property
    if (typeof edge.selected === 'undefined') {
        edge.selected = false;
    }

    const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');

    line.setAttribute('x1', edge.x1);
    line.setAttribute('y1', edge.y1);
    line.setAttribute('x2', edge.x2);
    line.setAttribute('y2', edge.y2);

    line.classList.add('edge');
    line.dataset.id = edge.id;
    line.dataset.phase = edge.phase;

    const colorMap = {
        '1': '#4caf50', // green
        '2': '#2196f3', // blue
        '3': '#ff9800', // orange
        '4': '#9c27b0'  // purple
    };

    line.setAttribute('stroke', colorMap[edge.phase] || '#999');
    line.setAttribute('stroke-width', STROKE_WIDTH);
    if(edge.aisleKey) {
        line.classList.add('aisle');
    }

    // Click listener toggles selection
    line.addEventListener('click', () => {
        edge.selected = !edge.selected;                     // update JS state
        line.classList.toggle('selected', edge.selected);   // visual highlight
        console.log('Edge:', edge)
    });

    // Insert behind nodes
    svg.insertBefore(line, svg.firstChild);

    return line;
}

svg.addEventListener('click', e => {
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    const { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

    const nearest = findNearestNode(x, y);
    if (!nearest) return;

    console.log('Node:', nearest);

    if (!selectedNode) {
        selectNode(nearest);
        return;
    }

    if (selectedNode.id === nearest.id) {
        clearSelection();
        return;
    }

    createEdge(selectedNode, nearest);
    clearSelection();
});

function createEdge(a, b) {
    if (edgeExists(a, b)){
        alert('Edge exists already.');

        return;

    } 
    const blockingNode = Object.values(nodes).find(n =>
        n.id !== a.id &&
        n.id !== b.id &&
        nodeOnSegment(a, b, n)
    );

    if (blockingNode) {
        alert('An intermediate node exists on this edge. Connect through that node instead.');
        return;
    }

    const edge = {
        id: null,
        from: a.id,
        to: b.id,
        x1: a.x,
        y1: a.y,
        x2: b.x,
        y2: b.y,
        phase: phaseSelector.value,
        selected: false,
        element: null,
        aisleKey: null,
    };

    const line = drawEdge(edge);
    edge.element = line; // add this in now for reference by undoLastEdge()
    edges.push(edge);
}

function findNearestNode(x, y, maxDistance = 20) {
    let nearest = null;
    let minDist = Infinity;

    Object.values(nodes).forEach(node => {
        const dx = node.x - x;
        const dy = node.y - y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < minDist) {
            minDist = dist;
            nearest = node;
        }
    });

    return minDist <= maxDistance ? nearest : null;
}

function selectNode(node) {
    selectedNode = node;
    node.element.classList.add('node-selected');
}

function clearSelection() {
    if (selectedNode) {
        selectedNode.element.classList.remove('node-selected');
        selectedNode = null;
    }
}

function edgeExists(a, b) {
    return edges.some(e =>
        (e.from === a.id && e.to === b.id) ||
        (e.from === b.id && e.to === a.id)
    );
}

function nodeOnSegment(a, b, n, tolerance = 1) {
    const cross =
        (b.x - a.x) * (n.y - a.y) -
        (b.y - a.y) * (n.x - a.x);

    if (Math.abs(cross) > tolerance) return false;

    const dot =
        (n.x - a.x) * (b.x - a.x) +
        (n.y - a.y) * (b.y - a.y);

    if (dot < 0) return false;

    const lenSq =
        (b.x - a.x) ** 2 +
        (b.y - a.y) ** 2;

    if (dot > lenSq) return false;

    return true;
}

const aisleSaveButton = document.getElementById('save-aisle');
aisleSaveButton.addEventListener('click', () => {
    let edgeSelected = false;
    edges.forEach(edge => {
        if (edge.selected) {
            edgeSelected = true;
            edge.aisleKey = true;
        }
    });

    if(!edgeSelected || edges.length === 0) {
        alert('Select at least one edge to save as an aisle');
        return;
    }

    // Populate hidden input here if needed
    const payload = edges.map(({ element, ...data }) => data);
    document.getElementById('edgesInput').value = JSON.stringify(payload);

    // Submit the form directly
    document.getElementById('edgesForm').submit();
});

const removeAislesButton = document.getElementById('remove-aisles');
removeAislesButton.addEventListener('click', () => {
    if (!confirm('Are you sure you want to remove all aisle keys in this supermarket?')) return;

    // Create a temporary form
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/supermarket/${supermarketId}/clear-aisles`; // backend route

    document.body.appendChild(form);
    form.submit(); // this triggers a full page request and follows backend redirect
});


phaseSelector.addEventListener('change', () => {
    const newPhase = phaseSelector.value;
    if (!newPhase) return;

    const colorMap = { 
        '1': '#4caf50',   // green
        '2': '#2196f3',   // blue
        '3': '#ff9800',   // orange
        '4': '#9c27b0'    // purple
    };

    edges.forEach(edge => {
        if (edge.selected) {
            edge.phase = newPhase;

            const line = svg.querySelector(`.edge[data-id="${edge.id}"]`);
            if (line) {
                line.dataset.phase = newPhase;
                line.setAttribute('stroke', colorMap[newPhase]);
            }

        }
    });

    // ✅ DESELECT ALL EDGES
    edges.forEach(edge => edge.selected = false);
        svg.querySelectorAll('.edge.selected').forEach(line => {
        line.classList.remove('selected');
    });
});

document.getElementById('edgesForm').addEventListener('submit', (event) => {
    if (!window.edges) {
        window.edges = []; // fallback if edges not defined
    }

    // Make sure we actually have edges
    const edgesPayload = edges.map(({ element, ...data }) => data); // basically, pull out the element property
    const nodesPayload = Object.values(nodes).map(n => ({id: n.id, x: n.x, y: n.y}));

    document.getElementById('edgesInput').value = JSON.stringify(edgesPayload);
    document.getElementById('nodesInput').value = JSON.stringify(nodesPayload);

    // Optional: prevent empty submission
    if (edges.length === 0) {
        event.preventDefault();
        alert('No edges to save!');
    }
});

// find edges with a node in the middle of them. (delete these if found)
{# SELECT 
    e.id AS edge_id,
    n.id AS node_on_edge
FROM edge e
JOIN node a ON a.id = e.start_id
JOIN node b ON b.id = e.end_id
JOIN node n 
    ON n.supermarket_id = e.supermarket_id
    AND n.id NOT IN (e.start_id, e.end_id)
WHERE e.supermarket_id = :supermarketId

AND ABS(
    (b.x_value - a.x_value) * (n.y_value - a.y_value) -
