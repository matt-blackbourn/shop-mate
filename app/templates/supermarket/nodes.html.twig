{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
  <div class="d-flex flex-column mb-4 border-bottom pb-3">

        {# Top row: title + back button + save form #}
        <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-3">
                <h1 class="h4 mb-0">{{ supermarket.name }}</h1>

                <a href="{{ path('app_supermarket_index') }}"
                class="btn btn-outline-secondary btn-sm">
                    ← Back to list
                </a>
            </div>

            <div class="d-flex align-items-center gap-2">
                <label for="snapDistance">Snap Distance:</label>
                <select id="snapDistance">
                    <option value="5">5 px</option>
                    <option value="10">10 px</option>
                    <option value="15">15 px</option>
                    <option value="20">20 px</option>
                    <option value="30" selected>30 px</option>
                    <option value="50">50 px</option>
                </select>
                <span id="node-count" class="badge bg-secondary">0 nodes</span>

                <!-- Right buttons, inline with title -->
                <button id="undo-node" type="button" class="btn btn-outline-secondary btn-sm">
                    Undo last node
                </button>

                {# Save nodes form #}
                <form method="POST" action="/supermarket/{{ supermarket.id }}/nodes/save"
                    id="nodesForm" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="nodes" id="nodesInput">

                    <button id="save-nodes" type="submit" class="btn btn-primary btn-sm">
                        💾 Save nodes
                    </button>
                </form>
            </div>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show mt-2 mb-0" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

    </div>

    <div id="supermarket-wrapper" data-supermarket-id="{{ supermarket.id }}" data-nodes="{{ nodes|json_encode|e('html_attr') }}">
        <img
            id="supermarket-img"
            src="{{ asset('uploads/supermarkets/' ~ supermarket.imagePath) }}"
            width="{{ supermarket.width }}"
            height="{{ supermarket.height }}"
            alt="Floor plan"
        >
        {# top left = 0,0 #}
        <svg
            id="overlay"
            width="{{ supermarket.width }}"
            height="{{ supermarket.height }}"
            viewBox="0 0 {{ supermarket.width }} {{ supermarket.height }}"
            preserveAspectRatio="none"
        >
        </svg>
    </div>

<style>
    #supermarket-wrapper {
        position: relative;
        display: inline-block;
    }
    #overlay {
        position: absolute;
        top: 0;
        left: 0;
    }
    .node {
        fill: #0d6efd;
        stroke: white;
        stroke-width: 2;
    }
    .guide {
        stroke: rgba(0, 200, 0, 0.35);
        stroke-dasharray: 4 3;
        pointer-events: none;
    }

</style>
<script>
    const svg = document.getElementById('overlay');
    const nodes = []; // { x, y, element }
    const nodeCountEl = document.getElementById('node-count');
    const saveBtn = document.getElementById('save-nodes');

    const wrapper = document.getElementById('supermarket-wrapper');
    const nodesData = JSON.parse(wrapper.dataset.nodes);

    // Store shared X and Y coordinates
    const sharedX = new Set();
    const sharedY = new Set();

    // Configurable snap distance (pixels)
    let SNAP_DISTANCE = 30; // default
    const snapSelect = document.getElementById('snapDistance');
    snapSelect.addEventListener('change', (e) => {
        SNAP_DISTANCE = parseInt(e.target.value, 10);
    });

    // on page load: draw the existing nodes and fill the array
    nodesData.forEach(n => {
        const circle = drawNode(n.x, n.y);
        n.element = circle;
        nodes.push(n);
        updateNodeCount();
    });


    function createNode(x, y) {
        const circle = drawNode(x, y);
        const node = {
            id: null, 
            x: x, 
            y: y, 
            element: circle
        }
        nodes.push(node);
        updateNodeCount();
    }

    function drawNode(x, y) {
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');

        circle.setAttribute('cx', x);
        circle.setAttribute('cy', y);
        circle.setAttribute('r', SNAP_DISTANCE/2);
        circle.classList.add('node');

        svg.appendChild(circle);

        return circle;
    }


    // state for direction locking + guides
    let lastNode = null;
    let directionLock = null; // 'horizontal' | 'vertical' | null
    const LOCK_THRESHOLD = 6;
    let guideLineX = null;
    let guideLineY = null;

    svg.addEventListener('click', (e) => {
        // Ignore clicks on existing nodes
        if (e.target.tagName !== 'svg') return;

        const pt = svg.createSVGPoint();
        pt.x = e.clientX;
        pt.y = e.clientY;

        //  SVG coordinate transform
        let { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

         // Apply direction lock
        if (lastNode) {
            if (directionLock === 'horizontal') y = lastNode.y;
            if (directionLock === 'vertical') x = lastNode.x;
        }

        // snap to shared X / Y coordinates
        ({ x, y } = snapToSharedCoordinates(x, y));

        createNode(x, y);

        // Shift-click declares this node's X and Y as shared
        if (e.shiftKey) {
            sharedX.add(x);
            sharedY.add(y);
        }

        // Reset for next segment
        directionLock = null;

        updateNodeCount();
    });

// mousemove for direction locking + snapping
    svg.addEventListener('mousemove', (e) => {
        if (!lastNode) return;

        const pt = svg.createSVGPoint();
        pt.x = e.clientX;
        pt.y = e.clientY;

        let { x, y } = pt.matrixTransform(svg.getScreenCTM().inverse());

        const dx = Math.abs(x - lastNode.x);
        const dy = Math.abs(y - lastNode.y);

        // 🔒 Decide direction once
        if (!directionLock && (dx > LOCK_THRESHOLD || dy > LOCK_THRESHOLD)) {
            directionLock = dx > dy ? 'horizontal' : 'vertical';
        }

        // 🔒 Apply direction lock
        if (directionLock === 'horizontal') {
            y = lastNode.y;
        } else if (directionLock === 'vertical') {
            x = lastNode.x;
        }

        // 🧲 Snap to shared coordinates (non-locked axis)
        if (directionLock !== 'vertical') {
            for (const sy of sharedY) {
                if (Math.abs(y - sy) <= SNAP_DISTANCE) {
                    y = sy;
                    break;
                }
            }
        }


        if (directionLock !== 'horizontal') {
            for (const sx of sharedX) {
                if (Math.abs(x - sx) <= SNAP_DISTANCE) {
                    x = sx;
                    break;
                }
            }
        }
    });

    function snapToSharedCoordinates(x, y) {
        let snappedX = x;
        let snappedY = y;

        // Snap X
        for (const sx of sharedX) {
            if (Math.abs(x - sx) <= SNAP_DISTANCE) {
                snappedX = sx;
                break;
            }
        }

        // Snap Y
        for (const sy of sharedY) {
            if (Math.abs(y - sy) <= SNAP_DISTANCE) {
                snappedY = sy;
                break;
            }
        }

        return { x: snappedX, y: snappedY };
    }

    document.getElementById('undo-node').addEventListener('click', () => {
        undoLastNode();
    });

    function updateNodeCount() {
        nodeCountEl.textContent = `${nodes.length} nodes`;
        saveBtn.disabled = nodes.length === 0;
    }

    function undoLastNode() {
        if (nodes.length === 0) return;

        const last = nodes.pop();
        last.element.remove();
        updateNodeCount(); 
    }

    const form = document.getElementById('nodesForm');
    const nodesInput = document.getElementById('nodesInput');

    form.addEventListener('submit', (e) => {
        // convert nodes array to simple [{x,y},{x,y}] format
        const payload = nodes.map(n => ({ 
            id: n.id,
            x: n.x, 
            y: n.y 
        }));
        nodesInput.value = JSON.stringify(payload);
    });

  
    </script>

{% endblock %}
