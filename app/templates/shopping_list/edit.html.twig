{% extends 'base.html.twig' %}

{% block title %}Edit Shopping List{% endblock %}

{% block body %}

   
<div class="container py-3">

    {{ form_start(form) }}

    <!-- Sticky header: page-level actions -->
    <div class="sticky-top bg-white border-bottom z-3">
        <div class="d-flex align-items-center px-2 py-2">

            <button class="menu-button" aria-label="Open menu">
                ☰
            </button>
            <div class="menu-overlay" hidden></div>

            <!-- Side menu -->
            <nav class="side-menu" hidden>
                <button type="button" class="menu-close" aria-label="Close menu">×</button>
                <ul>
                    <li>
                        <a href="{{ path('app_food_item_new') }}">Add food</a>
                    </li>
                    <li>
                        <a href="{{ path('admin_assign_food_edges', {id: 1}) }}">Map food</a>
                    </li>
                    <li>
                        <a href="{{ path('app_supermarket_index') }}">Supermarkets</a>
                    </li>
                </ul>
            </nav>

            <!-- Heading -->
            <h1 class="h6 mb-0 text-center flex-grow-1">
                My Shopping List
            </h1>

            <!-- Go shopping (primary action) -->
            <button
                type="submit"
                name="intent"
                value="go_shopping"
                class="btn btn-success btn-sm d-flex align-items-center gap-1 px-3 shadow-sm"
                title="Save changes and start shopping"
            >
                <i class="bi bi-cart-fill"></i>
                <span class="d-none d-sm-inline">Go shopping</span>
            </button>

        </div>
    </div>

    <!-- Spacer so content doesn't slide under sticky header -->
    {# <div class="sticky-spacer"></div> #}

<div class="px-2">
    <div class="d-flex gap-2 mb-3">
        <button
            type="button"
            id="add-item"
            class="btn btn-primary flex-grow-1"
        >
            <i class="bi bi-plus"></i>
            Add item
        </button>

        <button
            type="button"
            id="save-list"
            class="btn btn-outline-secondary"
            disabled
            title="Save changes"
        >
            <i class="bi bi-save"></i>
        </button>
    </div>
    </div>


    <div
        id="listItems"
        class="d-flex flex-column gap-2"
        data-prototype="{{ form_widget(form.listItems.vars.prototype)|e('html_attr') }}"
    >
        {% for itemForm in form.listItems %}
        <div class="card list-item collapsed">
            <div class="card-body p-2">

                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between item-header">
                    <div class="fw-semibold food-label">
                        New item
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-item">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>

                <!-- Collapsible body -->
                <div class="item-body mt-2">
                    {{ form_widget(itemForm.foodItem, { attr: { class: 'form-select form-select-sm food-select' } }) }}

                    <div class="d-flex align-items-center gap-2 mt-2">

                    <!-- Notes -->
                    <div class="flex-grow-1">
                        {{ form_widget(itemForm.notes, {
                            attr: {
                                class: 'form-control form-control-sm',
                                placeholder: 'Notes'
                            }
                        }) }}
                    </div>

                    <!-- Quantity controls -->
                    <div class="d-flex align-items-center gap-1 qty-control">
                        <button type="button" class="btn btn-sm btn-outline-secondary qty-down">−</button>

                        <span class="fw-semibold qty-display px-2">
                            {{ itemForm.quantity.vars.value ?? 1 }}
                        </span>

                        {{ form_widget(itemForm.quantity, {
                            attr: { class: 'd-none quantity-input', value: itemForm.quantity.vars.value ?? 1 }
                        }) }}

                        <button type="button" class="btn btn-sm btn-outline-secondary qty-up">+</button>
                    </div>

                </div>

                </div>

            </div>
        </div>
        {% endfor %}
        {% do form.listItems.setRendered %}
    </div>

    {{ form_end(form) }}

    {% include 'food_item/_new_food_modal.html.twig' with {
        foodForm: foodForm
    } %}
</div>

<style>
/* Side menu (closed by default) */
.side-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: 70%;
    max-width: 280px;
    background: #ffffff;
    box-shadow: -8px 0 20px rgba(0, 0, 0, 0.08);
    padding: 1.5rem;
}

.side-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.side-menu a {
    display: block;
    padding: 0.75rem 0;
    color: #374151;
    text-decoration: none;
    font-weight: 500;
}

/* Overlay */
.menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(2px);
    z-index: 9;
}

/* Side menu */
.side-menu {
    position: fixed;
    inset: 0 0 0 auto;
    width: 70%;
    max-width: 280px;
    background: #ffffff;
    box-shadow: -8px 0 20px rgba(0, 0, 0, 0.08);
    padding: 1.25rem;
    z-index: 10;
}

/* Close button */
.menu-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    margin-bottom: 1rem;
    cursor: pointer;
}

.menu-button {
     background: none;
    border: none;
    font-size: 1.5rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
}

.list-item.collapsed .item-body {
    display: none;
}
.list-item.collapsed .toggle-item i {
    transform: rotate(-90deg);
}
.toggle-item i {
    transition: transform 0.15s ease;
}
.item-header {
    cursor: pointer;
}
.item-header .food-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.qty-control .btn {
    padding: 0.25rem 0.4rem;
}
.ts-control {
    min-height: 38px;
    padding: 0.375rem 0.75rem;
    flex-wrap: nowrap;
}
.ts-control input {
    width: auto !important;
    min-width: 1ch;
    flex: 1 1 auto;
}
.sticky-spacer {
    height: 56px;
}
.ts-create-food {
    padding: 0.375rem 0.5rem;
    cursor: pointer;
    border-radius: 0.375rem;
}

.ts-create-food:hover {
    background: #f8f9fa;
}

</style>

<script>
const container = document.getElementById('listItems');
let index = {{ form.listItems|length }};

document.getElementById('add-item').addEventListener('click', () => {
    // Get fully-named prototype
    const prototypeHtml = container.dataset.prototype.replace(/__name__/g, index);
    index++;

    // Collapse existing items
    container.querySelectorAll('.list-item').forEach(i => {
        i.classList.remove('expanded');
        i.classList.add('collapsed');
    });

    // Parse prototype
    const temp = document.createElement('div');
    temp.innerHTML = prototypeHtml;

    // Extract Symfony-managed fields
    const foodSelect = temp.querySelector('select');
    const notesInput = temp.querySelector('input[name$="[notes]"]');
    const quantityInput = temp.querySelector('input[name$="[quantity]"]');

    // Defensive checks (optional but wise)
    if (!foodSelect || !notesInput || !quantityInput) {
        console.error('Prototype missing expected fields');
        return;
    }

    // Styling hooks
    foodSelect.classList.add('food-select');
    notesInput.classList.add('form-control', 'form-control-sm');
    quantityInput.classList.add('quantity-input');
    quantityInput.type = 'hidden';

    // Create card wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'card list-item expanded';

    wrapper.innerHTML = `
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between item-header">
                <div class="fw-semibold food-label">New item</div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-item">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            </div>

            <div class="item-body mt-2">
                ${foodSelect.outerHTML}

                <div class="d-flex align-items-center gap-2 mt-2">
                    <div class="flex-grow-1">
                        ${notesInput.outerHTML}
                    </div>
                    <div class="d-flex align-items-center gap-1 qty-control">
                        <button type="button" class="btn btn-sm btn-outline-secondary qty-down">−</button>
                        <span class="fw-semibold qty-display px-2">1</span>
                        ${quantityInput.outerHTML}
                        <button type="button" class="btn btn-sm btn-outline-secondary qty-up">+</button>
                    </div>
                </div>
            </div>
        </div>
    `;

    container.prepend(wrapper);

    // Let Tom Select initialise new selects
    document.dispatchEvent(new Event('collection:add'));
});




// Event delegation
container.addEventListener('change', e => {
    const item = e.target.closest('.list-item');
    if (!item) return;

    // Update food label when select changes
    if (e.target.classList.contains('food-select')) {
        const select = e.target;
        const label = item.querySelector('.food-label');
        label.textContent = select.options[select.selectedIndex]?.text || 'New item';
    }
});

container.addEventListener('click', e => {
    const item = e.target.closest('.list-item');
    if (!item) return;

    // Toggle expand/collapse when header clicked (ignore buttons)
    if (e.target.closest('.item-header') && !e.target.closest('button')) {
        item.classList.toggle('expanded');
        item.classList.toggle('collapsed');
    }

    // Remove item
    if (e.target.closest('.remove-item')) {
        item.remove();
    }

    // Quantity controls
    if (e.target.closest('.qty-up') || e.target.closest('.qty-down')) {
        const input = item.querySelector('.quantity-input');
        const display = item.querySelector('.qty-display');

        let value = parseInt(input.value || 1, 10);
        if (e.target.closest('.qty-up')) value++;
        if (e.target.closest('.qty-down')) value = Math.max(1, value - 1);

        input.value = value;
        display.textContent = value;
    }
});

// On page load: update all labels after DOM ready
document.addEventListener('DOMContentLoaded', () => {
    container.querySelectorAll('.list-item').forEach(item => {
        const select = item.querySelector('.food-select');
        const label = item.querySelector('.food-label');
        if (select && label) {
            label.textContent = select.options[select.selectedIndex]?.text || 'New item';
        }
    });
});

{# TOM select #}
let activeFoodSelect = null;

document.addEventListener('DOMContentLoaded', () => {
    function initFoodSelect(context = document) {
        context.querySelectorAll('select.food-select').forEach(select => {
            if (select.tomselect) return; // prevent double-init

            const ts = new TomSelect(select, {
                create: false,
                maxItems: 1,
                preload: true,
                placeholder: 'Search food…',
                allowEmptyOption: true,
                closeAfterSelect: true,

                render: {
                    no_results(data, escape) {

                        activeFoodSelect = this;

                        const query = escape(data.input);

                        return `
                            <div class="ts-no-results">
                                <div class="text-muted small mb-1">
                                    No foods found
                                </div>
                                <div
                                    class="ts-create-food text-primary"
                                    data-name="${query}"
                                >
                                    ➕ Add "${query}" as a new food
                                </div>
                            </div>
                        `;
                    }
                }
            });

            ts.focus();
            ts.open();
        });
    }

    // Init existing items
    initFoodSelect();

    // Handle Symfony collection add
    document.addEventListener('collection:add', (e) => {
        initFoodSelect(e.target);
    });
});

// Capture clicks on the “Add new food” row
let activeListItemRow = null;
document.addEventListener('click', (e) => {
    const createRow = e.target.closest('.ts-create-food');
    if (!createRow) return;

    const name = createRow.dataset.name || '';

    // Find the parent collection row
    activeListItemRow = createRow.closest('.list-item');

    openAddFoodModal(name);
});


// New food modal
document.addEventListener('submit', async function (e) {
    if (e.target.id !== 'addFoodForm') return;

    e.preventDefault();

    const form = e.target;
    const formData = new FormData(form);

    // Step 1: immediately close modal
    const modalEl = document.getElementById('addFoodModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
    if (modal){
        document.activeElement?.blur(); // make sure nothing is focused when the modal closes
        modal.hide();
    }

    // Step 2: update the row label and collapse it
    
    if (activeListItemRow) {
        // get name from modal form input
        const nameInput = e.target.querySelector('[name$="[name]"]');
        const foodName = nameInput?.value?.trim();
        const label = activeListItemRow.querySelector('.food-label');
        if (label) label.textContent = foodName ? foodName : 'Adding...';

        activeListItemRow.classList.remove('expanded');
        activeListItemRow.classList.add('collapsed');
    }

    // Step 3: send AJAX request in the background
    fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
        }
    })
    .then(async (response) => {
        if (!response.ok) {
            const err = await response.json();
            console.error('Food creation error:', err);
            // Optionally show toast/alert
            return;
        }
        return response.json();
    })
    .then((data) => {
        if (!data) return;

        // Step 3: inject new option into Tom Select
        if (!activeFoodSelect) return;

        activeFoodSelect.addOption({
            value: data.id,
            text: data.label
        });

        activeFoodSelect.setValue(data.id);
        activeFoodSelect.close();

        activeFoodSelect = null;
    })
    .catch(err => console.error('Food creation request failed:', err));
});


{# Open the modal with the pre-filled name #}
function openAddFoodModal(name = '') {
    const modalEl = document.getElementById('addFoodModal');
    if (!modalEl) return;

    const form = modalEl.querySelector('form');
    if (form) {
        form.reset();

        if (name) {
            const nameInput = form.querySelector('input[name$="[name]"]');
            if (nameInput) {
                nameInput.value = name;
            }
        }
    }

    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
}

const menuButton = document.querySelector('.menu-button');
const menu = document.querySelector('.side-menu');
const overlay = document.querySelector('.menu-overlay');
const closeButton = document.querySelector('.menu-close');

function openMenu() {
    menu.hidden = false;
    overlay.hidden = false;
}

function closeMenu() {
    menu.hidden = true;
    overlay.hidden = true;
}

// Prevent default click behavior to avoid form submission
menuButton.addEventListener('click', (e) => {
    e.preventDefault();
    openMenu();
});

closeButton.addEventListener('click', closeMenu);
overlay.addEventListener('click', closeMenu);

// Optional: close menu with Escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeMenu();
    }
});


const form = document.querySelector('form');
const saveButton = document.getElementById('save-list');

let isDirty = false;

// Any change marks the form dirty
form.addEventListener('input', () => {
    if (isDirty) return;

    isDirty = true;
    saveButton.disabled = false;
    saveButton.classList.remove('btn-outline-secondary');
    saveButton.classList.add('btn-outline-primary');
});



// Save handler
saveButton.addEventListener('click', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    const formData = new FormData(form);

    try {
        const response = await fetch(form.action, {
            method: form.method || 'POST',
            body: formData,
        });

        if (!response.ok) {
            throw new Error('Save failed');
        }

        // Saved state
        isDirty = false;
        saveButton.disabled = true;
        saveButton.classList.remove('btn-outline-primary');
        saveButton.classList.add('btn-outline-secondary');
        saveButton.innerHTML = '<i class="bi bi-check-lg"></i>';

        // Reset icon after a moment
        setTimeout(() => {
            saveButton.innerHTML = '<i class="bi bi-save"></i>';
        }, 1500);

    } catch (err) {
        console.error(err);
        alert('Could not save changes. Please try again.');
    }
});



</script>

{% endblock %}
