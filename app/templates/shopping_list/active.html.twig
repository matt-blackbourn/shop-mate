function openPlacementMenu(card) {
    const wrapper = card.querySelector('.placement-wrapper');
    if (!wrapper) return;

    const backdrop = document.getElementById('sheetBackdrop');
    const menu = wrapper.querySelector('.placement-menu');
    const textEl = menu.querySelector('.menu-text');
    const mapItemBtn = menu.querySelector('#mapItem');
    const groupItemBtn = menu.querySelector('#groupItem');

    const status = placementStatuses[card.dataset.id];

    // reset buttons
    mapItemBtn.style.display = 'inline-block';
    groupItemBtn.style.display = 'inline-block';

    switch (status) {
        case 'system':
        case 'confirmed':
            textEl.textContent = "This item already has a confirmed location. Does it belong somewhere else?";
            mapItemBtn.textContent = "Place Somewhere Else";
            groupItemBtn.style.display = 'none';
            break;
        case 'provisional':
            textEl.textContent = "This item has been placed by another user.";
            mapItemBtn.textContent = "Confirm Placement";
            groupItemBtn.style.display = 'none';
            break;
        case 'group':
            textEl.textContent = "This is an approximate location based on similar items. Can you confirm it for us?";
            mapItemBtn.textContent = "Confirm On Map";
            groupItemBtn.style.display = 'none';
            break;
        case 'none':
        default:
            textEl.textContent = "We don’t know where this item belongs.";
            mapItemBtn.textContent = "Place On Map";
            groupItemBtn.textContent = "Place With Another Item";
            break;
    }

    wrapper.classList.add('active');
    backdrop.classList.add('active');

    // ---- CLOSE FUNCTION ----
    const closeMenu = () => {
        wrapper.classList.remove('active');
        backdrop.classList.remove('active');

        menu.style.transform = '';

        backdrop.removeEventListener('click', closeMenu);
        menu.removeEventListener('touchstart', handleTouchStart);
        menu.removeEventListener('touchmove', handleTouchMove);
        menu.removeEventListener('touchend', handleTouchEnd);
    };

    backdrop.addEventListener('click', closeMenu);

    // ---- SWIPE DOWN TO CLOSE ----
    let startY = 0;
    let currentY = 0;
    let isDragging = false;

    const handleTouchStart = (e) => {
        startY = e.touches[0].clientY;
        isDragging = true;
        menu.style.transition = 'none'; // follow finger exactly
    };

    const handleTouchMove = (e) => {
        if (!isDragging) return;

        currentY = e.touches[0].clientY;
        const diff = currentY - startY;

        if (diff > 0) {
            menu.style.transform = `translateY(${diff}px)`;
        }
    };

    const handleTouchEnd = () => {
        if (!isDragging) return;
        isDragging = false;

        const diff = currentY - startY;

        menu.style.transition = 'transform 0.25s ease';

        if (diff > 100) {
            closeMenu();
        } else {
            menu.style.transform = '';
        }

        startY = 0;
        currentY = 0;
    };

    menu.addEventListener('touchstart', handleTouchStart);
    menu.addEventListener('touchmove', handleTouchMove);
    menu.addEventListener('touchend', handleTouchEnd);

    // ---- BUTTON HANDLERS ----
    mapItemBtn.onclick = () => {
        closeMenu();
        setMapMode(MAP_MODE_PLACEMENT);
        openMapModal(mapItemBtn.closest('.shopping-card'));
    };

    groupItemBtn.onclick = () => {
        closeMenu();
        openGroupingModal(groupItemBtn.closest('.shopping-card'));
    };
}

async function processPickQueue() {
    if (processingQueue) return;
    processingQueue = true;

    while (pickQueue.length > 0) {
        const listItemId = pickQueue.shift();

        // need to send the current node to the server unless this item was picked out of order
        const currentNodeId = routeState.currentItem.itemId == listItemId ? routeState.segments[routeState.currentSegment].targetNodeId : null;

        try {
            await fetch(`/shoppinglist/ajax/pick`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    listItemId: listItemId,
                    supermarketId: supermarketId,
                    currentNodeId: currentNodeId
                })
            });
        } catch (e) {
            // optional retry handling
        }
    }

    processingQueue = false;
    updateUnpickButtonState();
}


function pickItemById(itemId) {
    removeCardFromList(itemId);

    pickQueue.push(itemId);
    updateUnpickButtonState(); // Dont allow unpicking while we have pending picks to process
    
    updateRouteState(itemId);
    updateMapView();
    highlightItemOnMap();
    rotateMap()

    // Clear any existing timer
    if (pickQueueTimer) {
        clearTimeout(pickQueueTimer);
    }

    // Set a new timer
    pickQueueTimer = setTimeout(() => {
        processPickQueue();
        pickQueueTimer = null; // optional cleanup
    }, 1500);

    updateUnpickButtonState();
}

function skipItemById(itemId) {
    removeCardFromList(itemId);
    updateRouteState(itemId);
    updateMapView();
    highlightItemOnMap();
    rotateMap()
}

function removeCardFromList(itemId){
    const card = document.querySelector(`.shopping-card[data-id="${itemId}"]`);
    if(!card) return;

    card.style.transition = 'transform 0.2s ease, opacity 0.2s ease';
    card.style.transform = 'translateX(-120%)';
    card.style.opacity = '0';
    setTimeout(() => card.remove(), 200); // Remove from DOM after animation
}

function updateRouteState(itemId){
    // Record the pick
    const id = Number(itemId);
    routeState.pickedItemIds.add(id);

    // Record physical location of user in placement state in case of placement made mid-shop
    const segmentIndex = routeState.segments.findIndex( s => s.itemId === id);
    placementState.currentNodeId = routeState.segments[segmentIndex].targetNodeId;

    // Update current segment if needed
    if (segmentIndex === routeState.currentSegment) {
        const nextSegment = routeState.segments.findIndex(
            s => !routeState.pickedItemIds.has(s.itemId)
        );

        routeState.currentSegment = nextSegment === -1 ? routeState.segments.length : nextSegment;
    }
}

