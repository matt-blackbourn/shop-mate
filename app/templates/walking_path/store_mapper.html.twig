{% extends 'base.html.twig' %}

{% block title %}Store Mapper{% endblock %}

{% block body %}

<div class="mapper-page d-flex flex-column">

    <!-- HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left: Menu -->
            <div class="header-left d-flex align-items-center">
                <button class="menu-button" aria-label="Open menu">☰</button>
            </div>

            <!-- Center: Title -->
            <div class="header-center flex-grow-1 text-center fw-semibold">
                  <div class="mapping-steps">
                    <span id="stepPerimeter">Perimeter</span> →
                    <span id="stepAisles">Aisles</span>
                </div>
            </div>

            <!-- Right: Save -->
            <div class="header-right d-flex align-items-center">
            
                <button type="button" id="phaseButton" class="btn-dark-base border-green">
                    NEXT
                </button>
            </div>
        </div>
    </div>

    <!-- MENU (outside header for z-index safety) -->
    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close">×</button>
        <ul>
            <li><a href="{{ path('app_home') }}">Back to List</a></li>
            <li><button type="button" id="clearSession">Clear Session</button></li>
        </ul>
    </nav>

    <!-- BODY (MAP) -->
    <div class="page-body">
        <div class="mapper-map-container">
            <svg class="mapper-svg"></svg>

        </div>
    </div>

    <!-- FOOTER (NUMBERPAD CONTROLS) -->
    <div class="mapper-footer">

        <div class="mapper-actions">
            <div class="mapper-display"><span id="stepDisplay">0</span></div>
            <button class="btn-dark-base border-yellow" data-direction="right"><i class="bi bi-arrow-90deg-right"></i></i></i></button>
            <button class="btn-dark-base border-green">Enter</button>
        </div>

        <!-- Number Pad -->
        <div class="mapper-numpad">
            {% for n in [1,2,3,4,5,6,7,8,9] %}
                <button class="btn-dark-base" data-number="{{ n }}">{{ n }}</button>
            {% endfor %}
            <button class="btn-dark-base">⌫</button>
            <button class="btn-dark-base" data-number="0">0</button>
            <button type="button" class="btn-dark-base"><i class="bi bi-arrow-counterclockwise"></i></button>

        </div>

    </div>

</div>

{# Modal form for submission #}
<div class="modal fade" id="walkingPathModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="walkingPathForm">
                <div class="modal-header">
                    <h5 class="modal-title">Submit Floor Plan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                {{ form_start(form) }}
                <div class="modal-body">
                    {{ form_row(form.supermarketType) }}
                    {{ form_row(form.suburb) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
                {{ form_end(form) }}
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="phaseModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-body text-center p-4">

                <h5 id="phaseTitle"></h5>
                <p id="phaseDescription" class="small"></p>

                <button class="btn btn-primary w-100 mt-3" data-bs-dismiss="modal">Got it</button>

            </div>
        </div>
    </div>
</div>


<style>
.mapper-page {
    height: 100dvh;   /* important for mobile */
    background: #1c212b;
    color: #e9ecef;
    display: flex;
    flex-direction: column;
}

/* HEADER */
.page-header {
    background-color: #2b303b;
    border-bottom: 1px solid #343a46;
    position: sticky;
    top: 0;
    z-index: 1030;
}

.header-btn {
    background: #1c212b;
    color: #e9ecef;
    border: 1px solid #343a46;
}

.header-btn:hover {
    background: #343a46;
}

/* BODY */
.page-body {
    flex: 1;
    min-height: 0;      /* CRITICAL */
    overflow: hidden;
    position: relative;
}

.mapper-map-container {
    position: absolute;
    inset: 0;
}

.mapper-svg {
    width: 100%;
    height: 100%;
}

.mapper-arrow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    transform-origin: 50% 50%;
    pointer-events: none;
}

/* FOOTER */
.mapper-footer {
    background: #2b303b;
    border-top: 1px solid #343a46;

    height: 30dvh;          /* 👈 controlled size */
    max-height: 420px;      /* safety cap for large phones */

    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
}

/* Display */
.mapper-display {
    background: #11151c;
    border: 1px solid #343a46;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 18px;
    text-align: right;
    font-weight: bold;

    display: flex;
    justify-content: center;
    text-align: center;
    color: #51cf66;

    width: 100%;
    height: 100%;
}

.mapper-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    align-items: stretch;
}


/* Numpad */
.mapper-numpad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 1fr); /* force 4 even rows */
    gap: 6px;
    flex: 1;  
}


/* temporary highlight state */
.btn-dark-base.clicked {
    background-color: #fab005; /* yellow highlight */
    color: #000;               /* optional text color change */
}

.mapper-svg {
    transition: transform 1s ease;
}



</style>

<script>
(function() {

    const SVG_NS = "http://www.w3.org/2000/svg";
    const svg = document.querySelector('.mapper-svg');
    const pathLayer = document.createElementNS(SVG_NS, 'g');
    pathLayer.classList.add('path-layer');
    svg.appendChild(pathLayer);
    svg.setAttribute('viewBox', '-150 -150 300 300');

    const stepDisplay = document.getElementById('stepDisplay');
    const footer = document.querySelector('.mapper-footer');
    const undoBtn = document.querySelector('.bi-arrow-counterclockwise')?.closest('button');
    const saveBtn = document.getElementById('save-map');
    const STEP_SCALE = 20; // pixels per step
    let VISUAL_SCALE = 20;

    const PHASE_PERIMETER = 1;
    const PHASE_AISLES = 2;
    const PHASE_FINAL = 3;
    let pathClass = 'perimeter-path';

    let currentPhase = PHASE_PERIMETER;

    let directionArrow; // persistent arrow group
    let mapRotation = 0;
    let stepsBuffer = '';
    let path = [{ x: 0, y: 0, steps: 0, phase: PHASE_PERIMETER }]; // start at origin with 0 steps
    let headings = [0];
    let currentHeading = 0;
    let hasChanges = false;
    let rotateTimer = null;

    createDirectionArrow();

    document.addEventListener('DOMContentLoaded', () => {
        restoreFromLocalStorage();
        showPhaseModal(currentPhase);
    });

    document.querySelector('#clearSession').addEventListener('click', clearMappingSession);

    // button highlight on click (temporary visual feedback)
    document.querySelectorAll('.btn-dark-base').forEach(btn => {
        btn.addEventListener('click', () => {
            btn.classList.add('clicked');
            setTimeout(() => btn.classList.remove('clicked'), 50);
        });
    });

    function createDirectionArrow() {
        directionArrow = document.createElementNS(SVG_NS, 'g');
        directionArrow.classList.add('direction-arrow');

        // Arrow line
        const line = document.createElementNS(SVG_NS, 'line');
        line.setAttribute('x1', 0);
        line.setAttribute('y1', 0);
        line.setAttribute('x2', 20); // initial length, will be scaled
        line.setAttribute('y2', 0);
        
        line.setAttribute('stroke-width', VISUAL_SCALE / 10);
        line.classList.add('arrow-line');
        line.classList.add(path[path.length - 1].phase === PHASE_PERIMETER ? 'perimeter-path' : 'aisle-path');

        // Arrow tip
        const tip = document.createElementNS(SVG_NS, 'path');
        tip.setAttribute('d', `M0 -4 L8 0 L0 4 Z`); // initial tip
        tip.classList.add('arrow-tip');
        tip.classList.add(path[path.length - 1].phase === PHASE_PERIMETER ? 'perimeter-path' : 'aisle-path');
        tip.setAttribute('transform', `translate(25,0)`);

        directionArrow.appendChild(line);
        directionArrow.appendChild(tip);

        svg.appendChild(directionArrow);

        // initial positioning
        updateDirectionArrow();
    }

    function updateDirectionArrow() {
        const last = path[path.length - 1];
        if (!directionArrow || !path.length) return;

        const angleDeg = currentHeading * (180 / Math.PI);

        // update transform (position & rotation)
        directionArrow.setAttribute(
            'transform',
            `translate(${last.x * VISUAL_SCALE}, ${last.y * VISUAL_SCALE}) rotate(${angleDeg - 90})`
        );

        // --- scale visuals ---
        const line = directionArrow.querySelector('.arrow-line');
        const tip = directionArrow.querySelector('.arrow-tip');

        // Line length can be proportional to VISUAL_SCALE
        const lineLength = 20 * VISUAL_SCALE / 10; 
        line.setAttribute('x2', lineLength);
        line.setAttribute('stroke-width', Math.max(1, VISUAL_SCALE / 5));
        line.classList.remove('perimeter-path', 'aisle-path');
        line.classList.add(path[path.length - 1].phase === PHASE_PERIMETER ? 'perimeter-path' : 'aisle-path');


        // Tip size & position scaled
        const tipWidth = 8 * VISUAL_SCALE / 10;
        const tipHeight = 4 * VISUAL_SCALE / 10;
        tip.setAttribute('d', `M0 ${-tipHeight} L${tipWidth} 0 L0 ${tipHeight} Z`);
        tip.setAttribute('transform', `translate(${lineLength},0)`);
        tip.classList.remove('perimeter-path', 'aisle-path');
        tip.classList.add(path[path.length - 1].phase === PHASE_PERIMETER ? 'perimeter-path' : 'aisle-path');

    }


    // Open the modal when clicking the save button
    const phaseButton = document.getElementById('phaseButton');
    phaseButton.addEventListener('click', () => {
        if (currentPhase === PHASE_PERIMETER) {
            currentPhase = PHASE_AISLES;
            updatePrimaryButton();
            showPhaseModal(currentPhase); 
            updateDirectionArrow()
            path.push({ x: 0, y: 0, steps: 0, phase: PHASE_AISLES }) // return to entrance for aisle mapping
            drawPath()
            return;
        }

        if (currentPhase === PHASE_AISLES) {
            currentPhase = PHASE_FINAL;
            // NOW open the final form modal
            const modal = new bootstrap.Modal(document.getElementById('walkingPathModal'));
            modal.show();
            return;
        }
    });

    function showPhaseModal(phase) {
        let title = "";
        let description = "";

        if (phase === PHASE_PERIMETER) {
            title = "Map the perimeter";
            description = "The first step in the mapping process is to walk a path around the inside perimeter of the store, to map the overall shape of the building. Start at the entrance of the shelving area (not the external door) and follow the wall shelving all the way around until you are back near the entrance. Tap NEXT when you are finished.";
            pathClass = 'perimeter-path';
        }

        if (phase === PHASE_AISLES) {
            title = "Map the aisles";
            description = "Nice work! The next step is to walk all the aisles, island shelving and stand alone-freezers in a zig-zag pattern. The map pointer has been moved back to the entrance as your new start position. Disregard any 'specials' shelving which change products often - we dont need to know where those are.";
            pathClass = 'aisle-path';
        }

        if (phase === PHASE_FINAL) {
            return // we show the final submission form instead of this modal
        }

        document.getElementById("phaseTitle").textContent = title;
        document.getElementById("phaseDescription").textContent = description;

        const modal = new bootstrap.Modal(document.getElementById("phaseModal"));
        modal.show();
    }

    // Handle modal form submission
    document.getElementById('walkingPathForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        const payload = {
            supermarketType: document.querySelector('#walking_path_supermarketType').value,
            suburb: document.querySelector('#walking_path_suburb').value,
            rawData: JSON.parse(localStorage.getItem('storeMapping') || '{}'),
        };

        try {
            const response = await fetch('/walkingpath/save', { // ✅ new POST route
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errorData = await response.json().catch(() => null);
                const message = errorData?.error || 'Submission failed';
                throw new Error(message);
            }

            // Only clear localStorage on success
            localStorage.removeItem('storeMapping');

            alert('Path data submitted successfully!');
            window.location.href = '/';

        } catch (err) {

            console.error('Submission error message:', err.message);
            alert('Submission failed — your progress is still saved offline.');
        }
    });



    
    function updatePrimaryButton() {
        const btn = document.getElementById("phaseButton");

        if (currentPhase === PHASE_PERIMETER) {
            btn.textContent = "NEXT";
        }

        if (currentPhase === PHASE_AISLES) {
            btn.textContent = "FINISH";
        }
    }

    function updateDisplay() {
        stepDisplay.textContent = stepsBuffer || '0';
    }

    function enableSave() {
        hasChanges = true;
        if (saveBtn) saveBtn.disabled = false;
    }

    function rotateMap(){
        clearTimeout(rotateTimer);

        rotateTimer = setTimeout(() => {
            const last = path[path.length - 1];
            const headingDeg = currentHeading * 180 / Math.PI;

            // rotate map so arrow points up
            let targetRotation = -headingDeg;

            // compute shortest rotation
            let delta = targetRotation - mapRotation;
            delta = ((delta + 180) % 360) - 180;
            mapRotation += delta;

            // Apply rotation to the map        
            svg.style.transform = `rotate(${mapRotation}deg)`;
            svg.style.transformOrigin = "center center";

            updateViewBox(); // always fit full path

        }, 500)
    }


    function getRotatedPathBounds(rotationDeg) {

        const rad = rotationDeg * Math.PI / 180;
        const cos = Math.cos(rad);
        const sin = Math.sin(rad);

        let minX = Infinity;
        let maxX = -Infinity;
        let minY = Infinity;
        let maxY = -Infinity;

        for (const p of path) {

            const x = p.x * VISUAL_SCALE;
            const y = p.y * VISUAL_SCALE;

            const rx = x * cos - y * sin;
            const ry = x * sin + y * cos;

            minX = Math.min(minX, rx);
            maxX = Math.max(maxX, rx);
            minY = Math.min(minY, ry);
            maxY = Math.max(maxY, ry);
        }

        return {
            minX,
            maxX,
            minY,
            maxY,
            width: maxX - minX,
            height: maxY - minY
        };
    }


    function drawPath() {
        pathLayer.innerHTML = '';

        for (let i = 1; i < path.length; i++) {
            const p1 = path[i - 1];
            const p2 = path[i];

            // 🔥 Apply visual scale HERE (not in stored data)
            const x1 = p1.x * VISUAL_SCALE;
            const y1 = p1.y * VISUAL_SCALE;
            const x2 = p2.x * VISUAL_SCALE;
            const y2 = p2.y * VISUAL_SCALE;

            const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute('x1', x1);
            line.setAttribute('y1', y1);
            line.setAttribute('x2', x2);
            line.setAttribute('y2', y2);
            line.setAttribute('stroke-width', Math.max(1, VISUAL_SCALE / 10));
            line.setAttribute('class', path[i].phase === PHASE_PERIMETER ? 'perimeter-path' : 'aisle-path');

            const dashLength = Math.max(1, VISUAL_SCALE / 5);
            const gapLength = Math.max(1, VISUAL_SCALE / 5);
            line.setAttribute('stroke-dasharray', `${dashLength} ${gapLength}`);

            pathLayer.appendChild(line);

            const dot = document.createElementNS("http://www.w3.org/2000/svg", "circle");
            dot.setAttribute('cx', x2);
            dot.setAttribute('cy', y2);
            dot.setAttribute('r', Math.max(2, VISUAL_SCALE / 6));
            dot.setAttribute('fill', '#fa5252');
            pathLayer.appendChild(dot);

            const text = document.createElementNS("http://www.w3.org/2000/svg", "text");
            text.setAttribute('x', (x1 + x2) / 2);
            text.setAttribute('y', (y1 + y2) / 2 - VISUAL_SCALE / 5);
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('font-size', Math.max(8, VISUAL_SCALE / 2));
            text.setAttribute('class', path[i].phase === PHASE_PERIMETER ? 'perimeter-path' : 'aisle-path');
            text.textContent = p2.steps;

            pathLayer.appendChild(text);
        }

        updateViewBox();
    }

    function updateViewBox() {
        if (!path.length) return;

        const basePadding = 40;
        const arrowLength = (20 * VISUAL_SCALE / 10) + (8 * VISUAL_SCALE / 10);
        const padding = basePadding + arrowLength;

        let minX = path[0].x * VISUAL_SCALE;
        let maxX = path[0].x * VISUAL_SCALE;
        let minY = path[0].y * VISUAL_SCALE;
        let maxY = path[0].y * VISUAL_SCALE;

        for (let p of path) {
            const scaledX = p.x * VISUAL_SCALE;
            const scaledY = p.y * VISUAL_SCALE;

            minX = Math.min(minX, scaledX);
            maxX = Math.max(maxX, scaledX);
            minY = Math.min(minY, scaledY);
            maxY = Math.max(maxY, scaledY);
        }

        const width = maxX - minX + padding * 2;
        const height = maxY - minY + padding * 2;

        svg.setAttribute(
            'viewBox',
            `${minX - padding} ${minY - padding} ${width} ${height}`
        );
    }

    /* -----------------------------
        Actions
    ----------------------------- */

    function turn(dir) {
        if (dir === 'left') currentHeading -= Math.PI / 2;
        if (dir === 'right') currentHeading += Math.PI / 2;

        currentHeading = (currentHeading + Math.PI * 2) % (Math.PI * 2);

        updateDirectionArrow(); // rotate instantly

        rotateMap()
    }

    function addLeg() {
        const steps = parseInt(stepsBuffer);
        if (!steps || steps <= 0) return;

        const last = path[path.length - 1];
        const logicalDistance = steps; // raw units

        // --- compute new leg coordinates ---
        const newX = last.x + logicalDistance * Math.sin(currentHeading);
        const newY = last.y - logicalDistance * Math.cos(currentHeading);

        // --- build a temporary path including the new leg ---
        const tempPath = [...path, { x: newX, y: newY, steps }];

        // --- compute bounds and VISUAL_SCALE using updated path ---
        const allX = tempPath.map(p => p.x);
        const allY = tempPath.map(p => p.y);
        const minX = Math.min(...allX);
        const maxX = Math.max(...allX);
        const minY = Math.min(...allY);
        const maxY = Math.max(...allY);

        const width = maxX - minX;
        const height = maxY - minY;

        const baseSize = 20;          
        const referenceSize = 200;    
        VISUAL_SCALE = Math.max(4, baseSize * Math.sqrt(width * height) / referenceSize);

        // --- push new leg ---
        path.push({ 
            x: newX, 
            y: newY, 
            steps: steps,
            phase: currentPhase,
        });
        headings.push(currentHeading);

        console.log(path)

        // --- reset step buffer and update visuals ---
        stepsBuffer = '';
        updateDirectionArrow();
        updateDisplay();
        drawPath();
        enableSave();
        saveToLocalStorage()
    }

    function undoLeg() {
        if (path.length > 1) {
            path.pop();           // remove last point
            headings.pop();       // remove last heading

            // --- recompute bounds ---
            const allX = path.map(p => p.x);
            const allY = path.map(p => p.y);
            const minX = Math.min(...allX);
            const maxX = Math.max(...allX);
            const minY = Math.min(...allY);
            const maxY = Math.max(...allY);

            const width = maxX - minX;
            const height = maxY - minY;

            // --- recompute VISUAL_SCALE dynamically ---
            const baseSize = 20;       // starting base size
            const referenceSize = 200; // designed reference width/height
            VISUAL_SCALE = Math.max(4, baseSize * Math.sqrt(width * height) / referenceSize);

            // --- update visuals ---
            updateDirectionArrow();
            drawPath();
            enableSave();
            saveToLocalStorage()
        }
    }



    function backspace() {
        stepsBuffer = stepsBuffer.slice(0, -1);
        updateDisplay();
    }

    function addDigit(digit) {
        stepsBuffer += digit;
        updateDisplay();
    }

    /* -----------------------------
        Event Delegation (Footer)
    ----------------------------- */

    footer.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;

        if (btn.dataset.direction) {
        turn(btn.dataset.direction);
        return;
        }

        if (btn.dataset.number !== undefined) {
        addDigit(btn.dataset.number);
        return;
        }

        if (btn.textContent.trim() === 'Enter') {
        addLeg();
        return;
        }

        if (btn.textContent.trim() === '⌫') {
        backspace();
        return;
        }
    });

    if (undoBtn) {
        undoBtn.addEventListener('click', undoLeg);
    }

    function clearMappingSession() {
        if (!confirm('Clear this mapping session? This cannot be undone.')) {
            return;
        }

        localStorage.removeItem('storeMapping');

        window.location.reload();
    }

    function getMappingState() {
        return {
            path: path,
            headings: headings,
            currentHeading: currentHeading,
            visualScale: VISUAL_SCALE,
            phase: currentPhase,
        };
    }

    function saveToLocalStorage() {
        try {
            localStorage.setItem('storeMapping', JSON.stringify(getMappingState()));
        } catch (e) {
            console.warn('Failed to save mapping to localStorage', e);
        }
    }

    function restoreFromLocalStorage() {
        const saved = localStorage.getItem('storeMapping');
        if (!saved) return;

        try {
            const state = JSON.parse(saved);

            // Set local state from saved data
            path = state.path || [];
            headings = state.headings || [];
            currentHeading = state.currentHeading || 0;
            VISUAL_SCALE = state.visualScale || 20;
            currentPhase = state.phase || PHASE_PERIMETER;

            drawPath();
            updateDirectionArrow();

        } catch (e) {
            console.warn('Failed to restore mapping', e);
        }
    }


    // --- FORM SUBMISSION ---

 
})();
</script>

{% endblock %}