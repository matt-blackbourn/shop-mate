<div class="modal fade map-modal" id="pathModal" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-sm-down modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div class="modal-title">
                    <div class="title">
                        <span id="modalItemName" class="title"></span>
                        <span id="modalItemQty" class="app-muted"></span>
                    </div>

                    <div id="modalItemNotes" class="notes app-muted"></div>
                </div>

                <button id="pick" class="pick-skip" type="button">Picked</button>
            </div>

            <div class="modal-body">
                <div class="map-container">
                    <svg id="path-map" class="map-svg" viewBox="{{ viewBox.minX }} {{ viewBox.minY }} {{ viewBox.width }} {{ viewBox.height }}">
                        <g id="path-edges-layer"></g>
                        <g id="path-entrance-layer"></g>
                    </svg>
                </div>
            </div>

            <div class="modal-footer">
                <button id="skip-item-map" class="btn btn-secondary" type="button">Skip Item</button>
                <button type="button" id="pathCancelBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>


