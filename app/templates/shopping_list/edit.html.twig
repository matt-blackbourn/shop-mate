{% extends 'base.html.twig' %}

{% block title %}Edit Shopping List{% endblock %}

{% block body %}

   
<div class="container py-3">

    {{ form_start(form) }}

    <!-- Sticky header: page-level actions -->
    <div class="sticky-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left: menu button -->
            <div class="header-left d-flex align-items-center">
                <button class="menu-button" aria-label="Open menu">☰</button>
                <div class="menu-overlay" hidden></div>

                <!-- Side menu -->
                <nav class="side-menu" hidden>
                    <button type="button" class="menu-close" aria-label="Close menu">×</button>
                    <ul>
                        <li><a href="{{ path('app_food_item_new') }}">Add food</a></li>
                        <li><a href="{{ path('admin_assign_food_edges', {id: 1}) }}">Map food</a></li>
                        <li><a href="{{ path('app_supermarket_index') }}">Supermarkets</a></li>
                        <li><a href="{{ path('app_supermarket_map') }}">Mapper</a></li>
                    </ul>
                </nav>
            </div>

            <!-- Center: heading -->
            <div class="header-center flex-grow-1 d-flex justify-content-center">
                <h6>My Shopping List</h6>
            </div>

            <!-- Right: Go shopping button -->
               <div class="header-right d-flex align-items-center">
                <a href="" id="go-shopping-btn" class="btn btn-sm d-flex align-items-center gap-1 header-btn">
                    <i class="bi bi-cart-fill"></i>
                    <span class="d-none d-sm-inline">Go Shopping</span>
                </a>
            </div>
        </div>
    </div>


    <div class="px-2 pt-2">
        <div class="d-flex gap-2 mb-3">
            <button
                type="button"
                id="add-item"
                class="flex-grow-1"
            >
                <i class="bi bi-plus"></i>
                Add item
            </button>

            <button
                type="button"
                id="save-list"
                disabled
                title="Save changes"
            >
                <i class="bi bi-check-lg"></i>
            </button>
            
            <button
                type="button"
                id="refresh-page"
                title="Reload page"
            >
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>


    <div
        id="listItems"
        class="d-flex flex-column gap-2"
        data-prototype="{{ form_widget(form.listItems.vars.prototype)|e('html_attr') }}"
    >
        {% for itemForm in form.listItems %}
        <div class="card list-item collapsed">
            <div class="card-body p-2">

                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between item-header">
                    <div class="fw-semibold food-label">
                        New item
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="remove-item">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>

                <!-- Collapsible body -->
                <div class="item-body mt-2">
                    {{ form_widget(itemForm.foodItem, { attr: { class: 'form-select form-select-sm food-select' } }) }}

                    <div class="d-flex align-items-center gap-2 mt-2">

                        <!-- Notes -->
                        <div class="flex-grow-1">
                            {{ form_widget(itemForm.notes, {
                                attr: {
                                    class: 'form-control form-control-sm',
                                    placeholder: 'Notes'
                                }
                            }) }}
                        </div>

                        <!-- Quantity controls -->
                        <div class="d-flex align-items-center gap-1 qty-control">
                            <button type="button" class="qty-down">−</button>

                            <span class="fw-semibold qty-display px-2">
                                {{ itemForm.quantity.vars.value ?? 1 }}
                            </span>

                            {{ form_widget(itemForm.quantity, {
                                attr: { class: 'd-none quantity-input', value: itemForm.quantity.vars.value ?? 1 }
                            }) }}

                            <button type="button" class="qty-up">+</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {% endfor %}
        {% do form.listItems.setRendered %}
    </div>

    {{ form_end(form) }}

    {% include 'food_item/_new_food_modal.html.twig' with { foodForm: foodForm } %}
    {% include 'supermarket/_select_supermarket_modal.html.twig' %}
</div>

<style>
.container {
    background-color: #0f1115; /* dark background */
    color: #e9ecef;            /* light text */
}

.sticky-header {
    background-color: #2b303b;
    color: #e9ecef;
    border-bottom: 1px solid #343a46;
    margin-bottom: 0.5rem;
}

.sticky-header h1 {
    color: #e9ecef;
}

.side-menu {
    background-color: #2b303b;
    color: #e9ecef;
    position: fixed;
    inset: 0 0 0 auto;
    width: 70%;
    max-width: 280px;
    box-shadow: -8px 0 20px rgba(0, 0, 0, 0.08);
    padding: 1.25rem;
    z-index: 10;
}

.menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(2px);
    z-index: 9;
}

.menu-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    margin-bottom: 1rem;
    cursor: pointer;
    color: #e9ecef;
}

.menu-button {
    background: none;
    border: none;
    font-size: 1.5rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    color: #e9ecef;
}

.side-menu a:hover {
    color: #4dabf7; /* primary accent hover */
}

.side-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.side-menu a {
    display: block;
    padding: 0.75rem 0;
    text-decoration: none;
    font-weight: 500;
    color: #e9ecef;
}

.menu-close:hover,
.menu-button:hover {
    color: #4dabf7;
}

/* Header buttons – base */
.header-btn {
    background-color: transparent;
    color: #e9ecef;
    border: 1px solid #3a4152;
    border-radius: 0.375rem;
}

/* Finished button */
.header-btn:hover {
    background-color: rgba(77, 171, 247, 0.15);
    border-color: #4dabf7;
}




#add-item {
    background-color: #4dabf7;
    border: 1px solid #4dabf7;
    color: #0b0d12;
    border-radius: 0.5rem; /* keep rounded corners */
    padding: 0.5rem 1rem;  /* matches original spacing */
}

#add-item:hover {
    background-color: #70b5f9;
}

#save-list {
    background-color: #f0ad4e;
    border: 1px solid #f0ad4e;
    color: #0b0d12;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}

#save-list:disabled {
    background-color: #2a2f3a;
    border-color: #2a2f3a;
    color: #6c757d;
}

#save-list:hover:not(:disabled) {
    background-color: #f1b55d;
}

#refresh-page {
    background-color: transparent;
    border: 1px solid #343a46;
    color: #e9ecef;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}

#refresh-page:hover {
    background-color: #343a46;
    color: #f1f3f5;
}



/* Card background and border */
.card.list-item {
    background-color: #1c212b; /* dark slate */
    border: 1px solid #3a4152;
    color: #e9ecef;
    border-radius: 0.5rem;
}

/* Card header text */
.card.list-item .item-header .food-label {
    color: #f1f3f5;
}

/* Remove button */
.card.list-item .remove-item {
    background-color: #2b303b;
    border: 1px solid #343a46;
    color: #f1f3f5;
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
}

.card.list-item .remove-item:hover {
    background-color: #343a46;
    color: #ffffff;
}

/* Quantity buttons */
.card.list-item .qty-down,
.card.list-item .qty-up {
    background-color: #2b303b;
    border: 1px solid #343a46;
    color: #f1f3f5;
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
}

.card.list-item .qty-down:hover,
.card.list-item .qty-up:hover {
    background-color: #343a46;
    color: #ffffff;
}

.card.list-item .form-control,
.card.list-item .form-select {
    background-color: #0f1115;
    color: #e9ecef;
    border: 1px solid #3a4152;
}

.card.list-item .form-control::placeholder,
.card.list-item .form-select option {
    color: #6c757d;
}

/* notes input */
.form-control-sm {
    font-size: initial;
    font-style: italic;
}


.list-item.collapsed .item-body {
    display: none;
}
.list-item.collapsed .toggle-item i {
    transform: rotate(-90deg);
}
.toggle-item i {
    transition: transform 0.15s ease;
}
.item-header {
    cursor: pointer;
}
.item-header .food-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.qty-control .btn {
    padding: 0.25rem 0.4rem;
}
/* Main Tom Select control (input wrapper) */
.card.list-item .ts-control {
    background-color: #0f1115; /* dark background */
    color: #e9ecef;            /* text color */
    border: 1px solid #3a4152; /* dark border */
}


/* Input inside Tom Select */
.card.list-item .ts-control input {
    background-color: transparent; /* inherit from control */
    color: #e9ecef;
}

/* Dropdown option when creating a new item */
.card.list-item .ts-create-food {
    background-color: #2b303b;
    color: #e9ecef;
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
}

.card.list-item .ts-create-food:hover {
    background-color: #343a46;
    color: #ffffff;
}

/* Optional: dropdown menu */
.card.list-item .ts-dropdown {
    background-color: #0f1115;
    color: #e9ecef;
    border: 1px solid #3a4152;
}

/* Dropdown options */
.card.list-item .ts-dropdown .ts-dropdown-option {
    color: #e9ecef;
}

.card.list-item .ts-dropdown .ts-dropdown-option:hover {
    background-color: #343a46;
}

.ts-dropdown .active, .ts-dropdown .active.create {
    background-color: #343a46;
    color: #e9ecef;
}


.ts-control {
    min-height: 38px;
    padding: 0.375rem 0.75rem;
    flex-wrap: nowrap;
}
.ts-control input {
    width: auto !important;
    min-width: 1ch;
    flex: 1 1 auto;
}
.ts-create-food {
    padding: 0.375rem 0.5rem;
    cursor: pointer;
    border-radius: 0.375rem;
}

.ts-create-food:hover {
    background: #f8f9fa;
}


</style>

<script>
const container = document.getElementById('listItems');
let index = {{ form.listItems|length }};
let isDirty = false;
let activeFoodSelect = null;

const form = document.querySelector('form');
const saveButton = document.getElementById('save-list');
const refreshButton = document.getElementById('refresh-page');

updateActionButtons();

const goShoppingBtn = document.getElementById('go-shopping-btn');
const selectModalEl = document.getElementById('selectSupermarketModal');
const selectModal = new bootstrap.Modal(selectModalEl);
const confirmBtn = document.getElementById('confirm-supermarket-btn');
const shoppingForm = document.querySelector('form[name="shopping_list"]');

goShoppingBtn.addEventListener('click', async (e) => {
    e.preventDefault();
    // 1️⃣ Submit the main form via AJAX or normal submit if you prefer
    // If using AJAX:
    const formData = new FormData(shoppingForm);
    try {
        await fetch(shoppingForm.action, {
            method: 'POST',
            body: formData,
        });

        // 2️⃣ Open the supermarket selection modal
        selectModal.show();
    } catch (err) {
        console.error('Failed to save list', err);
        alert('Could not save your list. Try again.');
    }
});

// 3️⃣ Handle confirmation
confirmBtn.addEventListener('click', () => {
    const selected = selectModalEl.querySelector('input[name="supermarketId"]:checked');
    if (!selected) {
        alert('Please select a supermarket.');
        return;
    }

    const supermarketId = selected.value;

    // redirect to the shopping page with supermarketId in URL
    window.location.href = `/active/${supermarketId}`;
});

document.getElementById('add-item').addEventListener('click', () => {
    // Get fully-named prototype
    const prototypeHtml = container.dataset.prototype.replace(/__name__/g, index);
    index++;

    // Collapse existing items
    container.querySelectorAll('.list-item').forEach(i => {
        i.classList.remove('expanded');
        i.classList.add('collapsed');
    });

    // Parse prototype
    const temp = document.createElement('div');
    temp.innerHTML = prototypeHtml;

    // Extract Symfony-managed fields
    const foodSelect = temp.querySelector('select');
    const notesInput = temp.querySelector('input[name$="[notes]"]');
    const quantityInput = temp.querySelector('input[name$="[quantity]"]');

    // Defensive checks (optional but wise)
    if (!foodSelect || !notesInput || !quantityInput) {
        console.error('Prototype missing expected fields');
        return;
    }

    // Styling hooks
    foodSelect.classList.add('food-select');
    notesInput.classList.add('form-control', 'form-control-sm');
    quantityInput.classList.add('quantity-input');
    quantityInput.type = 'hidden';

    // Create card wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'card list-item expanded';

    wrapper.innerHTML = `
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between item-header">
                <div class="fw-semibold food-label">New item</div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-item">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>

            <div class="item-body mt-2">
                ${foodSelect.outerHTML}

                <div class="d-flex align-items-center gap-2 mt-2">
                    <div class="flex-grow-1">
                        ${notesInput.outerHTML}
                    </div>
                    <div class="d-flex align-items-center gap-1 qty-control">
                        <button type="button" class="btn btn-sm btn-outline-secondary qty-down">−</button>
                        <span class="fw-semibold qty-display px-2">1</span>
                        ${quantityInput.outerHTML}
                        <button type="button" class="btn btn-sm btn-outline-secondary qty-up">+</button>
                    </div>
                </div>
            </div>
        </div>
    `;

    container.prepend(wrapper);

    // Let Tom Select initialise new selects
    document.dispatchEvent(new Event('collection:add'));
});


container.addEventListener('change', e => {
    const item = e.target.closest('.list-item');
    if (!item) return;

    // Update food label when select changes
    if (e.target.classList.contains('food-select')) {
        const select = e.target;
        const label = item.querySelector('.food-label');
        label.textContent = select.options[select.selectedIndex]?.text || 'New item';
    }
});

container.addEventListener('click', e => {
    const item = e.target.closest('.list-item');
    if (!item) return;

    // Toggle expand/collapse when header clicked (ignore buttons)
    if (e.target.closest('.item-header') && !e.target.closest('button')) {
        item.classList.toggle('expanded');
        item.classList.toggle('collapsed');
    }

    // Remove item
    if (e.target.closest('.remove-item')) {
        item.remove();
    }

    // Quantity controls
    if (e.target.closest('.qty-up') || e.target.closest('.qty-down')) {
        const input = item.querySelector('.quantity-input');
        const display = item.querySelector('.qty-display');

        let value = parseInt(input.value || 1, 10);
        if (e.target.closest('.qty-up')) value++;
        if (e.target.closest('.qty-down')) value = Math.max(1, value - 1);

        input.value = value;
        display.textContent = value;
    }
});

// On page load: update all labels after DOM ready
document.addEventListener('DOMContentLoaded', () => {
    container.querySelectorAll('.list-item').forEach(item => {
        const select = item.querySelector('.food-select');
        const label = item.querySelector('.food-label');
        if (select && label) {
            label.textContent = select.options[select.selectedIndex]?.text || 'New item';
        }
    });
});

{# TOM select #}
document.addEventListener('DOMContentLoaded', () => {
    function initFoodSelect(context = document) {
        context.querySelectorAll('select.food-select').forEach(select => {
            if (select.tomselect) return; // prevent double-init

            const ts = new TomSelect(select, {
                maxItems: 1,
                preload: true,
                placeholder: 'Search food…',
                allowEmptyOption: true,
                closeAfterSelect: true,
                create: true,
                persist: false, // required for <select>
                createFilter: function (input) {
                    const value = input.trim().toLowerCase();

                    return !Object.values(this.options).some(option => {
                        const name = (option.name ?? option.text ?? '').trim().toLowerCase();
                        return name === value;
                    });
                },

                onItemAdd(value, item) {
                    const row = this.input.closest('.list-item');
                    if (!row) return;

                    row.classList.remove('expanded');
                    row.classList.add('collapsed');
                },

                render: {
                    no_results(data, escape) {
                        activeFoodSelect = this;
                        const query = escape(data.input);

                        return `
                            <div class="ts-no-results">
                                <div class="ts-create-food text-primary" data-name="${query}" data-action="/food/ajax/new">
                                    ➕ Add <strong>"${query}"</strong>
                                </div>
                            </div>
                        `;
                    }
                }
            });

            ts.focus();
            ts.open();
        });
    }

    // Init existing items
    initFoodSelect();

    // Handle Symfony collection add
    document.addEventListener('collection:add', (e) => {
        initFoodSelect(e.target);
    });
});

// Capture clicks on the “Add new food” row
let activeListItemRow = null;
document.addEventListener('click', async (e) => {
    const createRow = e.target.closest('.ts-create-food');
    if (!createRow) return;

    const name = (createRow.dataset.name || '').trim();
    if (!name) return;

    activeListItemRow = createRow.closest('.list-item');

    // Optimistic UI update
    if (activeListItemRow) {
        // get name from modal form input
        const nameInput = e.target.querySelector('[name$="[name]"]');
        const foodName = nameInput?.value?.trim();
        const label = activeListItemRow.querySelector('.food-label');
        if (label) label.textContent = foodName ? foodName : 'Adding...';

        activeListItemRow.classList.remove('expanded');
        activeListItemRow.classList.add('collapsed');
    }

    try {
        const response = await fetch(createRow.dataset.action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({ name })
        });

        if (!response.ok) {
            throw await response.json();
        }

        const data = await response.json();

        if (!activeFoodSelect) return;

        activeFoodSelect.addOption({
            value: data.id,
            text: data.label
        });

        activeFoodSelect.setValue(data.id);
        activeFoodSelect.close();

        activeFoodSelect = null;

    } catch (err) {
        console.error('Food creation failed:', err);

        // Optional rollback
        if (activeListItemRow) {
            const label = activeListItemRow.querySelector('.food-label');
            if (label) label.textContent = `Failed to add ${label}`;
        }
    }
});


const menuButton = document.querySelector('.menu-button');
const menu = document.querySelector('.side-menu');
const overlay = document.querySelector('.menu-overlay');
const closeButton = document.querySelector('.menu-close');

function openMenu() {
    menu.hidden = false;
    overlay.hidden = false;
}

function closeMenu() {
    menu.hidden = true;
    overlay.hidden = true;
}

// Prevent default click behavior to avoid form submission
menuButton.addEventListener('click', (e) => {
    e.preventDefault();
    openMenu();
});

closeButton.addEventListener('click', closeMenu);
overlay.addEventListener('click', closeMenu);

// Optional: close menu with Escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeMenu();
    }
});


// Any change marks the form dirty
form.addEventListener('input', () => {
    if (isDirty) return;

    isDirty = true;
    saveButton.disabled = false;
    saveButton.classList.remove('btn-outline-secondary');
    saveButton.classList.add('btn-outline-secondary');
    updateActionButtons();
});


function updateActionButtons() {
    if (isDirty) {
        saveButton.classList.remove('d-none');
        refreshButton.classList.add('d-none');
    } else {
        saveButton.classList.add('d-none');
        refreshButton.classList.remove('d-none');
    }
}


// Save handler
saveButton.addEventListener('click', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    const formData = new FormData(form);

    try {
        const response = await fetch(form.action, {
            method: form.method || 'POST',
            body: formData,
        });

        if (!response.ok) {
            throw new Error('Save failed');
        }

        // Saved state
        isDirty = false;
        saveButton.disabled = true;
        saveButton.classList.remove('btn-outline-primary');
        saveButton.classList.add('btn-outline-secondary');
        saveButton.innerHTML = '<i class="bi bi-check-lg"></i>';

        updateActionButtons();

        // Reset icon after a moment
        setTimeout(() => {
            saveButton.innerHTML = '<i class="bi bi-check-lg"></i>';
        }, 1500);

    } catch (err) {
        console.error(err);
        alert('Could not save changes. Please try again.');
    }
});

refreshButton.addEventListener('click', () => {
    window.location.reload();
});

</script>

{% endblock %}
