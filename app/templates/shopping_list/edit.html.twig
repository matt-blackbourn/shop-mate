{% extends 'base.html.twig' %}

{% block title %}Edit Shopping List{% endblock %}

{% block body %}

<div class="list-page d-flex flex-column">

    {{ form_start(form) }}

    <!-- HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left -->
            <div class="header-left d-flex align-items-center">
                <button class="menu-button" aria-label="Open menu">☰</button>
                
            </div>

            <!-- Center -->
            <div class="header-center flex-grow-1 d-flex justify-content-center">
                <select id="supermarketSelect">
                    {% for supermarket in supermarkets %}
                        <option value="{{ supermarket.id }}">{{ supermarket.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <!-- Right -->
            <div class="header-right d-flex align-items-center">
                <a href="" id="go-shopping-btn" class="btn-dark-base border-green">
                    <i class="bi bi-cart-fill"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close" aria-label="Close menu">×</button>
        <ul>
            <li>
                <button type="button"
                    id="quickAddItems"
                    data-quick-add-items="{{ quickAddItems|json_encode|e('html_attr') }}">
                    Quick-add Items
                </button>
            </li>
            <li class="desktop-only">
                <a href="{{ path('app_food_item_new') }}">Add food</a>
            </li>
            <li class="desktop-only">
                <a href="{{ path('admin_assign_food_edges', {id: 1}) }}">Map food</a>
            </li>
            <li class="desktop-only">
                <a href="{{ path('app_supermarket_index') }}">Supermarkets</a>
            </li>
            <li>
                <a href="{{ path('app_supermarket_map') }}">Store Mapper</a>
            </li>
        </ul>
    </nav>

    <!-- BODY -->
    <div class="page-body flex-grow-1 overflow-auto px-2 pt-2">

        <div
            id="listItems"
            class="d-flex flex-column gap-2"
            data-prototype="{{ form_widget(form.listItems.vars.prototype)|e('html_attr') }}"
        >
            {% for itemForm in form.listItems %}
                <div class="card list-item collapsed">
                    <div class="card-body p-2">

                        <!-- Header -->
                        <div class="d-flex align-items-center justify-content-between item-header">
                            <div class="fw-semibold food-label">
                                <span class="label-name">New item</span><span class="label-qty"></span><span class="label-notes"></span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="remove-item">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Collapsible body -->
                        <div class="item-body mt-2">
                            {{ form_widget(itemForm.foodItem, { attr: { class: 'form-select form-select-sm food-select' } }) }}

                            <div class="d-flex align-items-center gap-2 mt-2">

                                <!-- Notes -->
                                <div class="flex-grow-1">
                                    {{ form_widget(itemForm.notes, {
                                        attr: {
                                            class: 'form-control form-control-sm notes-input',
                                            placeholder: 'Notes'
                                        }
                                    }) }}
                                </div>

                                <!-- Quantity controls -->
                                <div class="d-flex align-items-center gap-1 qty-control">
                                    <button type="button" class="qty-down">−</button>

                                    <span class="fw-semibold qty-display px-2">
                                        {{ itemForm.quantity.vars.value ?? 1 }}
                                    </span>

                                    {{ form_widget(itemForm.quantity, {
                                        attr: { class: 'd-none quantity-input', value: itemForm.quantity.vars.value ?? 1 }
                                    }) }}

                                    <button type="button" class="qty-up">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% do form.listItems.setRendered %}
        </div>

    </div>

    <!-- FOOTER -->
    <div class="page-footer">
        <div class="d-flex gap-2 p-2">

            <button type="button" id="add-item" class="flex-grow-1 btn-dark-base border-green">
                <i class="bi bi-plus"></i>
                Add item
            </button>

            <button type="button" id="save-list" disabled title="Save changes">
                <i class="bi bi-check-lg"></i>
            </button>

            <button type="button" id="refresh-page" title="Reload page">
                <i class="bi bi-arrow-clockwise"></i>
            </button>

        </div>
    </div>

    {{ form_end(form) }}

</div>


{# ========================================= #}



<style>

