{% extends 'base.html.twig' %}

{% block title %}Edit Floor Plan{% endblock %}

{% block body %}
<div class="d-flex flex-column mb-4 border-bottom pb-3">

    <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center gap-3">
            <h1 class="h4 mb-0">{{ walkingPath.type.value }} - {{ walkingPath.suburb }} by {{ walkingPath.user.email }}</h1>
            <a href="{{ path('app_walking_path_index') }}" class="btn btn-outline-secondary btn-sm">
                ← Back to list
            </a>
        </div>

        <div class="d-flex align-items-center gap-2">
           

            <div id="node-editor">
                <label>X: <input type="number" id="edit-x"></label>
                <label>Y: <input type="number" id="edit-y"></label>
            </div>

             <span id="node-count" class="badge bg-secondary">0 nodes</span>

            <button id="delete-node" type="button" class="btn btn-outline-secondary btn-sm">
                Delete node
            </button>

            <form method="POST" action="{{ path('app_walking_path_to_supermarket_save', {'id': walkingPath.id}) }}"
                  id="nodesForm" class="d-flex align-items-center gap-2">
                <input type="hidden" name="nodes" id="nodesInput" data-walking-path-id="{{ walkingPath.id }}">
                <button id="save-nodes" type="submit" class="btn btn-primary btn-sm">
                    💾 Save as Supermarket
                </button>
            </form>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mt-2 mb-0" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<div id="walking-path-wrapper" data-raw-data="{{ walkingPath.rawData|json_encode|e('html_attr') }}">
    <svg id="overlay" style="border:1px solid #ccc; width:100%; height:100vh;"></svg>
</div>

<style>
    .node { 
        fill: #51cf66; 
        stroke: #51cf66; 
        stroke-width: 2; 
        cursor: pointer; 
    }

    .node-selected {
        fill: #ff4444;
        stroke: #ff4444;
        stroke-width: 2;
        cursor: pointer; 
    }
    
    .guide-line,
    .guide-label,
    .perimeter-path,
    .aisle-path {
        pointer-events: none;
    }
    
</style>

<script>
const svg = document.getElementById('overlay');
const nodeCountEl = document.getElementById('node-count');
const saveBtn = document.getElementById('save-nodes');
const editor = document.getElementById('node-editor');
const inputX = document.getElementById('edit-x');
const inputY = document.getElementById('edit-y');

const RENDER_SCALE = 30; // adjust until it feels right
const EDITING_EDGE_BUFFER = 60; // space around nodes for numbers on the guides
const SHOP_EDGE_BUFFER = 30; // distance from outermost nodes to the shop border

const wrapper = document.getElementById('walking-path-wrapper');
const rawData = JSON.parse(wrapper.dataset.rawData || '{}');
const nodesData = rawData.path || []; // ✅ only take the path array out of the raw data
const visualScale = rawData.visualScale || 1;
let SNAP_DISTANCE = 1 * visualScale; // default = 1 steps
const SVG_NS = 'http://www.w3.org/2000/svg';
const nodes = [];

// Shared coordinates for snapping
const sharedX = new Set();
const sharedY = new Set();

let lastNode = null;
let selectedNode = null;
let shopBorder = null; // store the rect element globally
let pathLine = null;

// --- Create guide layer ---
const guideLayer = document.createElementNS(SVG_NS, 'g');
guideLayer.setAttribute('id', 'guide-layer');
svg.appendChild(guideLayer);

const pathLayer = document.createElementNS(SVG_NS, 'g');
pathLayer.setAttribute('id', 'path-layer');
svg.appendChild(pathLayer);

inputX.addEventListener('input', updateSelectedNode);
inputY.addEventListener('input', updateSelectedNode);

// Draw existing nodes and populate array
const scaledPath = nodesData.map(n => ({
    x: n.x * visualScale,
    y: n.y * visualScale,
    phase: n.phase
}));

let normalizedPath;

if (scaledPath.length) {
    // Compute raw bounds
    const xs = scaledPath.map(n => n.x);
    const ys = scaledPath.map(n => n.y);

    const minX = Math.min(...xs);
    const minY = Math.min(...ys);
    const maxX = Math.max(...xs);
    const maxY = Math.max(...ys);

    const width = maxX - minX;
    const height = maxY - minY;

    // Normalize to include editing buffer
    normalizedPath = scaledPath.map(n => ({
        x: n.x - minX + EDITING_EDGE_BUFFER,
        y: n.y - minY + EDITING_EDGE_BUFFER,
        phase: n.phase
    }));

    // Set SVG viewBox
    svg.setAttribute(
        'viewBox',
        `0 0 ${width + EDITING_EDGE_BUFFER * 2} ${height + EDITING_EDGE_BUFFER * 2}`
    );


    // draw nodes
    normalizedPath.forEach(n => {
        const circle = drawNode(n.x, n.y);
        nodes.push({ x: n.x, y: n.y, element: circle });
        drawGuidesForNode(n.x, n.y);
        sharedX.add(n.x);
        sharedY.add(n.y);
    });

    pathLine = drawPathLine(normalizedPath);

    // Compute shop rectangle based on normalized coordinates
    const normXs = normalizedPath.map(n => n.x);
    const normYs = normalizedPath.map(n => n.y);
    const minNodeX = Math.min(...normXs);
    const maxNodeX = Math.max(...normXs);
    const minNodeY = Math.min(...normYs);
    const maxNodeY = Math.max(...normYs);

    updateShopBorder()
}

updateNodeCount();

function drawShopBorder(x, y, width, height) {
    if (!shopBorder) {
        shopBorder = document.createElementNS(SVG_NS, 'rect');
        shopBorder.setAttribute('fill', 'none');
        shopBorder.setAttribute('stroke', 'blue');
        shopBorder.setAttribute('stroke-width', 2);
        svg.appendChild(shopBorder);
    }

    shopBorder.setAttribute('x', x);
    shopBorder.setAttribute('y', y);
    shopBorder.setAttribute('width', width);
    shopBorder.setAttribute('height', height);

    return shopBorder;
}

// --- call this whenever nodes change ---
function updateShopBorder() {
    if (!nodes.length) return;

    // Compute bounds of nodes
    const xs = nodes.map(n => n.x);
    const ys = nodes.map(n => n.y);

    const minNodeX = Math.min(...xs);
    const maxNodeX = Math.max(...xs);
    const minNodeY = Math.min(...ys);
    const maxNodeY = Math.max(...ys);

    // --- Shop border (for saving the supermarket later) ---
    const rectX = minNodeX - SHOP_EDGE_BUFFER;
    const rectY = minNodeY - SHOP_EDGE_BUFFER;
    const rectWidth = (maxNodeX - minNodeX) + SHOP_EDGE_BUFFER * 2;
    const rectHeight = (maxNodeY - minNodeY) + SHOP_EDGE_BUFFER * 2;

    drawShopBorder(rectX, rectY, rectWidth, rectHeight);

    // --- Update SVG viewBox to fit everything including guides ---
    const vbMinX = minNodeX - EDITING_EDGE_BUFFER;
    const vbMinY = minNodeY - EDITING_EDGE_BUFFER;
    const vbWidth = (maxNodeX - minNodeX) + EDITING_EDGE_BUFFER * 2;
    const vbHeight = (maxNodeY - minNodeY) + EDITING_EDGE_BUFFER * 2;

    svg.setAttribute('viewBox', `${vbMinX} ${vbMinY} ${vbWidth} ${vbHeight}`)

    rebuildAllGuides()
}

function drawGuidesForNode(x, y) {
    const viewBox = svg.viewBox.baseVal;

    // --- Vertical line ---
    const vLine = document.createElementNS(SVG_NS,'line');
    vLine.setAttribute('x1', x);
    vLine.setAttribute('x2', x);
    vLine.setAttribute('y1', viewBox.y);
    vLine.setAttribute('y2', viewBox.y + viewBox.height);

    // --- Horizontal line ---
    const hLine = document.createElementNS(SVG_NS,'line');
    hLine.setAttribute('y1', y);
    hLine.setAttribute('y2', y);
    hLine.setAttribute('x1', viewBox.x);
    hLine.setAttribute('x2', viewBox.x + viewBox.width);

    [vLine, hLine].forEach(line => {
        line.setAttribute('stroke', '#51cf66');
        line.setAttribute('stroke-width', '0.5');
        line.setAttribute('opacity', '0.25');
        line.setAttribute('pointer-events', 'none');
        guideLayer.appendChild(line);
    });

    const labelY = viewBox.y + 25; // move down from top edge
    const xLabel = document.createElementNS(SVG_NS,'text');

    xLabel.setAttribute('x', x - 2); // slight offset from line
    xLabel.setAttribute('y', labelY);

    xLabel.textContent = Math.round(x);

    // rotate around the label anchor
    xLabel.setAttribute( 'transform', `rotate(-90 ${x - 2} ${labelY})`);

    // --- Y label (left of horizontal line) ---
    const yLabel = document.createElementNS(SVG_NS,'text');
    yLabel.setAttribute('x', viewBox.x + 2);
    yLabel.setAttribute('y', y - 2);
    yLabel.textContent = Math.round(y);

    [xLabel, yLabel].forEach(label => {
        label.setAttribute('fill', '#51cf66');
        label.setAttribute('font-size', '8');
        label.setAttribute('opacity', '0.6');
        label.setAttribute('pointer-events', 'none');
        label.setAttribute('font-family', 'monospace');
        guideLayer.appendChild(label);
    });
}


function rebuildAllGuides() {
    guideLayer.innerHTML = '';
    nodes.forEach(n => drawGuidesForNode(n.x, n.y));
}


function drawPathLine(normalisedPath) {

    for (let i = 1; i < normalisedPath.length; i++) {

        const a = normalisedPath[i - 1];
        const b = normalisedPath[i];

        const line = document.createElementNS(SVG_NS, 'line');

        line.setAttribute('x1', a.x);
        line.setAttribute('y1', a.y);
        line.setAttribute('x2', b.x);
        line.setAttribute('y2', b.y);
        line.setAttribute('stroke-dasharray', '8 3');
        line.setAttribute('stroke-width', '1');
        line.setAttribute('pointer-events', 'none');

        // apply phase class
        if (b.phase === 1) {
            line.classList.add('perimeter-path');
        } else {
            line.classList.add('aisle-path');
        }

        pathLayer.appendChild(line);
    }
}


// --- Node creation ---
function drawNode(x, y) {
    const circle = document.createElementNS(SVG_NS, 'circle');

    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', 2); // stable visual size

    circle.classList.add('node');
    svg.appendChild(circle);

    circle.addEventListener('click', e => {
        e.stopPropagation(); // prevents SVG click handler
        selectedNode = nodes.find(n => n.element === circle);
        showInNodeEditor(selectedNode);
        selectNode(circle);
    });

    return circle;
}

function selectNode(circle) {
    // remove previous highlight
    nodes.forEach(n => n.element.classList.remove('node-selected'));

    const node = nodes.find(n => n.element === circle);
    if (!node) return;

    selectedNode = node;
    circle.classList.add('node-selected');

    // populate coordinate inputs
    document.getElementById('edit-x').value = Math.round(node.x);
    document.getElementById('edit-y').value = Math.round(node.y);
}


function showInNodeEditor(node) {
    inputX.value = Math.round(node.x);
    inputY.value = Math.round(node.y);
}

function updateSelectedNode() {
    if (!selectedNode) return;

    const newX = parseFloat(inputX.value);
    const newY = parseFloat(inputY.value);

    // Remove old shared coords
    sharedX.delete(selectedNode.x);
    sharedY.delete(selectedNode.y);

    // Update data
    selectedNode.x = newX;
    selectedNode.y = newY;

    // Update SVG
    selectedNode.element.setAttribute('cx', newX);
    selectedNode.element.setAttribute('cy', newY);

    // Re-add shared coords
    sharedX.add(newX);
    sharedY.add(newY);

    rebuildAllGuides();
    updateShopBorder(); 
}

function createNode(x, y) {
    const circle = drawNode(x, y);
    nodes.push({ x, y, element: circle });
    drawGuidesForNode(x, y);
    updateNodeCount();
    updateShopBorder(); 
}


// --- Direction locking & snapping ---
svg.addEventListener('click', e => {

    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;

    const svgPoint = pt.matrixTransform(svg.getScreenCTM().inverse());

    let x = svgPoint.x;
    let y = svgPoint.y;

    ({ x, y } = snapToSharedCoordinates(x, y));

    createNode(x, y);

    lastNode = nodes[nodes.length - 1];
});



// --- Undo ---
document.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        undoNode();
        updateShopBorder(); 
    }
});

function undoNode(){
    if (!nodes.length) return;
    const last = nodes.pop();
    last.element.remove();
    rebuildAllGuides();
    updateNodeCount();
    updateShopBorder(); 
}

// DELETE NODE
function deleteSelectedNode() {
    if (!selectedNode) return;

    sharedX.delete(selectedNode.x);
    sharedY.delete(selectedNode.y);

    selectedNode.element.remove();

    const index = nodes.indexOf(selectedNode);
    if (index !== -1) nodes.splice(index, 1);

    selectedNode = null;

    inputX.value = '';
    inputY.value = '';

    rebuildAllGuides();
    updateNodeCount();
    updateShopBorder(); 
}
document.getElementById('delete-node').addEventListener('click', deleteSelectedNode);
document.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'x') {
        e.preventDefault();
        deleteSelectedNode();
    }
});

function snapToSharedCoordinates(x, y) {
    let sx = x;
    let sy = y;

    const xs = [...sharedX];
    const ys = [...sharedY];

    let closestX = null;
    let minDx = SNAP_DISTANCE;

    for (const px of xs) {
        const dx = Math.abs(x - px);
        if (dx < minDx) {
            minDx = dx;
            closestX = px;
        }
    }

    if (closestX !== null) sx = closestX;

    let closestY = null;
    let minDy = SNAP_DISTANCE;

    for (const py of ys) {
        const dy = Math.abs(y - py);
        if (dy < minDy) {
            minDy = dy;
            closestY = py;
        }
    }

    if (closestY !== null) sy = closestY;

    return { x: sx, y: sy };
}


// --- Node count update ---
function updateNodeCount() {
    nodeCountEl.textContent = `${nodes.length} nodes`;
    saveBtn.disabled = nodes.length === 0;
}


// --- Form submission ---
const form = document.getElementById('nodesForm');
const nodesInput = document.getElementById('nodesInput');

form.addEventListener('submit', e => {
    if (!nodes.length) {
        alert('Please add at least one node before saving.');
        return;
    }

    // Compute raw bounds from nodes (remove visual buffer)
    const xs = nodes.map(n => n.x - EDITING_EDGE_BUFFER);
    const ys = nodes.map(n => n.y - EDITING_EDGE_BUFFER);

    const minX = Math.min(...xs);
    const minY = Math.min(...ys);
    const maxX = Math.max(...xs);
    const maxY = Math.max(...ys);

    const shopWidth = Math.round(maxX - minX + SHOP_EDGE_BUFFER * 2);
    const shopHeight = Math.round(maxY - minY + SHOP_EDGE_BUFFER * 2);

    // Transform nodes
    const scaledNodes = nodes.map(n => ({
        x: Math.round((n.x - EDITING_EDGE_BUFFER) - minX + SHOP_EDGE_BUFFER),
        y: Math.round((n.y - EDITING_EDGE_BUFFER) - minY + SHOP_EDGE_BUFFER),
    }));

    // 🔵 Transform the original walked path
    const scaledPath = normalizedPath.map(p => ({
        x: Math.round((p.x - EDITING_EDGE_BUFFER) - minX + SHOP_EDGE_BUFFER),
        y: Math.round((p.y - EDITING_EDGE_BUFFER) - minY + SHOP_EDGE_BUFFER),
    }));

    nodesInput.value = JSON.stringify({
        nodes: scaledNodes,
        walkingPath: scaledPath,
        width: shopWidth,
        height: shopHeight
    });
});

</script>

{% endblock %}