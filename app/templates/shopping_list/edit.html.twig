<script>
const container = document.getElementById('listItems');
let index = {{ form.listItems|length }};
let isDirty = false;
let activeFoodSelect = null;

const form = document.querySelector('form');
const saveButton = document.getElementById('save-list');
const refreshButton = document.getElementById('refresh-page');

updateActionButtons();

const shoppingForm = document.querySelector('form[name="shopping_list"]');

const goShoppingBtn = document.getElementById('goShoppingButton');
goShoppingBtn.addEventListener('click', async (e) => {
    e.preventDefault();
    const formData = new FormData(shoppingForm);
    try {
        const response = await fetch(shoppingForm.action, {
            method: 'POST',
            body: formData,
        });

        if (!response.ok) {
            const text = await response.text(); // get Symfony error page
            console.error('Server error:', response.status, text);
            alert('Server error: ' + response.status);
            return;
        }

         // 1️⃣ Get the selected supermarket
        const supermarketId = supermarketSelect.value;
        if (!supermarketId) {
            alert('Please select a supermarket first.');
            return;
        }

        const listId = goShoppingBtn.dataset.shoppingListId

        // 2️⃣ Redirect to the active page
        window.location.href = `/shoppinglist/active/${listId}/${supermarketId}/true`;

    } catch (err) {
        console.error('Failed to save list', err);
        alert('Could not save your list. Try again.');
    }
});

// Modals
document.getElementById('defaultSupermarket').addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation(); 
    const modal = new bootstrap.Modal(document.getElementById('defaultSupermarketModal'));
    modal.show();
});
document.getElementById('switchList').addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation(); 
    const modal = new bootstrap.Modal(document.getElementById('switchListModal'));
    modal.show();
});
document.getElementById('defaultList').addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation(); 
    const modal = new bootstrap.Modal(document.getElementById('defaultListModal'));
    modal.show();
});
document.getElementById('trolleyButton').addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation(); 
    const modal = new bootstrap.Modal(document.getElementById('selectSupermarketModal'));
    modal.show();
});

// Send invite modal
const inviteModalEl = document.getElementById('inviteUserModal');
const inviteInput = document.getElementById('inviteEmail');
inviteModalEl.addEventListener('shown.bs.modal', function () {
    inviteInput.focus();
});
document.getElementById('sendInvite').addEventListener('click', function (e) {
    e.preventDefault();
    e.stopPropagation();

    const modal = new bootstrap.Modal(inviteModalEl);
    modal.show();
});

// Invite response modal (auto open if token exists)
const responseModalEl = document.getElementById('inviteResponseModal');
if (responseModalEl) {
    const token = responseModalEl.dataset.token;
    if (token) {
        // Set hidden input value
        const tokenInput = document.getElementById('inviteToken');
        if (tokenInput) {
            tokenInput.value = token;
        }

        // Show modal after page load
        const modal = new bootstrap.Modal(responseModalEl);
        modal.show();
    }
}

document.getElementById('add-item').addEventListener('click', () => {
    addItemToCollection();
});

const quickAddItemsBtn = document.getElementById('quickAddItems');
document.getElementById('quickAddItems').addEventListener('click', () => {
    const items = JSON.parse(quickAddItemsBtn.dataset.quickAddItems || '[]');
    if (!items.length) {
        alert('No quick-add items available.');
        return;
    }

    items.forEach((item, i)=> {
        const card = addItemToCollection({
            foodId: item.foodId,
            foodLabel: item.label,
            notes: item.notes,
            quantity: item.quantity
        });

        if (card) {
            card.classList.add('just-added');
        }

        if (i === items.length - 1) {
            setTimeout(() => {
                const lastCard = container.querySelector('.list-item');

                if (!lastCard) return;

                // Collapse card
                lastCard.classList.remove('expanded');
                lastCard.classList.add('collapsed');

                // Close Tom Select
                const select = lastCard.querySelector('select');
                if (select?.tomselect) {
                    select.tomselect.close();
                    select.tomselect.blur();
                }
            }, 0);
        }
    });

    markDirty();
    document.querySelector('.menu-close')?.click();
});


function addItemToCollection({
    foodId = null,
    foodLabel = 'New item',
    notes = '',
    quantity = 1
} = {}) {

    const prototypeHtml = container.dataset.prototype.replace(/__name__/g, index);
    index++;

    // Collapse existing
    container.querySelectorAll('.list-item').forEach(i => {
        i.classList.remove('expanded');
        i.classList.add('collapsed');
    });

    const temp = document.createElement('div');
    temp.innerHTML = prototypeHtml;

    const foodSelect = temp.querySelector('select');
    const notesInput = temp.querySelector('input[name$="[notes]"]');
    const quantityInput = temp.querySelector('input[name$="[quantity]"]');

    if (!foodSelect || !notesInput || !quantityInput) {
        console.error('Prototype missing expected fields');
        return null; 
    }

    // Inject values BEFORE inserting into DOM
    if (foodId !== null) {
        foodSelect.value = foodId;
    }

    notesInput.value = notes;
    quantityInput.value = quantity;

    foodSelect.classList.add('food-select');
    notesInput.classList.add('form-control', 'form-control-sm');
    quantityInput.classList.add('quantity-input');
    quantityInput.type = 'hidden';

    const wrapper = document.createElement('div');
    wrapper.className = 'card list-item expanded';

    wrapper.innerHTML = `
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between item-header">
                <div class="fw-semibold food-label">
                    <span class="label-name">${foodLabel}</span><span class="label-qty"></span><span class="label-notes"></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn-dark-base btn-compact remove-item">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>

            <div class="item-body mt-2">
                <div class="select-container"></div>

                <div class="d-flex align-items-center gap-2 mt-2">
                    <div class="flex-grow-1 notes-container">
                    </div>
                    <div class="d-flex align-items-center gap-1 qty-control">
                        <button type="button" class="qty-down btn-dark-base btn-compact">−</button>
                        <span class="fw-semibold qty-display px-2">${quantity}</span>
                        <div class="qty-container"></div>
                        <button type="button" class="qty-up btn-dark-base btn-compact">+</button>
                    </div>
                </div>
            </div>
        </div>
    `;

    wrapper.querySelector('.select-container').appendChild(foodSelect);
    wrapper.querySelector('.notes-container').appendChild(notesInput);
    wrapper.querySelector('.qty-container').appendChild(quantityInput);
    container.prepend(wrapper);

    document.dispatchEvent(new Event('collection:add'));

    return wrapper;
}


container.addEventListener('change', e => {
    const item = e.target.closest('.list-item');
    if (!item) return;

    // Update food label when select changes
    if (e.target.classList.contains('food-select')) {
        const select = e.target;
        const label = item.querySelector('.label-name');
        label.textContent = select.options[select.selectedIndex]?.text || 'New item';
        updateItemLabel(item);
    }
});

container.addEventListener('click', e => {
    const item = e.target.closest('.list-item');
    if (!item) return;

    // Toggle expand/collapse when header clicked (ignore buttons)
    if (e.target.closest('.item-header') && !e.target.closest('button')) {
        item.classList.toggle('expanded');
        item.classList.toggle('collapsed');

        if (item.classList.contains('collapsed')) {
            console.log(item.querySelector('.notes-input'));
            updateItemLabel(item); 
        }
    }

    // Remove item
    if (e.target.closest('.remove-item')) {
        item.remove();
    }

    // Quantity controls
    if (e.target.closest('.qty-up') || e.target.closest('.qty-down')) {
        const input = item.querySelector('.quantity-input');
        const display = item.querySelector('.qty-display');

        let value = parseInt(input.value || 1, 10);
        if (e.target.closest('.qty-up')) value++;
        if (e.target.closest('.qty-down')) value = Math.max(1, value - 1);

        input.value = value;
        display.textContent = value;
    }
});

// On page load: update all labels after DOM ready
document.addEventListener('DOMContentLoaded', () => {
    container.querySelectorAll('.list-item').forEach(item => {
        const select = item.querySelector('.food-select');
        const nameSpan = item.querySelector('.label-name');

        if (select && nameSpan) {
            nameSpan.textContent = select.options[select.selectedIndex]?.text || 'New item';
        }

        updateItemLabel(item);
    });
});

function updateItemLabel(item) {
    const qtyInput = item.querySelector('.quantity-input');
    const notesInput = item.querySelector('.notes-input');

    const qtySpan = item.querySelector('.label-qty');
    const notesSpan = item.querySelector('.label-notes');

    const qty = parseInt(qtyInput?.value || 1, 10);
    const notes = notesInput?.value?.trim();

    // Show quantity only if > 1
    qtySpan.textContent = qty > 1 ? ` (${qty})` : '';

    // Show notes if present
    notesSpan.textContent = notes ? ` — ${notes}` : '';
}

{# TOM selects #}
document.addEventListener('DOMContentLoaded', () => {
    function initFoodSelect(context = document) {
        context.querySelectorAll('select.food-select').forEach(select => {
            if (select.tomselect) return; // prevent double-init

            const ts = new TomSelect(select, {
                maxItems: 1,
                preload: true,
                placeholder: 'Search food…',
                allowEmptyOption: true,
                closeAfterSelect: true,
                create: true,
                persist: false, // required for <select>
                createFilter: function (input) {
                    const value = input.trim().toLowerCase();

                    return !Object.values(this.options).some(option => {
                        const name = (option.name ?? option.text ?? '').trim().toLowerCase();
                        return name === value;
                    });
                },


                create: function(input, callback) {
                    const name = input.trim();

                    fetch('/food/ajax/new', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ name })
                    })
                    .then(res => res.json())
                    .then(data => {
                        callback({
                            value: data.id,
                            text: data.label // this is returned from the server
                        });
                    })
                    .catch(err => {
                        console.error('Food creation failed:', err);
                        callback();
                    });
                },

                onItemAdd(value) {
                    const row = this.input.closest('.list-item');
                    if (!row) return;

                    // Add notes-input class to the existing input
                    const notesInput = row.querySelector('.notes-container input');
                    if (notesInput) notesInput.classList.add('notes-input');

                    // Get the selected option properly from Tom Select
                    const option = this.options[value];
                    const labelText = option?.text ?? '';

                    const nameSpan = row.querySelector('.label-name');
                    if (nameSpan) nameSpan.textContent = labelText;

                    row.classList.remove('expanded');
                    row.classList.add('collapsed');
                }
            });

            ts.focus();
            ts.open();
        });
    }

    // select supermarket Tom select
    new TomSelect('#supermarketSelect', {
        create: false,
        allowEmptyOption: true,
    });

    // select list Tom select
    new TomSelect('#listSelect', {
        create: false,
        allowEmptyOption: false,
        render: {
            option: function(data, escape) {
                const isSelected = data.$option.selected;

                return `
                    <div class="d-flex justify-content-between align-items-center">
                        <span>${escape(data.text)}</span>
                        ${isSelected ? '<span>✔</span>' : ''}
                    </div>
                `;
            },
            item: function(data, escape) {
                return `<div>${escape(data.text)}</div>`;
            }
        }
    });

    // default supermarket TOM select
    new TomSelect('#defaultSelect', {
        create: false,
        sortField: [{ field: '$order' }],
        searchField: ['text'],
        score: function(search) {
            const score = this.getScoreFunction(search);

            return function(item) {
                if (!search) return 1; // no search → keep original order
                return score(item);   // searching → relevance scoring kicks in
            };
        },
        render: {
            option: function(data, escape) {
                const isSelected = data.$option.selected;

                return `
                    <div class="d-flex justify-content-between align-items-center">
                        <span>${escape(data.text)}</span>
                        ${isSelected ? '<span>✔</span>' : ''}
                    </div>
                `;
            },
            item: function(data, escape) {
                return `<div>${escape(data.text)}</div>`;
            }
        }
    });

    // Handle Symfony collection add
    initFoodSelect();
    document.addEventListener('collection:add', (e) => {
        initFoodSelect(e.target);
    });
});

// Any change marks the form dirty
form.addEventListener('input', markDirty);

document.addEventListener('click', (e) => {
    const btn = e.target.closest('.remove-item');
    if (!btn) return;

    markDirty()
});

function markDirty() {
    if (isDirty) return;

    isDirty = true;
    saveButton.disabled = false;
    saveButton.classList.remove('btn-outline-secondary');
    saveButton.classList.add('btn-outline-warning');
    updateActionButtons();
}

function updateActionButtons() {
    if (isDirty) {
        saveButton.classList.remove('d-none');
        refreshButton.classList.add('d-none');
    } else {
        saveButton.classList.add('d-none');
        refreshButton.classList.remove('d-none');
    }
}


// Save handler
saveButton.addEventListener('click', async (e) => {
    e.preventDefault();
    e.stopPropagation();

    const formData = new FormData(form);

    try {
        const response = await fetch(form.action, {
            method: form.method || 'POST',
            body: formData,
        });

        if (!response.ok) {
            throw new Error('Save failed');
        }

        // Saved state
        isDirty = false;
        saveButton.disabled = true;
        saveButton.classList.remove('btn-outline-primary');
        saveButton.classList.add('btn-outline-secondary');
        saveButton.innerHTML = '<i class="bi bi-check-lg"></i>';

        updateActionButtons();

        // Reset icon after a moment
        setTimeout(() => {
            saveButton.innerHTML = '<i class="bi bi-check-lg"></i>';
        }, 1500);

    } catch (err) {
        console.error(err);
        alert('Could not save changes. Please try again.');
    }
});

refreshButton.addEventListener('click', () => {
    window.location.reload();
});

</script>

{% endblock %}
