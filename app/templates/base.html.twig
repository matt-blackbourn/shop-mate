<!DOCTYPE html>
<html>
	<head>
		    <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

            <title>{% block title %}Shopmate{% endblock %}</title>

            <!-- iOS PWA / Home Screen -->
            <link rel="apple-touch-icon" href="/images/shopmate-dark-v2.png">
            <meta name="mobile-web-app-capable" content="yes">
            <meta name="apple-mobile-web-app-status-bar-style" content="default">
            <meta name="apple-mobile-web-app-title" content="Shopmate">
            <!-- prevent doubletap zoom -->
            <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"> 

            <!-- Browser favicon (desktop) -->
            <link rel="icon" type="image/png" href="/shopmate-dark-v2.png">

            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.bootstrap5.min.css">

            <script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js" defer></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


		{% block javascripts %}{% endblock %}
            
	</head>
	<body>
        <script>
            function uuid() { 
                if (crypto.randomUUID) {
                    return crypto.randomUUID(); // ✅ correct
                }

                return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {
                    const r = crypto.getRandomValues(new Uint8Array(1))[0] % 16;
                    const v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
            }

            function drawGuidesForNode(x, y, fontSize = 8) {
                const viewBox = svg.viewBox.baseVal;

                // --- Vertical line ---
                const vLine = document.createElementNS(SVG_NS,'line');
                vLine.setAttribute('x1', x);
                vLine.setAttribute('x2', x);
                vLine.setAttribute('y1', viewBox.y);
                vLine.setAttribute('y2', viewBox.y + viewBox.height);

                // --- Horizontal line ---
                const hLine = document.createElementNS(SVG_NS,'line');
                hLine.setAttribute('y1', y);
                hLine.setAttribute('y2', y);
                hLine.setAttribute('x1', viewBox.x);
                hLine.setAttribute('x2', viewBox.x + viewBox.width);

                [vLine, hLine].forEach(line => {
                    line.setAttribute('stroke', '#51cf66');
                    line.setAttribute('stroke-width', '0.5');
                    line.setAttribute('opacity', '0.25');
                    line.setAttribute('pointer-events', 'none');
                    guideLayer.appendChild(line);
                });

                const labelY = viewBox.y + 40; // move down from top edge
                const xLabel = document.createElementNS(SVG_NS,'text');

                xLabel.setAttribute('x', x - 2); // slight offset from line
                xLabel.setAttribute('y', labelY);

                xLabel.textContent = Math.round(x);
                const colours = [
                    "#ff3b3b", // red
                    "#ffcc00", // yellow
                    "#00e676", // neon green
                    "#00b0ff", // bright blue
                    "#ff00ff"  // magenta
                ];

                // rotate around the label anchor
                xLabel.setAttribute( 'transform', `rotate(-90 ${x - 2} ${labelY})`);

                // --- Y label (left of horizontal line) ---
                const yLabel = document.createElementNS(SVG_NS,'text');
                yLabel.setAttribute('x', viewBox.x + 2);
                yLabel.setAttribute('y', y - 2);
                yLabel.textContent = Math.round(y);

                [xLabel, yLabel].forEach(label => {
                    label.setAttribute('fill', colours[Math.round(x) % 5]);
                    label.setAttribute('font-size', fontSize);
                    label.setAttribute('pointer-events', 'none');
                    label.setAttribute('font-family', 'monospace');
                    guideLayer.appendChild(label);
                });
            }
        </script>

		<div class="app"> {% block body %}{% endblock %}</div>

        <script>
           /* SIDE MENU */
            const menu = document.querySelector('.side-menu');
            const menuButton = document.querySelector('#menu-button');
            const overlay = document.querySelector('.menu-overlay');
            const closeButton = document.querySelector('.menu-close');

            if(menuButton) {

                // Prevent default click behavior to avoid form submission
                menuButton.addEventListener('click', (e) => {
                    e.preventDefault();
                    openMenu();
                });

                closeButton.addEventListener('click', closeMenu);
                overlay.addEventListener('click', closeMenu);

                // Optional: close menu with Escape key
                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        closeMenu();
                    }
                });

                function openMenu() {
                    menu.hidden = false;
                    overlay.hidden = false;
                }

                function closeMenu() {
                    menu.hidden = true;
                    overlay.hidden = true;
                }
            }
        </script>
    </body>
</html>
