{% extends 'base.html.twig' %}

{% block title %}Supermarket{% endblock %}

{% block body %}
<div class="d-flex flex-column mb-4 border-bottom pb-3">

    <div class="page-header">
        <div class="d-flex align-items-center px-2 py-2 w-100">

            <!-- Left -->
            <div class="d-flex align-items-center gap-5">
                <button id="menu-button" class="btn-dark-base" aria-label="Open menu"><i class="bi bi-list-ul"></i></button>
                <!-- Center -->
                <h6>{{ supermarket.type.value }} - {{ supermarket.suburb }}</h6>
            </div>
           
            <div class="flex-grow-1 d-flex justify-content-center">
                <select id="phaseSelector">
                    <option value="1">Entrance Phase</option>
                    <option value="2">Post Entrance Phase</option>
                    <option value="3">Main Phase</option>
                    <option value="4">End Phase</option>
                </select>
            </div>

            <!-- Right -->
            <div class="d-flex align-items-center gap-2">
                <div id="map-selection-info" class="small text-nowrap"></div>
              
                <button id="toggle-mode" type="button" class="btn-dark-base border-red">
                    <i id="mode-icon" class="bi bi-share"></i>
                </button>

                <button id="set-entrance" class="btn-dark-base border-yellow">
                    <i class="bi bi-flag"></i>
                </button>

                <button id="split-aisle" class="btn-dark-base border-yellow">
                    <i class="bi bi-diagram-3"></i>
                </button>

                <button id="save-aisle" type="button" class="btn-dark-base border-green">
                    <i class="bi bi-layout-three-columns"></i>
                </button>

                <form method="POST" action="/supermarket/{{ supermarket.id }}/edges/save"
                    id="edgesForm" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="edges" id="edgesInput">
                    <input type="hidden" name="nodes" id="nodesInput">
                    <input type="hidden" id="entranceNodeInput" name="entranceNode" value="">
                    <button type="submit" class="btn-dark-base border-green"><i class="bi bi-check-lg"></i></button>
                </form>
            </div>
        </div>
    </div>

    
    <div class="menu-overlay" hidden></div>
    <nav class="side-menu" hidden>
        <button type="button" class="menu-close" aria-label="Close menu">×</button>
        <ul>
            <li>
                <button id="remove-aisles" type="button">Remove Aisles</button>
            </li>
            <li class="desktop-only">
                <a href="{{ path('app_supermarket_index') }}">Supermarkets</a>
            </li>
            <li class="desktop-only">
                <a href="{{ path('app_home') }}">Shopping List</a>
            </li>
        </ul>
    </nav>
</div>

<div 
    id="supermarket-wrapper" 
    data-supermarket-id="{{ supermarket.id }}"  
    data-nodes="{{ nodes|json_encode|e('html_attr') }}"
    data-edges="{{ edges|json_encode|e('html_attr') }}"
    data-walking-path='{{ supermarket.scaledPathData|json_encode }}'
    data-aisle-width='{{ supermarket.aisleWidth }}'
    {% if supermarket.entranceNode %}data-entrance-id='{{ supermarket.entranceNode.id }}'{% endif %}
>
    <svg
        id="overlay"
        viewBox="-30 -30 {{ supermarket.width + 30 }} {{ supermarket.height + 30 }}"
        preserveAspectRatio="xMidYMid meet"
    >
    </svg>
</div>

<style>
    #supermarket-wrapper {
        position: relative;
        width: 100vw;
        height: calc(100vh - 140px); /* leave room for header */
        overflow: hidden;
    }

    #overlay {
        width: 100%;
        height: 100%;
        display: block;
    }


    .edge {
        stroke-width: 4;
        cursor: pointer;
    }

    .edge:hover {
        stroke-width: 6;
    }


    .aisle {
        filter: drop-shadow(0 0 3px white);
    }

    .node.selected {
        stroke: red;
        stroke-width: 3;
    }

    .edge.selected {
        stroke: red;
        stroke-dasharray: 6 4; /* optional but very nice */
    }

    .node.edge-start {
        stroke: orange;
        stroke-width: 4;
    }
    .node {
        pointer-events: visibleStroke;
        fill: white;
        stroke: #333;
        stroke-width: 2;
        cursor: pointer;
    }

    .node:hover {
        stroke: #2196f3;
    }

    .node.entrance {
        fill: #fa5252;
        stroke: #fa5252;
        stroke-width: 4;
    }
    #map-selection-info {
        width: 200px;
        text-align: right;
    }

</style>
<script>

const wrapper = document.getElementById('supermarket-wrapper');
const svg = document.getElementById('overlay');
const phaseSelector = document.getElementById('phaseSelector');
const nodesData = JSON.parse(wrapper.dataset.nodes);
const edgeData = JSON.parse(wrapper.dataset.edges);
const supermarketId = JSON.parse(wrapper.dataset.supermarketId);
const walkingPath = JSON.parse(wrapper.dataset.walkingPath || '[]');
const SVG_NS = 'http://www.w3.org/2000/svg';
const infoBox = document.getElementById('map-selection-info');
const AISLE_WIDTH = wrapper.dataset.aisleWidth

let nodes = {};
let edges = [];
const nodeIdMap = {};
const nodesByUuid = {};

let edgeStartNode = null;
let entranceNode = null; // store the entrance node reference

const STROKE_WIDTH = 10; // default
const selectedNodes = new Set();
const selectedEdges = new Set();
const undoStack = [];

const guideLayer = document.createElementNS(SVG_NS, 'g');
guideLayer.setAttribute('id', 'guide-layer');
svg.appendChild(guideLayer);

const edgeLayer = document.createElementNS(SVG_NS, 'g');
edgeLayer.setAttribute('id', 'edge-layer');
svg.appendChild(edgeLayer);

const nodeLayer = document.createElementNS(SVG_NS, 'g');
nodeLayer.setAttribute('id', 'node-layer');
svg.appendChild(nodeLayer);

const pathLayer = document.createElementNS(SVG_NS, 'g');
pathLayer.setAttribute('id', 'path-layer');
svg.appendChild(pathLayer);

let mode = 'edge'; // 'edge' | 'node'

const toggleBtn = document.getElementById('toggle-mode');
const icon = document.getElementById('mode-icon');

toggleBtn.addEventListener('click', () => {
    clearInfo();
    if (mode === 'edge') {
        mode = 'node';
        icon.className = 'bi bi-record-circle';
    } else {
        mode = 'edge';
        icon.className = 'bi bi-share';
    }
});



nodesData.forEach(n => {
    const node = createNode(n.x, n.y);
    node.id = n.id;
    nodeIdMap[n.id] = node.uuid;
    nodesByUuid[node.uuid] = node;
});

// do this after building nodes
const entranceId = parseInt(wrapper.dataset.entranceId);
if (entranceId) {
    // find node by DB id
    const entranceNode = Object.values(nodes).find(n => n.id === entranceId);
    if (entranceNode) {
        entranceNode.element.classList.add('entrance');
        window.entranceNode = entranceNode; // global reference
    }
}

edgeData.forEach(e => {
    const edge = {
        id: e.id,
        from: nodeIdMap[e.from],
        to: nodeIdMap[e.to],
        phase: e.phase,
        aisleKey: e.aisleKey,
        selected: false
    };

    const line = drawEdge(edge);
    if (line) {
        edges.push(edge);
    }
});

drawPathLine(walkingPath);


svg.addEventListener('click', (e) => {
    if (mode !== 'node') return;

    // convert click to SVG coordinates
    const pt = svg.createSVGPoint();
    pt.x = e.clientX;
    pt.y = e.clientY;
    const svgPoint = pt.matrixTransform(svg.getScreenCTM().inverse());
    const x = svgPoint.x;
    const y = svgPoint.y;

    // 1️⃣ check if click is on an existing node
    const hitRadius = 20; // matches your hit circle size
    const clickedNode = Object.values(nodes).find(n => {
        const dx = n.x - x;
        const dy = n.y - y;
        return dx * dx + dy * dy <= hitRadius * hitRadius;
    });

    if (clickedNode) {
        // node exists — toggle selection
        handleNodeSelection(clickedNode, e);
        return;
    }

    // 2️⃣ empty space — create new node
    snapshotState();   // only snapshot if graph changes
    createNode(x, y);
});



document.getElementById('set-entrance').addEventListener('click', () => {
    if (selectedNodes.size !== 1) {
        alert('Please select exactly one node to set as entrance.');
        return;
    }

    entranceNode = Array.from(selectedNodes)[0];

    // update hidden input
    document.getElementById('entranceNodeInput').value = entranceNode.uuid;

    // optionally highlight it
    Object.values(nodes).forEach(n => n.element.classList.remove('entrance'));
    entranceNode.element.classList.add('entrance');

    alert('Entrance node set!');
});

function clearSelections() {
    selectedNodes.forEach(n => n.element.classList.remove('selected'));
    selectedEdges.forEach(e => e.element.classList.remove('selected'));

    selectedNodes.clear();
    selectedEdges.clear();
}


function createNode(x, y) {
    const nodeUuid = uuid();

    // 1️⃣ hit circle (invisible, large)
    const hit = document.createElementNS(SVG_NS, 'circle');
    hit.setAttribute('cx', x);
    hit.setAttribute('cy', y);
    hit.setAttribute('r', 20);       // larger clickable radius
    hit.setAttribute('fill', 'transparent');
    hit.style.cursor = 'pointer';
    nodeLayer.appendChild(hit);

    // 2️⃣ visible node circle
    const circle = document.createElementNS(SVG_NS, 'circle');
    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', 7);
    circle.classList.add('node');
    nodeLayer.appendChild(circle);

    const node = { id: null, uuid: nodeUuid, x, y, element: circle, hitElement: hit };
    nodes[nodeUuid] = node;

    // click on either circle or hit area
    const clickHandler = (e) => {
        e.stopPropagation();

        if (mode === 'edge') handleEdgeNodeClick(node);
        if (mode === 'node') handleNodeSelection(node, e);
    };

    drawGuidesForNode(x, y, 20);

    hit.addEventListener('click', clickHandler);
    circle.addEventListener('click', clickHandler);

    return node;
}

// optionally find node by either id or uuid
function getNode(key) {
    return nodes[key] || Object.values(nodes).find(n => n.uuid === key);
}



function updateEdgesForNode(node) {

    edges.forEach(edge => {

        if (edge.from !== node.uuid && edge.to !== node.uuid) return;

        const from = nodes[edge.from];
        const to = nodes[edge.to];

        edge.element.setAttribute('x1', from.x);
        edge.element.setAttribute('y1', from.y);
        edge.element.setAttribute('x2', to.x);
        edge.element.setAttribute('y2', to.y);

    });

}

function deleteSelectedNodes() {
    snapshotState();

    selectedNodes.forEach(node => {
        edges
            .filter(e => e.from === node.uuid || e.to === node.uuid)
            .forEach(e => {
                e.element.remove();
                edges.splice(edges.indexOf(e), 1);
            });

        node.element.remove();
        delete nodes[node.uuid];

    });

    selectedNodes.clear();
}

function redrawGraph() {
    nodeLayer.innerHTML = '';
    edgeLayer.innerHTML = '';
    guideLayer.innerHTML = '';

    const newNodes = {};
    Object.values(nodes).forEach(oldNode => {
        const rebuiltNode = createNode(oldNode.x, oldNode.y);
        rebuiltNode.uuid = oldNode.uuid;
        rebuiltNode.id = oldNode.id || null;
        newNodes[rebuiltNode.uuid] = rebuiltNode;
    });

    nodes = newNodes;
    edges.forEach(edge => drawEdge(edge));
}

function drawPathLine(walkingPath) {
    const polyline = document.createElementNS(SVG_NS, 'polyline');

    const pointString = walkingPath
        .map(p => `${p.x},${p.y}`)
        .join(' ');

    polyline.setAttribute('points', pointString);
    polyline.setAttribute('fill', 'none');
    polyline.setAttribute('stroke-width', '1');
    polyline.setAttribute('pointer-events', 'none');
    polyline.setAttribute('stroke-dasharray', '2 4');
    polyline.classList.add('path');
    pathLayer.appendChild(polyline);

    return polyline;
}

function handleEdgeNodeClick(node) {

    if (!edgeStartNode) {

        edgeStartNode = node;
        node.element.classList.add('edge-start');

        return;
    }

    if (edgeStartNode === node) {
        edgeStartNode.element.classList.remove('edge-start');
        edgeStartNode = null;
        return;
    }

    createEdge(edgeStartNode, node);

    edgeStartNode.element.classList.remove('edge-start');
    edgeStartNode = null;
}

function drawEdge(edge) {

    const from = nodes[edge.from];
    const to = nodes[edge.to];

    if (!from || !to) {
        console.warn("Edge references missing node", edge);
        return null;
    }

    const line = document.createElementNS(SVG_NS, 'line');

    line.setAttribute('x1', from.x);
    line.setAttribute('y1', from.y);
    line.setAttribute('x2', to.x);
    line.setAttribute('y2', to.y);

    line.classList.add('edge');

    const colorMap = {
        '1': '#4caf50',
        '2': '#2196f3',
        '3': '#ff9800',
        '4': '#9c27b0'
    };

    line.setAttribute('stroke', colorMap[edge.phase] || '#999');
    line.setAttribute('stroke-width', STROKE_WIDTH);

    if (edge.aisleKey) {
        line.classList.add('aisle');
    }

    line.addEventListener('click', (e) => {
        if (mode !== 'edge') return;

        e.stopPropagation();
        showEdgeInfo(edge);
        edge.selected = !edge.selected;
        line.classList.toggle('selected', edge.selected);

        // keep selectedEdges set in sync
        if (edge.selected) {
            selectedEdges.add(edge);
        } else {
            selectedEdges.delete(edge);
        }
    });

    edgeLayer.appendChild(line);

    edge.element = line;

    return line;
}

document.getElementById('split-aisle').addEventListener('click', insertAisleDivisionNodes);

function insertAisleDivisionNodes() {
    if (selectedNodes.size !== 2) {
        alert('Select exactly two nodes');
        return;
    }

    const [a, b] = [...selectedNodes];

    const dx = b.x - a.x;
    const dy = b.y - a.y;

    const distance = Math.sqrt(dx*dx + dy*dy);

    const unitX = dx / distance;
    const unitY = dy / distance;

    const halfWidth = AISLE_WIDTH / 2;

    const usable = distance - (2 * halfWidth);

    if (usable <= 0) {
        alert('Nodes too close together');
        return;
    }

    const section = usable / 3;

    snapshotState();

    const d1 = halfWidth + section;
    const d2 = halfWidth + (section * 2);

    const n1x = a.x + unitX * d1;
    const n1y = a.y + unitY * d1;

    const n2x = a.x + unitX * d2;
    const n2y = a.y + unitY * d2;

    createNode(n1x, n1y);
    createNode(n2x, n2y);

}

function snapshotState() {
    undoStack.push({
        nodes: JSON.stringify(Object.values(nodes).map(n => ({ x: n.x, y: n.y, uuid: n.uuid, id: n.id }))),
        edges: JSON.stringify(edges.map(e => ({
            id: e.id,
            from: e.from,
            to: e.to,
            phase: e.phase,
            aisleKey: e.aisleKey
        })))
    });
}

function undo() {
    const state = undoStack.pop();
    if (!state) return;

    nodes = JSON.parse(state.nodes);
    edges = JSON.parse(state.edges);

    redrawGraph();
}


function showNodeInfo(node) {
    infoBox.textContent = `ID: ${node.id} | x: ${Math.round(node.x)} | y: ${Math.round(node.y)}`;
}

function showEdgeInfo(edge) {
    const fromId = nodesByUuid[edge.from].id;
    const toId   = nodesByUuid[edge.to].id;
    infoBox.textContent = `ID: ${edge.id} | from: ${fromId} → to: ${toId}`;
}

function clearInfo() {
    infoBox.textContent = "";
}

function rebuildAllGuides() {
    guideLayer.innerHTML = '';

    Object.values(nodes).forEach(n => {
        drawGuidesForNode(n.x, n.y, 20);
    });
}


function createEdge(a, b) {
    if (edgeExists(a, b)) {
        alert('Edge exists already.');
        return;
    }

    const blockingNode = Object.values(nodes).find(n =>
        n.uuid !== a.uuid &&
        n.uuid !== b.uuid &&
        nodeOnSegment(a, b, n)
    );

    if (blockingNode) {
        alert('An intermediate node exists on this edge.');
        return;
    }

    snapshotState();
    const edge = {
        id: null,
        from: a.uuid,
        to: b.uuid,
        phase: phaseSelector.value,
        aisleKey: null,
        selected: false,
        element: null
    };

    edge.element = drawEdge(edge);
    edges.push(edge);
}

function handleNodeSelection(node, e) {
    showNodeInfo(node);

    if (!e.shiftKey) clearSelections();

    if (selectedNodes.has(node)) {
        selectedNodes.delete(node);
        node.element.classList.remove('selected');
    } else {
        selectedNodes.add(node);
        node.element.classList.add('selected');
    }
}

function edgeExists(a, b) {
    return edges.some(e =>
        (e.from === a.uuid && e.to === b.uuid) ||
        (e.from === b.uuid && e.to === a.uuid)
    );
}

function nodeOnSegment(a, b, n, tolerance = 1) {
    const cross =
        (b.x - a.x) * (n.y - a.y) -
        (b.y - a.y) * (n.x - a.x);

    if (Math.abs(cross) > tolerance) return false;

    const dot =
        (n.x - a.x) * (b.x - a.x) +
        (n.y - a.y) * (b.y - a.y);

    if (dot < 0) return false;

    const lenSq =
        (b.x - a.x) ** 2 +
        (b.y - a.y) ** 2;

    if (dot > lenSq) return false;

    return true;
}

phaseSelector.addEventListener('change', () => {
    const newPhase = phaseSelector.value;
    if (!newPhase) return;

    const colorMap = { 
        '1': '#4caf50',   // green
        '2': '#2196f3',   // blue
        '3': '#ff9800',   // orange
        '4': '#9c27b0'    // purple
    };

    edges.forEach(edge => {
        if (edge.selected) {
            edge.phase = newPhase;

            const line = svg.querySelector(`.edge[data-id="${edge.id}"]`);
            if (line) {
                line.dataset.phase = newPhase;
                line.setAttribute('stroke', colorMap[newPhase]);
            }

        }
    });

    // ✅ DESELECT ALL EDGES
    edges.forEach(edge => edge.selected = false);
        svg.querySelectorAll('.edge.selected').forEach(line => {
        line.classList.remove('selected');
    });
});

function buildEdgesPayload() {
    return edges.map(edge => {
        const from = nodes[edge.from];
        const to = nodes[edge.to];

        return {
            id: edge.id,
            uuid: edge.uuid,
            from: from?.id || from?.uuid,
            to: to?.id || to?.uuid,
            phase: edge.phase,
            aisleKey: edge.aisleKey
        };
    });
}

function buildNodesPayload() {
    return Object.values(nodes).map(n => ({
        id: n.id,
        uuid: n.uuid,
        x: n.x,
        y: n.y
    }));
}


// UNDO AND DELETE
document.addEventListener('keydown', (e) => {

    // 1️⃣ Undo with Ctrl+Z / Cmd+Z
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        undo();
        return;
    }

    // 2️⃣ Delete selected nodes/edges with Ctrl+X / Cmd+X
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'x') {
        e.preventDefault();
        snapshotState(); // save state before deletion

        // delete nodes
        selectedNodes.forEach(node => {
            // remove edges attached to this node
            edges
                .filter(edge => edge.from === node.uuid || edge.to === node.uuid)
                .forEach(edge => {
                    edge.element.remove();
                    edges.splice(edges.indexOf(edge), 1);
                });

            // remove node
            node.element.remove();
            if (node.hitElement) node.hitElement.remove();
            delete nodes[node.uuid];
        });
        selectedNodes.clear();
        rebuildAllGuides();

        // delete edges
        selectedEdges.forEach(edge => {
            edge.element.remove();
            edges.splice(edges.indexOf(edge), 1);
        });
        selectedEdges.clear();
    }

});

document.addEventListener('keydown', e => {
    if (mode !== 'node') return;
    if (!selectedNodes.size) return;

    let step = 1;
    if (e.shiftKey) step = 5;   // faster

    let dx = 0;
    let dy = 0;

    if (e.key === 'ArrowUp') dy = -step;
    if (e.key === 'ArrowDown') dy = step;
    if (e.key === 'ArrowLeft') dx = -step;
    if (e.key === 'ArrowRight') dx = step;

    if (!dx && !dy) return;

    snapshotState();

    selectedNodes.forEach(node => {
        node.x += dx;
        node.y += dy;

        node.element.setAttribute('cx', node.x);
        node.element.setAttribute('cy', node.y);

        updateEdgesForNode(node);
        showNodeInfo(node);

    });
    rebuildAllGuides();
});


document.getElementById('edgesForm').addEventListener('submit', (event) => {
    document.getElementById('edgesInput').value = JSON.stringify(buildEdgesPayload());
    document.getElementById('nodesInput').value = JSON.stringify(buildNodesPayload());
    document.getElementById('entranceNodeInput').value = entranceNode ? entranceNode.uuid : null;
});

const aisleSaveButton = document.getElementById('save-aisle');
aisleSaveButton.addEventListener('click', () => {
    
    let edgeSelected = false;

    edges.forEach(edge => {
        if (edge.selected) {
            edgeSelected = true;
            edge.aisleKey = true;
        }
    });

    if (!edgeSelected) {
        alert('Select at least one edge to save as an aisle');
        return;
    }

    document.getElementById('edgesInput').value = JSON.stringify(buildEdgesPayload());
    document.getElementById('nodesInput').value = JSON.stringify(buildNodesPayload());

    // Submit the form directly
    document.getElementById('edgesForm').requestSubmit();
});

const removeAislesButton = document.getElementById('remove-aisles');
removeAislesButton.addEventListener('click', () => {
    if (!confirm('Are you sure you want to remove all aisle keys in this supermarket?')) return;

    // Create a temporary form
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/supermarket/${supermarketId}/clear-aisles`; // backend route

    document.body.appendChild(form);
    form.requestSubmit(); // this triggers a full page request and follows backend redirect
});

// find edges with a node in the middle of them. (delete these if found)
{# SELECT 
    e.id AS edge_id,
    n.id AS node_on_edge
FROM edge e
JOIN node a ON a.id = e.start_id
JOIN node b ON b.id = e.end_id
JOIN node n 
    ON n.supermarket_id = e.supermarket_id
    AND n.id NOT IN (e.start_id, e.end_id)
WHERE e.supermarket_id = :supermarketId

AND ABS(
    (b.x_value - a.x_value) * (n.y_value - a.y_value) -
    (b.y_value - a.y_value) * (n.x_value - a.x_value)
) < 0.01

AND n.x_value BETWEEN LEAST(a.x_value, b.x_value) AND GREATEST(a.x_value, b.x_value)
AND n.y_value BETWEEN LEAST(a.y_value, b.y_value) AND GREATEST(a.y_value, b.y_value)

ORDER BY e.id; #}


// Find duplicate edges
{# SELECT *
FROM edge e
JOIN (
    SELECT 
        LEAST(start_id, end_id) AS node_a,
        GREATEST(start_id, end_id) AS node_b
    FROM edge
    WHERE supermarket_id = :supermarketId
    GROUP BY node_a, node_b
    HAVING COUNT(*) > 1
) d
ON LEAST(e.start_id, e.end_id) = d.node_a
AND GREATEST(e.start_id, e.end_id) = d.node_b
WHERE e.supermarket_id = :supermarketId
ORDER BY node_a, node_b, e.id; #}
   
</script>

{% endblock %}

