        switch (status) {
            case 'system':
                placeBtn.classList.add('border-green');
                break;
            case 'confirmed':
                placeBtn.classList.add('border-green');
                break;
            case 'provisional':
                placeBtn.classList.add('border-yellow');
                break;
            case 'group':
